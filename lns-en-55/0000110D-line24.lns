<EVENT VALUE="MOTION\r\n123\r\n000\r\n4\r\n-273\r\n0\r\nDEC\r\nPASS">
<EVENT VALUE="MOTION\r\n789\r\n人物1\r\n4\r\n-887\r\n0\r\nDEC\r\nPASS">
{MESON "500"}
<STYLE ID="2">Mom</STYLE> had finally fallen off the cliff. 
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\エデン\エリカ捕まえる.gal" "NORMAL" "#1" "R" "-887" "200" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
