{MESON "500"}
<STYLE ID="1">"Damn...! So it's no good after all...! </STYLE>
{PAUSE ""}
<STYLE ID="1">　</STYLE>Kogori-san<STYLE ID="1">, what are you doing!?</STYLE><STYLE ID="2">　</STYLE><STYLE ID="1">Hurry, get out through the window!"</STYLE><PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\五島家夜.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1,人物2" "1" "1000" "0" "0" "" "0"}
{MESON "500"}
<STYLE ID="2">An opponent who dodges bullets. I can't imagine I'd get away.</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\銃声.ogg" "VOICE" "NORMAL" "700" "0"}
{WAIT "500" "CLICK" "SKIP"}
{PLAYSND "SE\銃声.ogg" "VOICE" "NORMAL" "700" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "SE\銃声.ogg" "VOICE" "NORMAL" "700" "0"}
{MESON "500"}
<STYLE ID="3">Goto</STYLE><STYLE ID="2">'s house echoed with gunshots.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">Haruka</STYLE><STYLE ID="2"> and </STYLE><STYLE ID="3">Goto</STYLE><STYLE ID="2">, what's going to happen to them?</STYLE><PG>
{MESOFF "500"}
{STOPSND "BGM" "3000" "PASS"}
{PLAYSND "BGM死月編\夢見る憧憬.ogg" "BGM" "REPEAT" "1000" "0"}
{PLAYSND "環境音\アポカリプティック2.ogg" "SE2" "NORMAL" "0" "0"}
{CHGVOL "SE" "1000" "1000" "PASS"}
{CHGVOL "SE2" "600" "5000" "PASS"}
{CHANGECG "000" "グラフィック\背景\中央公園素材\中央公園内部夜.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "111" "グラフィック\背景\中央公園素材\御神木夜.gal" "NORMAL" "#1" "C" "B" "100" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="2">This place is... Central Park?</STYLE><PG>
{MESOFF "500"}
<EVENT VALUE="MOTION\r\n456\r\nムービー\r\n11\r\n100\r\n5000\r\nNORMAL\r\nPASS">
{PLAYMOVIE "桜吹雪風船なし.wmv" "256" "C" "C" "REPEAT" "FALSE" "300" "0"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\赤い人バストアップ.gal" "NORMAL" "#1" "R" "B" "200" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="5">"</STYLE>Natsumi<STYLE ID="5">... Trust... in... </STYLE><STYLE ID="4">Haruka-chan</STYLE><STYLE ID="5">..."</STYLE>
{PAUSE ""}
<BR>
"<STYLE ID="4">Haruka</STYLE>... trust her...?"
{PAUSE ""}
<BR>
<STYLE ID="5">"In everyone... everyone is... on your side."</STYLE>
{PAUSE ""}
<BR>
"<STYLE ID="6">Dad</STYLE>...!"<PG>
{MESOFF "500"}
{DELETECG "000,人物1,人物2,111" "1" "1000" "0" "0" "" "0"}
{PLAYMOVIE "赤い人消える.wmv" "256" "C" "C" "NORMAL" "TRUE" "0" "255"}
{WAITPLAY "ムービー" "CLICK"}
<EVENT VALUE="STOPMOVIE">
{CREATECG "000" "グラフィック\背景\中央公園素材\中央公園内部夜.gal" "NORMAL" "#1" "C" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\死神.gal" "NORMAL" "#1" "R" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
"You're the one who killed <STYLE ID="6">Dad</STYLE>, aren't you..."
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\伊勢全身.gal" "WAIT" "#1" "L" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="1">"That's far enough! The park is completely surrounded! There's nowhere to run!"</STYLE><PG>
{MESOFF "500"}
{DELETECG "000,人物1,人物2" "1" "1000" "0" "0" "" "0"}
<EVENT VALUE="STOPMOVIE">
