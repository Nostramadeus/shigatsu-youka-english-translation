{CHANGECG "000" "グラフィック\リファレンス用\背景\パチンコ店.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
"Oh, pachinko. 
{PAUSE ""}
<STYLE ID="1">Akane</STYLE>, were you into pachinko?"
{PAUSE ""}
<BR>
<STYLE ID="1">"Please, </STYLE>Mifuyu<STYLE ID="1">! Don't tell </STYLE><STYLE ID="3">Ryoji-kun</STYLE><STYLE ID="1"> about just now!"</STYLE>
{PAUSE ""}
<BR>
"Huh?"
{PAUSE ""}
<BR>
<STYLE ID="1">"Um... </STYLE>
{PAUSE ""}
<STYLE ID="1">It's hot, let's go to Primavera! My treat!"</STYLE><PG>
{MESOFF "500"}
