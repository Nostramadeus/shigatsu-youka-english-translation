{STOPSND "SE" "5000" "PASS"}
<STYLE ID="1"><TXSPS>"I...</STYLE>
{WAIT "500" "CLICK" "SKIP"}
<STYLE ID="1">lo...</STYLE>
{WAIT "500" "CLICK" "SKIP"}
<STYLE ID="1">ve...</STYLE>
{WAIT "500" "CLICK" "SKIP"}
