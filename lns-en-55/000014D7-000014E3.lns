{CHANGECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\茅萱.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物2" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="8">"Hah... hah..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="22" RUBY="ぬ">Soaked</STYLE> from head to foot, <STYLE ID="8">Chiga-nee</STYLE> came out of the hot spring.
{PAUSE ""}
<BR>
The mummy, bobbing on the water, was carried farther and farther off.
{PAUSE ""}
<BR>
<STYLE ID="8">Chiga-nee</STYLE> seemed to have jumped into the water, mummy and all.<PG>
<STYLE ID="8">"Mm... I won't... </STYLE>
{PAUSE ""}
<STYLE ID="8">I won't just keep taking it forever...!"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜バストアップ.gal" "NORMAL" "#1" "L" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="3">"</STYLE><STYLE ID="8">Sis</STYLE><STYLE ID="3">..."</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物2" "グラフィック\立ち絵\人物\五島怒りバストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="4">"</STYLE><STYLE ID="8">Chiga-nee</STYLE><STYLE ID="4">, don't tell me...!"</STYLE><PG>
{MESOFF "500"}
{STOPSND "SE" "5000" "PASS"}
{PLAYSND "太古の暗い鳴動.ogg" "BGM" "REPEAT" "1000" "0"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\茅萱バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="8">"Mm... You injected me with Droga?</STYLE>
{PAUSE ""}
<STYLE ID="8">　So what? I haven't become </STYLE><STYLE ID="6">Shigatsu Youka</STYLE><STYLE ID="8">'s servant!"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物2" "グラフィック\立ち絵\人物\エデン\栄一郎白装束.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="9">"I cured her green eyes with falsificaso and made her first generation with Droga... </STYLE>
{PAUSE ""}
<STYLE ID="9">Don't tell me... </STYLE>
{PAUSE ""}
<STYLE ID="12">that brother</STYLE><STYLE ID="9"> of mine...!"</STYLE><PG>
<STYLE ID="8">"Mm... You mean this?"</STYLE>
{PAUSE ""}
<BR>
{PLAYSND "SE\紙ペラ.ogg" "VOICE" "NORMAL" "1000" "0"}
