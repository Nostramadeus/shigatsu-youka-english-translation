{PLAYSND "SE\室内ドア開閉.ogg" "SE" "WAIT" "1000" "0"}
{PLAYSND "環境音\quiet-residential-area1.ogg" "BGM2" "REPEAT" "1000" "0"}
{WAIT "2000" "NORMAL" "SKIP"}
{CHANGECG "000" "グラフィック\シナリオ\自室背景.gal" "WAIT" "1" "2000" "0" "0" "" "0" "0" "0" "255" ""}
{CHGVOL "BGM2" "0" "0" "PASS"}
{PLAYSND "SE\small_window_C.ogg" "SE2" "WAIT" "1000" "0"}
{MESON "1000"}
<STYLE ID="1">It had gotten a little chilly, so I closed the window.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">The bustle outside vanished, and the room was wrapped in silence.</STYLE>
{PAUSE ""}
{MESOFF "500"}
<EVENT VALUE="TEXTCLEAR">
<PG>
{PLAYSND "SE\ビニール.ogg" "SE" "WAIT" "1000" "0"}
{MESON "1000"}
<STYLE ID="1">I put the takoyaki on the desk and crawled under the futon.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"</STYLE>Haruka<STYLE ID="2">... </STYLE>
{PAUSE ""}
<STYLE ID="2">thank you..."</STYLE>
{PAUSE ""}
<BR>
{PLAYSND "Lucky_You.ogg" "BGM" "REPEAT" "900" "0"}
<STYLE ID="1">Sure enough, my </STYLE>best friend<STYLE ID="1"> knows me well.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">She came by like this last year too, didn't she?</STYLE><PG>
<STYLE ID="1">But this is the first time she's brought a gift along.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">I'm always the one being looked after, </STYLE>
{PAUSE ""}
<STYLE ID="1">and I've hardly done anything to thank her.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">The day before yesterday </STYLE>Haruka<STYLE ID="1"> seemed to have an upset stomach, but </STYLE>
{PAUSE ""}
<STYLE ID="1">the next time </STYLE>Haruka<STYLE ID="1"> isn't feeling well, </STYLE>
{PAUSE ""}
<STYLE ID="1">I'll bring a gift along and go visit her.</STYLE><PG>
Haruka<STYLE ID="1"> calls this gloomy mood of mine April sickness.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">In this season when the cherry blossoms bloom, I sink into a funk.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">The reason, I don't know...</STYLE><PG>
