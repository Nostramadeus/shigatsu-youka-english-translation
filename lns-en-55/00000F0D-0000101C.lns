{CHANGECG "000" "グラフィック\背景\バース\ペペロンチーノ反転.gal" "NORMAL" "20" "500" "0" "0" "" "0" "0" "0" "255" ""}
{WAITPLAY "VOICE" "CLICK"}
{PLAYSND "環境音\鼓動1.ogg" "SE" "REPEAT" "1000" "0"}
{WAIT "2000" "CLICK" "SKIP"}
