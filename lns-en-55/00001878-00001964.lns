<SCENARIO VER="105">
{MESOFF "500"}
{CREATECG "チュートリアル" "グラフィック\メニュー\右クリック\ワード\チュートリアル出来事.gal" "NORMAL" "#1" "350" "70" "600" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
