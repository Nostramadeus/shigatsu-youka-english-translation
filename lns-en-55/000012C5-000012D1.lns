{MESON "500"}
<STYLE ID="4">"</STYLE><STYLE ID="3">Kogori-senpai</STYLE><STYLE ID="4">! There's a fire! Please get out of the house right now!"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
