{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\エデン\蔵火事.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1" "1" "500" "0" "0" "" "0"}
