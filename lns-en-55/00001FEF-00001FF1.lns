<SCENARIO VER="105">
{PLAYSND "環境音\quiet-residential-area1.ogg" "SE" "REPEAT" "1000" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\背景\警察署外観.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{PLAYSND "SE\自転車こぐ.ogg" "VOICE" "REPEAT" "0" "0"}
{CHGVOL "VOICE" "1000" "3000" "PASS"}
{WAIT "3000" "CLICK" "SKIP"}
{PLAYSND "SE\自転車ブレーキ.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "SE\自転車開始.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAITPLAY "VOICE" "CLICK"}
{PLAYSND "SE\アスファルトダッシュ.ogg" "VOICE" "REPEAT" "1000" "0"}
{WAIT "2000" "CLICK" "SKIP"}
{STOPSND "SE" "3000" "PASS"}
{PLAYSND "SE\自動ドア.ogg" "VOICE2" "NORMAL" "1000" "0"}
{CHANGECG "000" "グラフィック\背景\警察署受付.gal" "NORMAL" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{STOPSND "VOICE" "500" "PASS"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>"E-excuse me! Um, who's in charge of this morning's case!?"
{PAUSE ""}
<BR>
<STYLE ID="1">"Huh!? Huh!?"</STYLE>
{PAUSE ""}
<BR>
"My name is Erina Goto! I've figured out how to catch the culprit in this morning's case!"
{PAUSE ""}
<BR>
<STYLE ID="1">"</STYLE>You<STYLE ID="1">'re... in elementary school?"</STYLE><PG>
"I'm in high school! The truth is, I saw the moment the crime happened!"
{PAUSE ""}
<BR>
<STYLE ID="1">"What!?"</STYLE>
{PAUSE ""}
<BR>
"I was up until morning, so I slept until past noon and only just found out about the case!
{PAUSE ""}
　What I saw was the culprit and the victim, no doubt about it!"
{PAUSE ""}
<BR>
<STYLE ID="1">"But I'm in charge of the front desk, so..."</STYLE>
{PAUSE ""}
<BR>
"Which is why I'm telling you to bring out whoever's in charge!"<PG>
<STYLE ID="1">"O-okay... Please wait a moment."</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\reciever1.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAIT "2000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="1">"</STYLE><STYLE ID="2">Assistant Inspector Ise</STYLE><STYLE ID="1">, good work out there. Are you at the scene right now?</STYLE>
{PAUSE ""}
<STYLE ID="1">　Actually, a witness to the case has turned up. Her name is </STYLE>Erina Goto-san<STYLE ID="1">. </STYLE>
{PAUSE ""}
<STYLE ID="1">She's here at the station right now, and―</STYLE>
{PAUSE ""}
<STYLE ID="1">Huh?</STYLE>
{PAUSE ""}
<STYLE ID="1">　The line went dead..."</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\著作権フリー 商用利用可能 な 【効果音】パトカー　サイレン　警察　パトロール　ピーポー　２.ogg" "SE" "REPEAT" "0" "0"}
{CHGVOL "SE" "1000" "5000" "PASS"}
{WAIT "5000" "CLICK" "SKIP"}
{WAIT "2000" "CLICK" "SKIP"}
{PLAYSND "SE\自動ドア.ogg" "VOICE2" "NORMAL" "1000" "0"}
{WAIT "2000" "CLICK" "SKIP"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\伊勢全身.gal" "NORMAL" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "500" "CLICK" "SKIP"}
{MESON "500"}
{STOPSND "SE" "5000" "PASS"}
<STYLE ID="2">"Hah... hah... </STYLE>
{PAUSE ""}
<STYLE ID="2">Oh! The Motoki Pretty Girl Appreciation Society's No. 1... </STYLE>
{PAUSE ""}
<STYLE ID="2">I mean, Motoki-cho's No. 1 genius girl, </STYLE>Erina Goto<STYLE ID="2">!</STYLE>
{PAUSE ""}
<STYLE ID="2">　So you really did come!"</STYLE>
{PAUSE ""}
<BR>
"Um... are you the assistant inspector?"
{PAUSE ""}
<BR>
{PLAYSND "伊勢.ogg" "BGM" "REPEAT" "1000" "0"}
<STYLE ID="2">"I-I-I-I-Indeed I am!</STYLE>
{PAUSE ""}
<STYLE ID="2">　I am Daijiro Ise, commanding the scene of this morning's case!"</STYLE>
{PAUSE ""}
<BR>
"Thank goodness! The truth is, I've figured out both who the culprit is and how to arrest them!"<PG>
<STYLE ID="2">"V-very well!</STYLE>
{PAUSE ""}
<STYLE ID="2">　Then let us talk, just the two of us... </STYLE>
{PAUSE ""}
<STYLE ID="2">I mean, let me hear </STYLE>your<STYLE ID="2"> testimony!"</STYLE>
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{MESOFF "500"}
{STOPSND "BGM" "3000" "PASS"}
{DELETECG "000,人物1" "1" "3000" "0" "0" "" "0"}
<PG>
{}
<EVENT VALUE="MESEND">
;---------------------------------------
; END DECOMPILED SCRIPT
