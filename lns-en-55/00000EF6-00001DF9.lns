{MESON "500"}
<STYLE ID="5">Haruka's</STYLE><STYLE ID="1"> half-open eyes close as I lay my hand over them and </STYLE><STYLE ID="8" RUBY="な">stroke</STYLE><STYLE ID="1"> downward.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">"What..."</STYLE>
{PAUSE ""}
