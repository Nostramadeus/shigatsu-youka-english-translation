{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="5">"Hey, </STYLE><STYLE ID="3">Akane</STYLE><STYLE ID="5">..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Hm?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">"Thank you for coming to save me."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Sorry for being 2 whole years late."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">"Heh, </STYLE><STYLE ID="3">Akane</STYLE><STYLE ID="5">, thank you... We really are best friends after all."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Always, from now on too..."</STYLE><PG>
