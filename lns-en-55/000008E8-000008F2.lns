<BR>
<STYLE ID="10">"</STYLE><STYLE ID="5">Mifuyu-chan</STYLE><STYLE ID="10">, you're the best wife in the world too!"</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\栄一郎バストアップ.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
