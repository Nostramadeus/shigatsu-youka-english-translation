{CREATECG "人物3" "グラフィック\立ち絵\人物\詫言編　始まり以降\茜美冬膝枕.gal" "NORMAL" "#1" "L" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物2,人物1" "1" "3000" "0" "0" "" "0"}
