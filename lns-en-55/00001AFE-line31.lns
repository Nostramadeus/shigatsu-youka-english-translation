<SCENARIO VER="105">
<BR>
<TXSPD TIME="4294967246">Do you remember what happened in Megasawa City?
{WAIT "1000" "NORMAL" "SKIP"}
<EVENT VALUE="TEXTCLEAR">
<PG>
<BR>
Did you think you could be happy if that incident never happened?
{WAIT "1000" "NORMAL" "SKIP"}
<EVENT VALUE="TEXTCLEAR">
<PG>
<BR>
<STYLE ID="1">Never knowing that avoiding the Megasawa case would make something far, far more horrible happen―</STYLE>
{WAIT "2000" "NORMAL" "SKIP"}
{MESOFF "1000"}
{}
<EVENT VALUE="MESEND">
