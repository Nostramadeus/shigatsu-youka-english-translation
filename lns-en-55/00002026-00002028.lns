;    4: TDecorate(count=2, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=ちいろ, unk10=4294967295, unk11=4294967295)
;    5: TDecorate(count=3, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=あらが, unk10=4294967295, unk11=4294967295)
;    6: TDecorate(count=2, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=しんし, unk10=4294967295, unk11=4294967295)
;    7: TDecorate(count=2, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=いおう, unk10=4294967295, unk11=4294967295)
;    8: TDecorate(count=2, unk2=13464750, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=しんし, unk10=4294967295, unk11=4294967295)
;    9: TDecorate(count=2, unk2=13464750, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=いおう, unk10=4294967295, unk11=4294967295)
;   10: TDecorate(count=2, unk2=13464750, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=ききょう, unk10=4294967295, unk11=4294967295)
