<SCENARIO VER="105">
{STOPSND "SE" "3000" "PASS"}
{WAIT "4000" "CLICK" "SKIP"}
{CHANGECG "000" "グラフィック\背景\スチル\ラスト\並ぶ.gal" "NORMAL" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<TXSPN>The voice stopped, and for a while we were speechless.<PG>
<STYLE ID="1">"</STYLE><STYLE ID="2">Haruka</STYLE><STYLE ID="1">..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"</STYLE><STYLE ID="2">Senpai</STYLE><STYLE ID="3">..."</STYLE><PG>
{MESOFF "1000"}
{CHANGECG "000" "グラフィック\背景\スチル\ラスト\外背景.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\春花うつむき.gal" "NORMAL" "#1" "R" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\春花横顔上.gal" "NORMAL" "1" "200" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{CHANGECG "000" "グラフィック\背景\最後の声から\荒田月なし.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1" "1" "500" "0" "0" "" "0"}
<EVENT VALUE="MOTION\r\n789\r\n000\r\n4\r\n0\r\n500\r\nDEC\r\nPASS">
{WAIT "500" "CLICK" "SKIP"}
<EVENT VALUE="MOTION\r\n789\r\n000\r\n4\r\n0\r\n0\r\nDEC\r\nPASS">
