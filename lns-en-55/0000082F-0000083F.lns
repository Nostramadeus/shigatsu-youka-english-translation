{DELETECG "アイテム1" "1" "0" "0" "0" "" "0"}
{MESON "500"}
<STYLE ID="3">For an instant, something fluffy and cherry-pink passed in front of my eyes.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">That was... </STYLE>
{PAUSE ""}
{MESOFF "500"}
{CREATECG "アイテム1" "グラフィック\立ち絵\アイテム\風船.gal" "NORMAL" "#1" "600" "T" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "000" "1" "3000" "0" "0" "" "0"}
