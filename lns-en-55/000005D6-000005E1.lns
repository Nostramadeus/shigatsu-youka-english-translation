{PAUSE ""}
<BR>
<STYLE ID="1">It seemed </STYLE><STYLE ID="2">Haruka</STYLE><STYLE ID="1"> had been holding a bit of a grudge.</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\春花うつむき.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "アイテム1" "1" "500" "0" "0" "" "0"}
{MESON "500"}
<STYLE ID="2">"N-no, it's nothing! I'll gladly take it!"</STYLE>
{PAUSE ""}
<BR>
{STOPSND "BGM" "3000" "PASS"}
<STYLE ID="1">With that, </STYLE><STYLE ID="2">Haruka</STYLE><STYLE ID="1"> opened the lid.</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{PLAYSND "SE\追加分\ペットボトルふた生音.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAITPLAY "VOICE" "CLICK"}
