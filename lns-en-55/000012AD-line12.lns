{CREATECG "111" "$000080" "NORMAL" "#1" "C" "B" "200" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\エリカバストアップ.gal" "NORMAL" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{STOPSND "VOICE2" "0" "PASS"}
{DELETECG "111,人物2" "1" "0" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="1">"</STYLE><STYLE ID="2">Haruka</STYLE><STYLE ID="1">, </STYLE><STYLE ID="3">Goto-chan</STYLE><STYLE ID="1">, and </STYLE><STYLE ID="6">Kana</STYLE><STYLE ID="1"> aren't back yet, but let's go ahead and eat."</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\美冬バストアップ.gal" "NORMAL" "#1" "L" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="4">"Did you find </STYLE><STYLE ID="6">Kana-chan</STYLE><STYLE ID="4">?"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\幸太郎バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="5">"Probably in the storehouse. </STYLE>
{PAUSE ""}
<STYLE ID="5">The light was on, so maybe she's searching the storehouse again."</STYLE><PG>
{MESOFF "500"}
