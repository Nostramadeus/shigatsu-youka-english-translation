;    1: TDecorate(count=2, unk2=4294967295, unk3=4294967295, unk4=0, unk5=0, unk6=0, unk7=4294967295, unk8=, ruby=たちき, unk10=4294967295, unk11=4294967295)
;    2: TDecorate(count=2, unk2=4294967295, unk3=4294967295, unk4=0, unk5=0, unk6=0, unk7=4294967295, unk8=, ruby=みか, unk10=4294967295, unk11=4294967295)
