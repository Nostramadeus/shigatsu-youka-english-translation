{WAIT "1000" "CLICK" "SKIP"}
{DELETECG "アイテム1" "1" "500" "0" "0" "" "0"}
{MESON "500"}
<STYLE ID="1">I turned off my phone and squeezed </STYLE><STYLE ID="3">Haruka</STYLE><STYLE ID="1">'s hand tight.</STYLE><PG>
{MESOFF "500"}
{CHGVOL "BGM" "700" "3000" "PASS"}
{DELETECG "000,人物1" "1" "2000" "0" "0" "" "0"}
