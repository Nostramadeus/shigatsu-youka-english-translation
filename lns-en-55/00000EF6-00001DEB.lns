{MESON "500"}
<STYLE ID="2"><TXSPS>"Na-na-Natsu-na-Natsu-tsu-tsu-na-na-Natsu-tsu-mi-mi-mi-Natsu-tsu―"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{PLAYSND "SE\tumbling1.ogg" "VOICE" "NORMAL" "1000" "0"}
{CHANGECG "人物2" "グラフィック\立ち絵\人物\真呪殺\肉付き\春花横顔髪寝る.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
