<SCENARIO VER="105">
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "環境音\山の中.ogg" "SE" "REPEAT" "1000" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{PLAYMOVIE "111.wmv" "256" "C" "C" "REPEAT" "FALSE" "300" "0"}
<EVENT VALUE="MOTION\r\n789\r\nムービー\r\n11\r\n50\r\n3000\r\nNORMAL\r\nPASS">
{CREATECG "111" "$001313" "NORMAL" "#1" "C" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "000" "グラフィック\背景\詫言編　夢から\荒田桜1.gal" "NORMAL" "#1" "C" "T" "100" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
<EVENT VALUE="MOTION\r\n789\r\nムービー\r\n11\r\n50\r\n0\r\nNORMAL\r\nPASS">
{WAIT "1000" "CLICK" "SKIP"}
<EVENT VALUE="MOTION\r\n789\r\n000\r\n4\r\n-447\r\n5000\r\nDEC\r\nPASS">
{WAIT "5000" "CLICK" "SKIP"}
<EVENT VALUE="MOTION\r\n789\r\n000\r\n4\r\n-447\r\n0\r\nDEC\r\nPASS">
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>"<STYLE ID="1">Ko-san</STYLE>... So you came, after all."
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\リファレンス用\立ち絵\晃\晃御使い.gal" "NORMAL" "#1" "R" "B" "100" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="1">"Yeah, I've come for you."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">The dead, moving―</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">There are any number of ghost stories like that.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">But </STYLE><STYLE ID="3">Shinozaki-san's</STYLE><STYLE ID="2"> report had set it down as fact.</STYLE><PG>
"<STYLE ID="1">Ko-san</STYLE>... 
{PAUSE ""}
No, the Goddess wearing <STYLE ID="1">Ko-san's</STYLE> <STYLE ID="4" RUBY="むくろ">body</STYLE>. 
{PAUSE ""}
You're finished now."
{PAUSE ""}
<BR>
<STYLE ID="1">"............"</STYLE>
{PAUSE ""}
<BR>
"Will you kill me here?
{PAUSE ""}
　I don't mind. I was able to keep my promise to <STYLE ID="1">Ko-san</STYLE>."
{PAUSE ""}
<BR>
<STYLE ID="1">"............"</STYLE>
{PAUSE ""}
<BR>
"This settlement has been freed from your rule."<PG>
<STYLE ID="1">"............ </STYLE>
{PAUSE ""}
<STYLE ID="1">Naive."</STYLE>
{PAUSE ""}
<BR>
"Huh?"
{PAUSE ""}
<BR>
<STYLE ID="1">"Freed from my rule? </STYLE>
{PAUSE ""}
<STYLE ID="1">　Hahaha! Honestly, humans really are simple. </STYLE>
{PAUSE ""}
<STYLE ID="1">To think you'd believe you had won with this little."</STYLE>
{PAUSE ""}
<BR>
"............"<PG>
<STYLE ID="1">"Fine. Before you die, I'll tell you my plan from here on. </STYLE>
{PAUSE ""}
<STYLE ID="1">It's..."</STYLE><PG>
{STOPSND "SE" "0" "PASS"}
{CREATECG "222" "$000000" "NORMAL" "#1" "C" "B" "600" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
{}
<EVENT VALUE="MESEND">
