<SCENARIO VER="105">
<EVENT VALUE="TEXTCLEAR">
<PG>
{WAIT "1000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\背景\イタリアンテーブル.gal" "WAIT" "#1" "C" "B" "0" "1" "2000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "NORMAL" "NORMAL"}
{MESON "500"}
<TXSPD TIME="4294967246">"<STYLE ID="1">Mifuyu</STYLE>, let me introduce you. 
{WAIT "1000" "NORMAL" "SKIP"}
<STYLE ID="2">Ryoji-kun</STYLE>'s coworker from his company, <STYLE ID="3">Eiichiro Niimura-san</STYLE>."
{WAIT "2000" "NORMAL" "NORMAL"}
{MESOFF "0"}
<EVENT VALUE="TEXTCLEAR">
<PG>
{DELETECG "000" "1" "0" "0" "0" "" "0"}
{WAIT "2000" "NORMAL" "NORMAL"}
{PLAYSND "エデンの桜\SE\赤ちゃん　泣く　鳴き声　かわいい　長い.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAIT "3000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\背景\詫言編　夢から\なつみ病室.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "NORMAL" "NORMAL"}
{MESON "500"}
<STYLE ID="4">A healthy baby girl was born.</STYLE>
{WAIT "1000" "NORMAL" "SKIP"}
<BR>
<STYLE ID="4">That child was named </STYLE><STYLE ID="5">Haruka</STYLE><STYLE ID="4">.</STYLE>
{WAIT "2000" "NORMAL" "NORMAL"}
<EVENT VALUE="TEXTCLEAR">
<PG>
<STYLE ID="4">Then, in the summer of the year after that, one more girl was born.</STYLE>
{WAIT "1000" "NORMAL" "SKIP"}
<BR>
<STYLE ID="4">That child was named </STYLE><STYLE ID="6">Natsumi</STYLE><STYLE ID="4">.</STYLE>
{WAIT "2000" "NORMAL" "NORMAL"}
{MESOFF "500"}
{STOPSND "VOICE" "3000" "PASS"}
{DELETECG "000" "1" "3000" "0" "0" "" "0"}
<EVENT VALUE="TEXTCLEAR">
<PG>
{MESON "500"}
<STYLE ID="1">"</STYLE>Akane<STYLE ID="1">, thank you for everything until now. </STYLE>
{WAIT "1000" "NORMAL" "SKIP"}
<STYLE ID="1">I'm sure I'll be happy. </STYLE>
{WAIT "1000" "NORMAL" "SKIP"}
Akane<STYLE ID="1">, you be happy too."</STYLE>
{WAIT "1000" "NORMAL" "SKIP"}
<BR>
"Yes, we'll always be best friends."
{WAIT "1000" "NORMAL" "SKIP"}
<BR>
<STYLE ID="1">"Yeah, forever and ever."</STYLE>
{WAIT "2000" "NORMAL" "NORMAL"}
{MESOFF "3000"}
<EVENT VALUE="TEXTCLEAR">
<PG>
{}
<EVENT VALUE="MESEND">
