<SCENARIO VER="105">
{PLAYSND "Attack.ogg" "BGM" "REPEAT" "1000" "0"}
{WAIT "930" "NORMAL" "SKIP"}
{PLAYMOVIE "炎.wmv" "256" "C" "C" "REPEAT" "FALSE" "0" "255"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\春花頭抱える.gal" "NORMAL" "#1" "R" "960" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
