;    1: TDecorate(count=707, unk2=16757864, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    2: TDecorate(count=6, unk2=11271932, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    3: TDecorate(count=1538, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    4: TDecorate(count=1, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=ま, unk10=4294967295, unk11=4294967295)
;    5: TDecorate(count=24, unk2=16776960, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    6: TDecorate(count=70, unk2=8388863, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    7: TDecorate(count=15, unk2=16755455, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    8: TDecorate(count=1, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=ほお, unk10=4294967295, unk11=4294967295)
;    9: TDecorate(count=4, unk2=16757864, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=・・・・, unk10=4294967295, unk11=4294967295)
;   10: TDecorate(count=5, unk2=5265653, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;   11: TDecorate(count=2, unk2=65535, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
; Display conditions:
;    0: TWdCondition(count=3225, target=)
; Links:
;    0: TWdLink(count=2981, event=, unk3=)
;---------------------------------------
; BEGIN DECOMPILED SCRIPT
;---------------------------------------
<SCENARIO VER="105">
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "BGM死月編\Abyss～深淵に至る窓～.ogg" "BGM" "REPEAT" "1000" "0"}
{CREATECG "000" "グラフィック\背景\女神\廃屋中.gal" "NORMAL" "#1" "C" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\茅萱バストアップ.gal" "NORMAL" "#1" "R" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>"Hey, <STYLE ID="1">Chiga-nee</STYLE>, before we talk, I wanna ask something..."
{PAUSE ""}
<BR>
<STYLE ID="1">"Mm... What is it?"</STYLE>
{PAUSE ""}
<BR>
"Do I... smell? I've been holed up in the mountains this whole time and barely changed my clothes..."<PG>
<STYLE ID="1">"Mm... You don't really smell, but were you doing your laundry properly?"</STYLE>
{PAUSE ""}
<BR>
"Well, more or less. No detergent, though."
{PAUSE ""}
<BR>
<STYLE ID="1">"Mm... It doesn't bother me. </STYLE><STYLE ID="2">Kana</STYLE><STYLE ID="1"> might notice, though."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">For now, I use small talk to get a feel for the air between me and </STYLE><STYLE ID="1">Chiga-nee</STYLE><STYLE ID="3">.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Chiga-nee</STYLE><STYLE ID="3"> was another one I hadn't seen in ages, and yet I wasn't even given a </STYLE><STYLE ID="4" RUBY="ま">moment</STYLE><STYLE ID="3"> to feel nostalgic.</STYLE><PG>
"So... what about the third-year memorial service?"
{PAUSE ""}
<BR>
<STYLE ID="1">"Mm... Right... I should tell you..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">And </STYLE><STYLE ID="1">Chiga-nee</STYLE><STYLE ID="3"> takes one big, deep breath.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Is she nervous? Whatever she has to say doesn't seem light.</STYLE><PG>
<STYLE ID="1">"Mm... The third-year memorial service was canceled. Something kind of serious happened..."</STYLE>
{PAUSE ""}
<BR>
"Canceled? Canceling a memorial service, that's gotta be something big..."
{PAUSE ""}
<BR>
<STYLE ID="1">"Mm... I'm sorry. We couldn't hold </STYLE><STYLE ID="5">Auntie</STYLE><STYLE ID="1">'s third-year memorial service."</STYLE>
{PAUSE ""}
<BR>
"No, no, this is way bigger than a memorial service, right? What happened?"<PG>
<STYLE ID="1">"Mm... </STYLE><STYLE ID="6">Mom</STYLE><STYLE ID="1">... </STYLE>
{PAUSE ""}
<STYLE ID="1">She made a prophecy."</STYLE>
{PAUSE ""}
<BR>
"A prophecy... what's that about?"
{PAUSE ""}
<BR>
<STYLE ID="1">"Mm... </STYLE>Haruka<STYLE ID="1">, didn't you know? </STYLE><STYLE ID="6">Mom</STYLE><STYLE ID="1">'s precognition only works while the cherry blossoms are in bloom."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">That's news to me. Just like </STYLE><STYLE ID="7">Natsumi</STYLE><STYLE ID="3">.</STYLE><PG>
<STYLE ID="1">"Mm... If I suddenly tell you </STYLE><STYLE ID="6">Mom</STYLE><STYLE ID="1"> has precognition, you won't believe me, will you?"</STYLE>
{PAUSE ""}
<BR>
"No, I believe you. It's fine, keep going."
{PAUSE ""}
<BR>
<STYLE ID="3">I deliberately kept quiet about </STYLE><STYLE ID="7">Natsumi</STYLE><STYLE ID="3">.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Bringing her up here seemed like it would just complicate things.</STYLE><PG>
<STYLE ID="1">"Mm... According to </STYLE><STYLE ID="6">Mom</STYLE><STYLE ID="1">... </STYLE>
{PAUSE ""}
<STYLE ID="1">today, Shiyo 802, April 8― </STYLE>
{PAUSE ""}
<STYLE ID="1">a threat that will destroy the settlement is coming from the outside world."</STYLE>
{PAUSE ""}
<BR>
"A threat that'll destroy the settlement... 
{PAUSE ""}
Haha, what's that supposed to be?"
{PAUSE ""}
<BR>
<STYLE ID="3">I couldn't help snorting, but </STYLE><STYLE ID="1">Chiga-nee</STYLE><STYLE ID="3"> isn't someone who tells silly lies like that.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">In fact, </STYLE><STYLE ID="1">Chiga-nee</STYLE><STYLE ID="3">'s face is dead serious.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">I quickly drop the grin from my </STYLE><STYLE ID="8" RUBY="ほお">cheeks</STYLE><STYLE ID="3"> as well.</STYLE><PG>
"A threat from the outside world, what does that mean?"
{PAUSE ""}
<BR>
<STYLE ID="1">"Mm... It seems </STYLE><STYLE ID="6">Mom</STYLE><STYLE ID="1"> couldn't see anything beyond that, but... </STYLE>
{PAUSE ""}
<STYLE ID="1">when I hear 'something that comes from the outside world,' I really can't think of anything but people. </STYLE>
{PAUSE ""}
<STYLE ID="1">And no guests seem to be expected for the third-year memorial service either."</STYLE>
{PAUSE ""}
<BR>
"Then if <STYLE ID="6">Sakura-san</STYLE>'s prophecy is real, we'd better keep watch over the settlement."<PG>
<STYLE ID="1">"Mm... That's right, so I was keeping watch. </STYLE>
{PAUSE ""}
<STYLE ID="1">And then, on the meeting hall's roof..."</STYLE>
{PAUSE ""}
<BR>
"Oh, I see... So I was being treated as a suspicious person. 
{PAUSE ""}
My hair's grown out, and my clothes are in tatters..."
{PAUSE ""}
<BR>
<STYLE ID="3">For a moment it made sense, but right away the next question comes up.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Why did </STYLE><STYLE ID="1">Chiga-nee</STYLE><STYLE ID="3"> avoid being seen and bring me all the way out here?</STYLE><PG>
<STYLE ID="1">"Mm... 'Something that comes from the outside world'― </STYLE>
{PAUSE ""}
<STYLE ID="1">I thought that maybe even you, </STYLE>Haruka<STYLE ID="1">, might be no exception."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">............?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">I don't quite get what </STYLE><STYLE ID="1">Chiga-nee</STYLE><STYLE ID="3"> means.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">If I'm no exception to the things that come from the outside world, then... </STYLE>
{PAUSE ""}
<STYLE ID="3">does that mean I'm someone from the outside world?</STYLE><PG>
"No, I'm a member of the Niimura family, someone of this Arata settlement's bloodline, right?
{PAUSE ""}
　Why would I get treated like that...?"
{PAUSE ""}
<BR>
<STYLE ID="1">"Mm... That's..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">It feels like I'm being treated as an outsider, and I don't like it much.</STYLE><PG>
"What, is there some reason I'd be treated as an outsider?"
{PAUSE ""}
<BR>
<STYLE ID="1">"Mm... No, I was just being careful, </STYLE><STYLE ID="9" RUBY="・・・・">just in case</STYLE><STYLE ID="1">."</STYLE>
{PAUSE ""}
<BR>
"Ah... Everyone's really wary, huh. On top of <STYLE ID="6">Sakura-san</STYLE> foreseeing something like that, if I come back earlier than planned... 
{PAUSE ""}
But aren't you wary of me, <STYLE ID="1">Chiga-nee</STYLE>?"<PG>
<STYLE ID="1">"Mm... It's less that I'm wary... </STYLE>
{PAUSE ""}
<STYLE ID="1">more that I want to find out what this threat really is..."</STYLE>
{PAUSE ""}
<BR>
"Something about this doesn't quite sit right... 
{PAUSE ""}
Well, basically, you're saying some weirdo might show up today, right?
{PAUSE ""}
　If I come down from the mountain right then, sure, people might find it a little weird, but..."
{PAUSE ""}
<BR>
<STYLE ID="1">"Mm... So, </STYLE>Haruka<STYLE ID="1">, don't meet anyone today. </STYLE>
{PAUSE ""}
<STYLE ID="1">I'll keep it a secret from everyone too."</STYLE><PG>
"Got it. Then is there anything I can help with?
{PAUSE ""}
　You're watching the roads into the settlement, right?"
{PAUSE ""}
<BR>
<STYLE ID="1">"Mm... That would help. </STYLE>
{PAUSE ""}
<STYLE ID="1">Then, </STYLE>Haruka<STYLE ID="1">, could you take the Arata Station side, where you're less likely to be seen? </STYLE>
{PAUSE ""}
<STYLE ID="1">　</STYLE><STYLE ID="2">Kana</STYLE><STYLE ID="1">'s watching the Toyotake Station side, and I'm patrolling the settlement."</STYLE>
{PAUSE ""}
<BR>
"Hey, <STYLE ID="1">Chiga-nee</STYLE>..."
{PAUSE ""}
<BR>
<STYLE ID="1">"Mm... What is it?"</STYLE><PG>
"<STYLE ID="1">Chiga-nee</STYLE>, what do you believe?
{PAUSE ""}
　<STYLE ID="6">Sakura-san</STYLE>'s foresight?
{PAUSE ""}
　Or me, showing up out of nowhere?"
{PAUSE ""}
<BR>
<STYLE ID="1">"Mm... Both. I don't think you, </STYLE>Haruka<STYLE ID="1">, are a threat. </STYLE>
{PAUSE ""}
<STYLE ID="1">But there might be people in the settlement who see you, </STYLE>Haruka<STYLE ID="1">, as a threat. That's all."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Things have gotten kind of strange.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="6">Sakura-san</STYLE><STYLE ID="3"> having precognition like </STYLE><STYLE ID="7">Natsumi</STYLE><STYLE ID="3">'s was news to me, and on top of that, being told a threat from outside just happens to be coming today...</STYLE><PG>
<STYLE ID="3">Still, I came all this way.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">There must be something I can help with too.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Maybe the time's come to show off what the mountain seclusion did for me.</STYLE>
{CREATECG "リファレンス解禁画像" "グラフィック\システム\リファレンス解禁画像.gal" "NORMAL" "#1" "184" "600" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<PG>
{MESOFF "500"}
{STOPSND "BGM" "3000" "PASS"}
{STOPSND "SE" "3000" "PASS"}
{DELETECG "000,人物1" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "SE\詫言編　夢から\door_old1.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="3">―I part ways with </STYLE><STYLE ID="1">Chiga-nee</STYLE><STYLE ID="3"> and head for Arata Station, taking the long way around so I won't be seen.</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\砂利を歩く.ogg" "VOICE" "REPEAT" "1000" "0"}
{WAIT "3000" "CLICK" "SKIP"}
{PLAYSND "BGM死月編\深淵からの呼び声.ogg" "BGM" "REPEAT" "1000" "0"}
{CREATECG "000" "グラフィック\背景\詫言編　夢から\荒田山道昼.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="3">It was sunny until a moment ago, but the sky's looking a little threatening.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Not as much as Mount Itohime, but the Arata settlement is deep in the mountains too. The weather changes easily here as well.</STYLE><PG>
{CHGVOL "VOICE" "500" "10000" "PASS"}
<STYLE ID="3">Still, "a threat that will destroy the settlement"―for such a grand way of putting it, it's pretty vague...</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="7">Natsumi</STYLE><STYLE ID="3">, if I remember right... could sense danger if she met someone who was going to be in danger, or talked with them directly.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">If </STYLE><STYLE ID="6">Sakura-san</STYLE><STYLE ID="3"> is the same, she must have met or talked with someone who's going to be in danger.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">So "destroy the settlement" means she judged that the danger would reach everyone in the settlement, right?</STYLE><PG>
<STYLE ID="3">Going from just that to "a threat that will destroy the settlement is coming"... isn't that a bit of a leap?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">In that case, the settlement being destroyed by an earthquake or a plane crash seems more realistic.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">But that's not how they're responding now.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">They're watching the roads to keep anyone who's a threat from entering the settlement.</STYLE><PG>
<STYLE ID="3">I can't imagine </STYLE><STYLE ID="6">Sakura-san</STYLE><STYLE ID="3">, of all people, making a fuss over such a simplistic idea, and I should have talked with </STYLE><STYLE ID="6">Sakura-san</STYLE><STYLE ID="3"> at least once too.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">What should I do? Sneak back into the settlement?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Besides, there's no need to take something as ridiculous as "someone's coming to destroy the settlement" seriously, is there...?</STYLE><PG>
{STOPSND "VOICE" "500" "PASS"}
<STYLE ID="3">This is where I finally stop walking.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">I sort out the situation and my guesses again.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Say someone does come to the Arata settlement, like </STYLE><STYLE ID="6">Sakura-san</STYLE><STYLE ID="3"> says.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">If someone comes, it's probably something to do with </STYLE><STYLE ID="5">Mom</STYLE><STYLE ID="3">, since today's the anniversary of her death.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">Mom</STYLE><STYLE ID="3">'s pursuers, the police? Or </STYLE><STYLE ID="5">Mom</STYLE><STYLE ID="3">'s old friends?</STYLE><PG>
<STYLE ID="3">But </STYLE><STYLE ID="1">Chiga-nee</STYLE><STYLE ID="3"> said no visitors from outside were expected for the third-year memorial service...</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Yeah, if anyone comes, it'll probably be the police.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">They might come to dig into the incident in Motoki-cho, timed to the third-year memorial service, when all the Arata people are gathered.</STYLE><PG>
<STYLE ID="3">If so, they'd come in a police car or some other vehicle, not on foot.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Then keeping watch would be useless, and against the police there'd be no getting away.</STYLE><PG>
<STYLE ID="3">Waiting at Arata Station really isn't a great idea, then.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Chiga-nee</STYLE><STYLE ID="3"> or </STYLE><STYLE ID="10">Kotaro-san</STYLE><STYLE ID="3"> should be able to think of that much...</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Okay, I'll head back to the settlement for now and hear what </STYLE><STYLE ID="6">Sakura-san</STYLE><STYLE ID="3"> has to say.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Me watching Arata Station probably won't help anyway.</STYLE><PG>
{MESOFF "500"}
{PLAYMOVIE "雨1.wmv" "256" "C" "C" "REPEAT" "FALSE" "100" "0"}
<EVENT VALUE="MOTION\r\n789\r\nムービー\r\n11\r\n150\r\n5000\r\nNORMAL\r\nPASS">
{PLAYSND "環境音\雷雨.ogg" "SE" "REPEAT" "0" "0"}
{CHGVOL "SE" "1000" "10000" "PASS"}
{WAIT "5000" "CLICK" "SKIP"}
<EVENT VALUE="MOTION\r\n789\r\nムービー\r\n11\r\n150\r\n0\r\nNORMAL\r\nPASS">
{MESON "500"}
<STYLE ID="3">See, it finally started coming down.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Now I can go back to the Niimura main house with the heavy rain as my excuse.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">But just in case, I'll move so that nobody outside the Niimura family sees me.</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\詫言編　夢から\砂利を走る.ogg" "VOICE" "REPEAT" "1000" "0"}
<EVENT VALUE="MOTION\r\n789\r\nムービー\r\n11\r\n255\r\n3000\r\nNORMAL\r\nPASS">
{DELETECG "000" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="3">Honestly, rain like this is nothing to me.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">But more than this rain, I have a reason I need to go back to the settlement.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">I don't have intuition like </STYLE><STYLE ID="7">Natsumi</STYLE><STYLE ID="3">'s, or brains like </STYLE><STYLE ID="11">Goto</STYLE><STYLE ID="3">'s.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">But I know this settlement well.</STYLE><PG>
<STYLE ID="3">Something... something is about to happen.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="6">Sakura-san</STYLE><STYLE ID="3">'s foresight, the destruction of the settlement... something smells fishy.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">But my goal is just one thing. To put everyone in the settlement at ease.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">And if possible, I want them to hold at least some kind of memorial service for </STYLE><STYLE ID="5">Mom</STYLE><STYLE ID="3">.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">To ease the suffering of </STYLE><STYLE ID="5">Mom</STYLE><STYLE ID="3">, burning in hell.</STYLE>
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{MESOFF "500"}
{STOPSND "BGM" "3000" "PASS"}
{STOPSND "VOICE" "3000" "PASS"}
<EVENT VALUE="MOTION\r\n789\r\nムービー\r\n11\r\n0\r\n3000\r\nNORMAL\r\nPASS">
{DELETECG "000" "1" "3000" "0" "0" "" "0"}
<EVENT VALUE="STOPMOVIE">
<PG>
{}
<EVENT VALUE="MESEND">
;---------------------------------------
; END DECOMPILED SCRIPT
;---------------------------------------