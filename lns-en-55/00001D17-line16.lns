<SCENARIO VER="105">
<EVENT VALUE="MOTION\r\n789\r\nムービー\r\n11\r\n0\r\n3000\r\nNORMAL\r\nPASS">
{CHANGECG "000" "グラフィック\背景\詫言編　夢から\新村本家居間.gal" "NORMAL" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
<EVENT VALUE="STOPMOVIE">
{WAIT "1000" "CLICK" "SKIP"}
{STOPSND "VOICE" "500" "PASS"}
{MESON "500"}
<TXSPN>"Thank you very much!"
{PAUSE ""}
<BR>
{PLAYSND "リファレンス専用\SE\拍手複数人.ogg" "SE" "NORMAL" "1000" "0"}
<STYLE ID="1">"</STYLE>Haruka<STYLE ID="1">aa! That was great!"</STYLE>
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{MESOFF "500"}
{STOPSND "SE" "3000" "PASS"}
{DELETECG "000,アイテム1" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
<PG>
{}
<EVENT VALUE="MESEND">
