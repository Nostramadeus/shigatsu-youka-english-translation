;   10: TDecorate(count=1, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=だま, unk10=4294967295, unk11=4294967295)
;   11: TDecorate(count=3, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=・・・, unk10=4294967295, unk11=4294967295)
;   12: TDecorate(count=3, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=むくろ, unk10=4294967295, unk11=4294967295)
;   13: TDecorate(count=1, unk2=5265653, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=たた, unk10=4294967295, unk11=4294967295)
;   14: TDecorate(count=4, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=こんしん, unk10=4294967295, unk11=4294967295)
;   15: TDecorate(count=2, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=しょくざい, unk10=4294967295, unk11=4294967295)
;   16: TDecorate(count=29, unk2=16755370, unk3=4294967295, unk4=20, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;   17: TDecorate(count=9, unk2=65535, unk3=4294967295, unk4=20, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;   18: TDecorate(count=4, unk2=11271932, unk3=4294967295, unk4=20, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;   19: TDecorate(count=5, unk2=13464750, unk3=4294967295, unk4=20, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;   20: TDecorate(count=3, unk2=16755455, unk3=4294967295, unk4=20, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;   21: TDecorate(count=41, unk2=5265653, unk3=4294967295, unk4=48, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;   22: TDecorate(count=36, unk2=8421504, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;   23: TDecorate(count=3, unk2=6413008, unk3=4294967295, unk4=48, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;   24: TDecorate(count=5, unk2=8388863, unk3=4294967295, unk4=48, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;   25: TDecorate(count=72, unk2=16757864, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
; Display conditions:
;    0: TWdCondition(count=9477, target=)
; Links:
;    0: TWdLink(count=8514, event=, unk3=)
;---------------------------------------
; BEGIN DECOMPILED SCRIPT
;---------------------------------------
<SCENARIO VER="105">
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "環境音\洞窟内川.ogg" "SE" "REPEAT" "0" "0"}
{CHGVOL "SE" "1000" "3000" "PASS"}
{WAIT "3000" "CLICK" "SKIP"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<TXSPN>Mom<STYLE ID="1"> and I had talked. Whether </STYLE><STYLE ID="2">Sakura</STYLE><STYLE ID="1"> had heard us, I do not know.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">But </STYLE><STYLE ID="2">Sakura</STYLE><STYLE ID="1">, no, </STYLE><STYLE ID="3">Shigatsu Youka</STYLE><STYLE ID="1"> underestimates the strength of humans.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">At this point it probably does not think I can do anything.</STYLE><PG>
{MESOFF "500"}
{CREATECG "000" "グラフィック\背景\詫言編　夢から\秘密基地地下1.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="1">Behind me were </STYLE><STYLE ID="4">Natsumi-chan</STYLE><STYLE ID="1">, </STYLE><STYLE ID="5">Haruka-chan</STYLE><STYLE ID="1">, </STYLE><STYLE ID="6">Goto-chan</STYLE><STYLE ID="1">, and </STYLE><STYLE ID="7">Kana</STYLE><STYLE ID="1">.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">I was leading them farther in on the pretext of protecting them from the residents' attack.</STYLE><PG>
<STYLE ID="1">What I had talked about earlier with </STYLE>Mom<STYLE ID="1">―it had caused a slight change in my heart.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Did it not gall me to just keep taking it, she had asked.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Those words had been echoing inside me the whole time.</STYLE><PG>
<STYLE ID="1">I take stock of the situation as it stands.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Deeper in is </STYLE><STYLE ID="2">Sakura</STYLE><STYLE ID="1">, but at first she will probably keep herself hidden.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Then, once everyone but </STYLE><STYLE ID="4">Natsumi-chan</STYLE><STYLE ID="1"> has been knocked out or killed, she appears and urges </STYLE><STYLE ID="4">Natsumi-chan</STYLE><STYLE ID="1"> to become a divine messenger.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">And if I use Droga as well, all the divine messengers will be assembled.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Shigatsu Youka</STYLE><STYLE ID="1">'s plan has it that way.</STYLE><PG>
<STYLE ID="1">If it comes to that, what will happen?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Shigatsu Youka</STYLE><STYLE ID="1"> will probably become a creature with no weakness, flourishing semi-permanently.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">I do not even know what </STYLE><STYLE ID="3">Shigatsu Youka</STYLE><STYLE ID="1">'s weakness is to begin with, but either way, </STYLE><STYLE ID="3">Shigatsu Youka</STYLE><STYLE ID="1"> wants that.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">If I betray </STYLE><STYLE ID="3">Shigatsu Youka</STYLE><STYLE ID="1"> here―</STYLE><PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\詫言編　夢から\秘密基地地下2.gal" "NORMAL" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="1">The result is the same.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">The residents have already gone this far.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">The settlement cannot stay as peaceful as it has been.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Taking advantage of that, it will probably end up curse-killing everyone here.</STYLE><PG>
<STYLE ID="1">No... there is just one hope.</STYLE><PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\詫言編　夢から\秘密基地地下3.gal" "NORMAL" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="1">Shirozaki-san.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">If Shirozaki-san really has called the police, they should arrive before long.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">If several people from public authorities like that come here, even </STYLE><STYLE ID="3">Shigatsu Youka</STYLE><STYLE ID="1"> should not be able to act openly.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Shigatsu Youka</STYLE><STYLE ID="1"> is afraid, after all, of its existence becoming public.</STYLE><PG>
<STYLE ID="1">To begin with, there is already Droga in the residents' bodies.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">If everyone were arrested and given a drug test or the like, it would be quite a threat even for </STYLE><STYLE ID="3">Shigatsu Youka</STYLE><STYLE ID="1">.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">No, if that happened, then probably, just as when </STYLE><STYLE ID="8">Eiichiro</STYLE><STYLE ID="1"> died, the state would hush the case up.</STYLE><PG>
<STYLE ID="1">Is there a chance everyone in Arata will be killed?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">If the divine messengers do the killing themselves, the victims will probably be disposed of so that not even their bodies remain.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Even if the police come, as long as there are no bodies, it can be covered up for a while.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">But if everyone in the settlement were gone, the situation would become quite serious.</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\屋上ドア.ogg" "VOICE" "NORMAL" "1000" "0"}
{CHANGECG "000" "グラフィック\背景\詫言編　夢から\秘密基地地下扉あく.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
{STOPSND "VOICE" "1000" "WAIT"}
<STYLE ID="1">So, as for how </STYLE><STYLE ID="3">Shigatsu Youka</STYLE><STYLE ID="1"> will act, I can think of the two possibilities above.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Kill everyone, or leave the residents who used Droga to run loose.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">If I were </STYLE><STYLE ID="3">Shigatsu Youka</STYLE><STYLE ID="1">, I would choose to leave them loose.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">If all they did was use Droga, the state should hush the case up.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Even supposing the state took the settlement's existence seriously, it would buy more time than killing everyone.</STYLE><PG>
<STYLE ID="1">In other words―</STYLE>
{PAUSE ""}
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\詫言編　夢から\秘密基地奥1.gal" "NORMAL" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="1">What I must do is―</STYLE><PG>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\春花腰に手1バストアップ.gal" "NORMAL" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="5">"</STYLE><STYLE ID="9">Kotaro-san</STYLE><STYLE ID="5">, where's the passage? Looks like a dead end..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">Haruka-chan</STYLE><STYLE ID="1"> looked around, puzzled.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">There is a way to the summit of Mount Itohime through the place where Verde's mummy is kept, but...</STYLE><PG>
{MESOFF "500"}
{CREATECG "111" "グラフィック\背景\エデン\空洞\空洞セット.gal" "NORMAL" "#1" "C" "B" "100" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="1">That is dangerous.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Because then the whereabouts of Verde's mummy would become known to </STYLE><STYLE ID="3">Shigatsu Youka</STYLE><STYLE ID="1">.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Even at this very moment, </STYLE><STYLE ID="2">Sakura</STYLE><STYLE ID="1"> must be watching from somewhere.</STYLE><PG>
{MESOFF "500"}
{DELETECG "111" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="9">"Well, of course. This is a dead end."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">"Hey, what're you talking about..."</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\五島バストアップ.gal" "NORMAL" "#1" "L" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="6">"</STYLE><STYLE ID="9">Kotaro-san</STYLE><STYLE ID="6">, what are you planning to do with my senpai?"</STYLE><PG>
<STYLE ID="9">"Kuh-heh-heh-heh... Just what you'd expect of the </STYLE><STYLE ID="6">genius girl</STYLE><STYLE ID="9">, I guess?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">First, here, </STYLE><STYLE ID="2">Sakura</STYLE><STYLE ID="1"> is the one I must </STYLE><STYLE ID="10" RUBY="だま">deceive</STYLE><STYLE ID="1">.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">To do that, I must deceive everyone here.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">I am, to the very end, a fool doing whatever </STYLE><STYLE ID="2">Sakura</STYLE><STYLE ID="1"> and </STYLE><STYLE ID="3">Shigatsu Youka</STYLE><STYLE ID="1"> say.</STYLE><PG>
{MESOFF "500"}
{DELETECG "人物1,人物2" "1" "500" "0" "0" "" "0"}
{CHANGECG "000" "グラフィック\背景\詫言編　夢から\秘密基地奥2.gal" "NORMAL" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="5">"</STYLE><STYLE ID="9">Kotaro-san</STYLE><STYLE ID="5">... what's that supposed to mean?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="9">"What do I mean... Necessary, that's what </STYLE><STYLE ID="4">Natsumi-chan</STYLE><STYLE ID="9"> is."</STYLE>
{PAUSE ""}
<BR>
{STOPSND "SE" "3000" "PASS"}
{PLAYSND "SE\詫言編　夢から\鉈を構える.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAITPLAY "VOICE" "CLICK"}
<STYLE ID="1">I gripped the nata and walked toward the four of them.</STYLE><PG>
{PLAYSND "in_dream低.ogg" "BGM" "REPEAT" "1000" "0"}
<STYLE ID="9">"Well, well, for a while there I didn't know how things would turn out... </STYLE>
{PAUSE ""}
<STYLE ID="9">When </STYLE><STYLE ID="6">Goto-chan</STYLE><STYLE ID="9"> grilled me at breakfast, I'll admit I got nervous. </STYLE>
{PAUSE ""}
<STYLE ID="9">But somehow I managed to lead you all here."</STYLE><PG>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜ナイフ1.gal" "NORMAL" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="7">"</STYLE><STYLE ID="9">Daddy</STYLE><STYLE ID="7">! What are you saying!?"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{PLAYSND "SE\詫言編　夢から\ナイフを構える.ogg" "VOICE" "NORMAL" "1000" "0"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜ナイフ2.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="9">"Hey, hey, </STYLE><STYLE ID="7">Kana</STYLE><STYLE ID="9">... What are you going to do to Daddy?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="7">"Did </STYLE><STYLE ID="9">you</STYLE><STYLE ID="7"> kill </STYLE><STYLE ID="2">Mommy</STYLE><STYLE ID="7">...?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="9">"And if I did, what then?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="7">"</STYLE><STYLE ID="9">You</STYLE><STYLE ID="7"> always said... </STYLE>
{PAUSE ""}
<STYLE ID="2">Mommy</STYLE><STYLE ID="7">'s killer, if I ever found them, make them go through the same thing...!"</STYLE><PG>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\五島バストアップ.gal" "NORMAL" "#1" "L" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="6">"</STYLE><STYLE ID="9">Kotaro-san</STYLE><STYLE ID="6">, now that it's come to this, you'll tell us, won't you?</STYLE>
{PAUSE ""}
<STYLE ID="6">　How did you pull off the curse-killings? There has to be an accomplice."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="9">"You're overthinking it. Nobody managed to trace it back to me, that's all. </STYLE>
{PAUSE ""}
<STYLE ID="9">I'm the one who did them all...!"</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物2" "グラフィック\立ち絵\人物\五島怒りバストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="6">"That's a lie! That's completely impossible! There had to have been an accomplice!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="9">"</STYLE><STYLE ID="6">Goto-chan</STYLE><STYLE ID="9">... I'll give </STYLE><STYLE ID="6">your</STYLE><STYLE ID="9"> brains their due, okay? But this is reality. </STYLE>
{PAUSE ""}
<STYLE ID="9">You suspected me from the start, didn't you? So why not just leave it at that..."</STYLE><PG>
<STYLE ID="6">"</STYLE><STYLE ID="9">Kotaro-san</STYLE><STYLE ID="6">... </STYLE><STYLE ID="9">you</STYLE><STYLE ID="6">... who are you covering for?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">I cannot let them learn this truth.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="6">"Who are you covering for?"</STYLE><STYLE ID="1"> If I dared to answer that question, it would be all of you.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="9">"It's all </STYLE><STYLE ID="3">Shigatsu Youka</STYLE><STYLE ID="9">'s doing." </STYLE>
{PAUSE ""}
<STYLE ID="1">How much easier it would be if I could say that here.</STYLE><PG>
