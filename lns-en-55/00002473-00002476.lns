<STYLE ID="1">............!!</STYLE><PG>
<STYLE ID="1">At that moment, a figure leapt out in front of </STYLE><STYLE ID="5">Haruka-chan</STYLE><STYLE ID="1">.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">It was... </STYLE>
{PAUSE ""}
