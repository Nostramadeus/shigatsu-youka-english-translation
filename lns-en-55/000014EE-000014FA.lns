;    5: TDecorate(count=4, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=やまとなでしこ, unk10=4294967295, unk11=4294967295)
;    6: TDecorate(count=32, unk2=65280, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    7: TDecorate(count=3, unk2=7531958, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    8: TDecorate(count=61, unk2=6413008, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    9: TDecorate(count=179, unk2=16776960, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;   10: TDecorate(count=3, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=ほお, unk10=4294967295, unk11=4294967295)
;   11: TDecorate(count=65, unk2=16755370, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;   12: TDecorate(count=18, unk2=11271932, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;   13: TDecorate(count=2, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=げきこう, unk10=4294967295, unk11=4294967295)
; Display conditions:
;    0: TWdCondition(count=2055, target=)
; Links:
;    0: TWdLink(count=1833, event=, unk3=)
;---------------------------------------
; BEGIN DECOMPILED SCRIPT
;---------------------------------------
<SCENARIO VER="105">
{WAIT "2000" "CLICK" "SKIP"}
{PLAYSND "エデンの桜\Amblygo.ogg" "BGM" "REPEAT" "1000" "0"}
{WAIT "3000" "CLICK" "SKIP"}
{PLAYMOVIE "桜山頂.wmv" "256" "C" "C" "REPEAT" "FALSE" "600" "0"}
<EVENT VALUE="MOTION\r\n789\r\nムービー\r\n11\r\n100\r\n3000\r\nNORMAL\r\nPASS">
{CREATECG "000" "グラフィック\背景\エデン\山頂\桜のじゅうたん.gal" "NORMAL" "#1" "C" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\エデン\糸姫赤\糸姫赤.gal" "NORMAL" "#1" "R" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
<EVENT VALUE="MOTION\r\n789\r\nムービー\r\n11\r\n100\r\n0\r\nNORMAL\r\nPASS">
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>"You're... <STYLE ID="1">Shigatsu Youka</STYLE>...?"
{PAUSE ""}
<BR>
<STYLE ID="1">"</STYLE>Natsumi Kogori-san<STYLE ID="1">, how do you do. My name is Itohime."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Itohime</STYLE><STYLE ID="2">, the girl called herself.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">She might have been 14 or 15.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">A crimson kimono, and a soft, fragile smile.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Chiga-nee</STYLE><STYLE ID="2"> and </STYLE><STYLE ID="4">Sakura-san</STYLE><STYLE ID="2"> were different from her; she was a black-haired girl who fit the words '</STYLE><STYLE ID="5" RUBY="やまとなでしこ">classic Japanese beauty</STYLE><STYLE ID="2">.'</STYLE><PG>
<STYLE ID="2">This girl is </STYLE><STYLE ID="1">Shigatsu Youka</STYLE><STYLE ID="2">...?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">The root of each and every incident...?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Her figure has so little majesty that it throws me, but I mustn't be fooled by appearances.</STYLE><PG>
<STYLE ID="1">"</STYLE>Natsumi Kogori-san<STYLE ID="1">, there is something I have long wanted to give </STYLE>you<STYLE ID="1">."</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\エデン\糸姫赤\糸姫指さし.gal" "NORMAL" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="1">Itohime</STYLE><STYLE ID="2">, still smiling, pointed upward.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">I looked that way, and...</STYLE><PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\エデン\山頂\桜縦長.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1" "1" "3000" "0" "0" "" "0"}
<EVENT VALUE="MOTION\r\n798\r\n000\r\n4\r\n0\r\n5000\r\nDEC\r\nPASS">
{WAIT "5000" "CLICK" "SKIP"}
<EVENT VALUE="MOTION\r\n798\r\n000\r\n4\r\n0\r\n0\r\nDEC\r\nPASS">
{QUAKE "アイテム1" "QUAKE" "1" "30" "30" "0" "1000"}
{CREATECG "アイテム1" "グラフィック\立ち絵\アイテム\エデン\風船.gal" "NORMAL" "#1" "R" "C" "0" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="2">A balloon, caught in a cherry tree.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">There was no wind, yet that balloon alone was swaying back and forth, as if tossed by a breeze.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">That balloon... </STYLE>
{PAUSE ""}
<STYLE ID="2">this scene... </STYLE>
{PAUSE ""}
<STYLE ID="2">somewhere before.</STYLE><PG>
{MESOFF "500"}
{PLAYSND "エデンの桜\SE\心臓の鼓動一発.ogg" "VOICE" "NORMAL" "1000" "0"}
{CHANGECG "000" "グラフィック\背景\罅（ひび）\桜2.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "アイテム1" "14" "500" "0" "0" "" "0"}
{QUAKESTOP "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="6">"Hey, </STYLE><STYLE ID="7">Eiichiro</STYLE><STYLE ID="6">, don't push yourself! Come down!</STYLE><STYLE ID="2"> </STYLE><STYLE ID="6">We can just buy another balloon!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="8">"I may not look it, but I grew up in the mountains of the Arata settlement! Climbing a tree is nothing!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">That's right―this was 12 years ago today, April 8.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">The balloon I was holding slipped out of my hand―</STYLE><PG>
{MESOFF "500"}
{PLAYSND "エデンの桜\SE\心臓の鼓動一発.ogg" "VOICE" "NORMAL" "1000" "0"}
{CHANGECG "000" "グラフィック\背景\エデン\山頂\桜縦長.gal" "NORMAL" "14" "500" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="2">For a moment, a memory that had lain asleep stole my mind away.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">When I came back to myself, the balloon that should have been caught in the tree was gone.</STYLE><PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\エデン\山頂\桜のじゅうたん.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\エデン\糸姫赤\糸姫赤.gal" "NORMAL" "#1" "R" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="1">"I've wanted to return this for so long."</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "アイテム1" "グラフィック\立ち絵\アイテム\エデン\風船.gal" "NORMAL" "#1" "C" "B" "100" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="2">When I turned my eyes to </STYLE><STYLE ID="1">Itohime</STYLE><STYLE ID="2">, a balloon was held in her hand.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Then she smoothly held the balloon out to me.</STYLE><PG>
<STYLE ID="1">"Here. This is </STYLE>yours<STYLE ID="1">, is it not?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Is it fear? Or is it the opposite: has her manner, with nothing frightening in it, simply taken the tension out of me?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">As she urged, I took hold of the balloon's string.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">At that, </STYLE><STYLE ID="1">Itohime</STYLE><STYLE ID="2"> gave an even brighter smile.</STYLE><PG>
{MESOFF "500"}
{DELETECG "アイテム1" "1" "500" "0" "0" "" "0"}
{MESON "500"}
<STYLE ID="1">"Thank goodness. I was finally able to return it."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">As I took the balloon, this was what </STYLE><STYLE ID="1">Itohime</STYLE><STYLE ID="2"> confessed.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">What is she saying? Surely I'm the one who let this fly away.</STYLE><PG>
<STYLE ID="1">"When I tried to bring </STYLE><STYLE ID="8">Eiichiro</STYLE><STYLE ID="1"> over to our side, I needed that balloon no matter what."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">What does that mean? What is she talking about, </STYLE><STYLE ID="1">this girl</STYLE><STYLE ID="2">?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Then </STYLE><STYLE ID="9">Obasan</STYLE><STYLE ID="2"> took a step forward.</STYLE><PG>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\エデン\美冬怒り血.gal" "NORMAL" "#1" "L" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="9">"It can't be...! The one who killed </STYLE><STYLE ID="8">Eiichiro-san</STYLE><STYLE ID="9"> was...!</STYLE>
{PAUSE ""}
<STYLE ID="8">　Eiichiro-san</STYLE><STYLE ID="9"> didn't die in an accident; you mean </STYLE><STYLE ID="1">you</STYLE><STYLE ID="9"> killed him...!?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"</STYLE><STYLE ID="8">Eiichiro</STYLE><STYLE ID="1"> had used what </STYLE><STYLE ID="9">you</STYLE><STYLE ID="1"> call Droga. </STYLE>
{PAUSE ""}
<STYLE ID="8">He</STYLE><STYLE ID="1"> alone met the conditions for my divine messengers."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="9">"</STYLE><STYLE ID="1">You</STYLE><STYLE ID="9">... </STYLE>
{PAUSE ""}
<STYLE ID="1">you</STYLE><STYLE ID="9">!"</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物2" "グラフィック\立ち絵\人物\エデン\美冬ビンタ構え血.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "SE\詫言編　夢から\ビンタ.ogg" "VOICE" "NORMAL" "1000" "0"}
{CHANGECG "人物2" "グラフィック\立ち絵\人物\エデン\美冬ビンタ血.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\エデン\糸姫赤\糸姫赤2.gal" "NORMAL" "14" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="9">Obasan</STYLE><STYLE ID="2"> swung a full-force slap at </STYLE><STYLE ID="1">Itohime</STYLE><STYLE ID="2">.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="9">Obasan's</STYLE><STYLE ID="2"> hand didn't cut empty air; it struck </STYLE><STYLE ID="1">Itohime</STYLE><STYLE ID="2">'s </STYLE><STYLE ID="10" RUBY="ほお">cheek</STYLE><STYLE ID="2"> square, and the crack of the slap rang out.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Itohime</STYLE><STYLE ID="2"> staggered sideways and slowly raised a hand to her </STYLE><STYLE ID="10" RUBY="ほお">cheek</STYLE><STYLE ID="2">.</STYLE><PG>
<STYLE ID="1">"</STYLE><STYLE ID="9">Mifuyu Niimura-san</STYLE><STYLE ID="1">, </STYLE><STYLE ID="11">Haruka Niimura-san</STYLE><STYLE ID="1">, I apologize to you as well. </STYLE>
{PAUSE ""}
<STYLE ID="9">You</STYLE><STYLE ID="1"> two―I took what was precious to you and made it mine."</STYLE>
{PAUSE ""}
<BR>
{CHANGECG "人物2" "グラフィック\立ち絵\人物\エデン\美冬怒り血.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
<STYLE ID="9">"</STYLE><STYLE ID="1">'Mine,'</STYLE><STYLE ID="9"> you say...?</STYLE>
{PAUSE ""}
<STYLE ID="9">　What kind of thing is that to say!"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物3" "グラフィック\立ち絵\人物\春花腕組み.gal" "NORMAL" "#1" "100" "B" "100" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="11">"</STYLE><STYLE ID="9">Mom</STYLE><STYLE ID="11">, stop! Calm down!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">About to lash out again, </STYLE><STYLE ID="9">Obasan</STYLE><STYLE ID="2"> was grabbed by </STYLE><STYLE ID="11">Haruka</STYLE><STYLE ID="2">.</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物2" "グラフィック\立ち絵\人物\エデン\美冬ビンタ構え血.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="9">"</STYLE><STYLE ID="11">Haruka</STYLE><STYLE ID="9">! The one who killed </STYLE><STYLE ID="8">Eiichiro-san</STYLE><STYLE ID="9"> is </STYLE><STYLE ID="1">this girl</STYLE><STYLE ID="9">!?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="11">"W-wait, </STYLE><STYLE ID="9">Mom</STYLE><STYLE ID="11">! Doing something to </STYLE><STYLE ID="1">this thing</STYLE><STYLE ID="11"> right now won't settle anything, will it!?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="9">"Let go of me! Let me give </STYLE><STYLE ID="1">this little brat</STYLE><STYLE ID="9"> one more...!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="11">"Stop it...!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="11">Haruka</STYLE><STYLE ID="2"> and her mother went back and forth, and </STYLE><STYLE ID="1">Itohime</STYLE><STYLE ID="2"> watched them, a hand pressed to her </STYLE><STYLE ID="10" RUBY="ほお">cheek</STYLE><STYLE ID="2">.</STYLE><PG>
<STYLE ID="1">"Of course... You must hate me enough to kill me."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="9">"What do you mean, 'enough to kill'! Anyway, </STYLE><STYLE ID="1">you</STYLE><STYLE ID="9">'re a corpse too, aren't you!?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"No. I am a living human being."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="9">"What...!?"</STYLE>
{PAUSE ""}
<BR>
{CHANGECG "人物1" "グラフィック\立ち絵\人物\エデン\糸姫赤\糸姫赤.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
<STYLE ID="1">"I have lived for several hundred years, borrowing the power of the one </STYLE><STYLE ID="9">you</STYLE><STYLE ID="1"> call Shigatsu Youka."</STYLE><PG>
<STYLE ID="2">She's lived for several hundred years...?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">To look at, she's clearly younger than me.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Her clothes are old-fashioned, but even so, being told she's lived that long is hard to believe.</STYLE><PG>
{MESOFF "500"}
{DELETECG "人物2,人物3" "1" "500" "0" "0" "" "0"}
{MESON "500"}
<STYLE ID="1">"</STYLE><STYLE ID="3">Chigaya-san</STYLE><STYLE ID="1">, </STYLE><STYLE ID="12">Kana-san</STYLE><STYLE ID="1">. I apologize to </STYLE><STYLE ID="3">you</STYLE><STYLE ID="1"> two as well. </STYLE>
{PAUSE ""}
<STYLE ID="4">Sakura</STYLE><STYLE ID="1">―I took her over to our side."</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\茅萱バストアップ.gal" "NORMAL" "#1" "L" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="3">"Mm... The one who killed </STYLE><STYLE ID="4">Mom</STYLE><STYLE ID="3">, the real culprit..."</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物3" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜バストアップ.gal" "NORMAL" "#1" "C" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="12">"Even if you tell us that out of nowhere..."</STYLE><PG>
<STYLE ID="2">For the two sisters, it doesn't seem to have quite sunk in.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Of course, when </STYLE><STYLE ID="1">a girl they've never seen</STYLE><STYLE ID="2"> suddenly appears and confesses, it's no wonder they're bewildered.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="9">Obasan</STYLE><STYLE ID="2">'s </STYLE><STYLE ID="13" RUBY="げきこう">fury</STYLE><STYLE ID="2"> is understandable too, but...</STYLE><PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\エデン\山頂\木見上げ.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1,人物2,人物3" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="2">She must have had a goal she wanted to achieve badly enough to go that far.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Who this </STYLE><STYLE ID="1">Itohime</STYLE><STYLE ID="2"> is, I still don't know, but at the very least, there's no doubt she's nearly equal to the root of it all.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Whether I should ask about it―</STYLE>
{PAUSE ""}
<STYLE ID="2">what I'd even do once I'd heard it―</STYLE>
{PAUSE ""}
<STYLE ID="2">whether we can get out of here―</STYLE>
{PAUSE ""}
<STYLE ID="2">whether we can live in peace in Motoki-cho, like before.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">As time passes, my thoughts are coming back to reality too.</STYLE><PG>
"What is <STYLE ID="1">your</STYLE> purpose? Why would you do this..."
{PAUSE ""}
<BR>
<STYLE ID="1">"My purpose is... </STYLE>
{PAUSE ""}
<STYLE ID="1">to live in Motoki-cho."</STYLE>
{PAUSE ""}
<BR>
"In Motoki-cho...?"
{PAUSE ""}
<BR>
<STYLE ID="1">"Yes. I intend to abandon this land and settle in Motoki-cho."</STYLE>
{PAUSE ""}
<BR>
"Um... 
{PAUSE ""}
If you do that, what happens...?"<PG>
