<SCENARIO VER="105">
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>"Lions are part of the cat family!"
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\なつみ子供.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\五島子供.gal" "WAIT" "#1" "600" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="1">"Ah!"</STYLE><BR>
"Ah!"<BR>
<STYLE ID="2">"Ugh!"</STYLE>
{PLAYSND "ごろごろゲームする日_2.ogg" "BGM" "REPEAT" "1000" "0"}
{PAUSE ""}
<BR>
<STYLE ID="3">This kid is that genius girl...!</STYLE><PG>
<STYLE ID="1">"Ah, </STYLE>Erina-chan<STYLE ID="1">!"</STYLE>
{PAUSE ""}
<BR>
"It's <STYLE ID="1">Natsumi-chan</STYLE>!"
{PAUSE ""}
<BR>
<STYLE ID="3">This is bad! I've got a feeling something bad is going to happen!</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Besides, this is way too much of a coincidence!</STYLE><PG>
{MESOFF "500"}
{DELETECG "人物1" "1" "500" "0" "0" "" "0"}
{MESON "500"}
<STYLE ID="3">Come to think of it, where are </STYLE>this kid<STYLE ID="3">'s parents?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Is she wandering around on her own!?</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\なつみ子供喜び.gal" "WAIT" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="1">"Hey, hey, </STYLE><STYLE ID="2">Dad</STYLE><STYLE ID="1">! I want this!</STYLE>
{PAUSE ""}
<STYLE ID="1">　Buy me and </STYLE>Erina-chan<STYLE ID="1"> </STYLE><STYLE ID="4" RUBY="そろ">matching</STYLE><STYLE ID="1"> ones! One for </STYLE><STYLE ID="5">Haruka-chan</STYLE><STYLE ID="1"> too!"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "アイテム1" "グラフィック\立ち絵\アイテム\ストラップ.gal" "WAIT" "#1" "L" "B" "100" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="1">Natsumi</STYLE><STYLE ID="3"> brought over phone straps from the shop right next to the lion area.</STYLE><PG>
<STYLE ID="3">100 yen each! Okay, I'll give one to </STYLE>this kid<STYLE ID="3"> and politely ask her to leave, quick!</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"Okay, go buy them with this money!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"Yay! Thank you!"</STYLE><PG>
{MESOFF "500"}
{DELETECG "人物1,アイテム1" "1" "500" "0" "0" "" "0"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\五島桃子子供.gal" "WAIT" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="6">"</STYLE>Erina<STYLE ID="6">, I finally found you! You're always wandering off on your own!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Good timing! It's that </STYLE><STYLE ID="6">sister</STYLE><STYLE ID="3"> of hers!</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="6">"Oh! We met at Zahha...!</STYLE>
{PAUSE ""}
<STYLE ID="6">　I'm sorry, </STYLE>this kid<STYLE ID="6">'s been bothering you again... </STYLE>
{PAUSE ""}
<STYLE ID="6">Come on, </STYLE>Erina<STYLE ID="6">, we're going."</STYLE><PG>
<STYLE ID="2">"Ah! Wait a second! Right now my </STYLE><STYLE ID="1">daughter</STYLE><STYLE ID="2">'s gone to buy </STYLE>that kid<STYLE ID="2"> a </STYLE><STYLE ID="7" RUBY="そろ">matching</STYLE><STYLE ID="2"> strap, and she'll be right back, really..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="6">"But we couldn't impose like that."</STYLE><PG>
{MESOFF "500"}
{CREATECG "人物3" "グラフィック\立ち絵\人物\詫言編　始まり以降\なつみ子供.gal" "WAIT" "#1" "C" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="1">"</STYLE>Erina-chan<STYLE ID="1">! These </STYLE><STYLE ID="4" RUBY="そろ">match</STYLE><STYLE ID="1">!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Right on cue, </STYLE><STYLE ID="1">Natsumi</STYLE><STYLE ID="3"> came back and </STYLE><STYLE ID="8">handed a yellow strap to </STYLE>the genius girl<STYLE ID="8">.</STYLE>
{PAUSE ""}
<BR>
"Wow! Thank you, <STYLE ID="1">Natsumi-chan</STYLE>!"<PG>
"Um, old ma... 
{PAUSE ""}
<STYLE ID="2">young man</STYLE>, thank you for the takoyaki treat the other day. Thank you very much!" [TN: takoyaki: fried batter balls with octopus inside]
{PAUSE ""}
<BR>
The little kid<STYLE ID="3"> thanked me with surprising politeness.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="6">"I'm really sorry. Come on, let's go!"</STYLE>
{PAUSE ""}
<BR>
"<STYLE ID="1">Natsumi-chan</STYLE>, bye-byeee!"<PG>
{MESOFF "500"}
{CHANGECG "人物3" "グラフィック\立ち絵\人物\詫言編　始まり以降\なつみ子供喜び.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1,人物2" "1" "500" "0" "0" "" "0"}
{MESON "500"}
<STYLE ID="1">"Bye-byeee!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">I never expected to be thanked that politely.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">What a petty man I am...</STYLE>
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{STOPSND "BGM" "3000" "PASS"}
{MESOFF "500"}
<PG>
{}
