<SCENARIO VER="105">
{PLAYSND "環境音\cicadas.ogg" "SE" "REPEAT" "0" "0"}
{CHGVOL "SE" "1000" "2000" "PASS"}
{PLAYSND "SE\追加分\鍛冶.ogg" "SE2" "REPEAT" "0" "0"}
{CHGVOL "SE2" "1000" "3000" "PASS"}
{WAIT "2000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\リファレンス用\背景\鍛冶.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "2000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
{STOPSND "SE2" "200" "PASS"}
<TXSPN>"Whew... Guess that'll do."
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜手を上げる.gal" "NORMAL" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="1">"</STYLE><STYLE ID="2">Shirozaki-san</STYLE><STYLE ID="1">! Hello!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"Oh, </STYLE><STYLE ID="1">Kana-chan</STYLE><STYLE ID="2">, welcome!"</STYLE><PG>
{PLAYSND "BGM死月編\紅葉のダンス.ogg" "BGM" "REPEAT" "1000" "0"}
<STYLE ID="1">"Wow, what a fine nata! That's Arata's Living National Treasure, </STYLE><STYLE ID="2">Shirozaki-san</STYLE><STYLE ID="1">, for you!"</STYLE>
{PAUSE ""}
<BR>
"Hah hah hah! The Shirozaki family has made tools for generations. And I'm every bit as good as my ancestors!
{PAUSE ""}
　Oh, right, right, I've got something to give <STYLE ID="1">you</STYLE>."<PG>
{MESOFF "500"}
{CREATECG "アイテム1" "グラフィック\立ち絵\アイテム\ナイフ.gal" "NORMAL" "#1" "300" "B" "100" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "アイテム2" "グラフィック\立ち絵\アイテム\ナイフ.gal" "NORMAL" "#1" "350" "B" "100" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
"Here, happy birthday!"
{PAUSE ""}
<BR>
<STYLE ID="1">"Yaaay! Thank you, </STYLE><STYLE ID="2">Shirozaki-san</STYLE><STYLE ID="1">! Now I can do some real hunting too!"</STYLE>
{PAUSE ""}
<BR>
"Hunting with a knife... is that <STYLE ID="3">Chigaya-chan</STYLE>'s influence?"
{PAUSE ""}
<BR>
<STYLE ID="1">"Yeah! </STYLE><STYLE ID="3">My big sister</STYLE><STYLE ID="1">'s knife work is so cool!</STYLE>
{PAUSE ""}
<STYLE ID="1">　Being able to handle a nata and a mace matters too, but you really need something easy to carry around like this."</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜バストアップ.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "アイテム1,アイテム2" "1" "500" "0" "0" "" "0"}
{MESON "500"}
<STYLE ID="1">"Come to think of it, </STYLE><STYLE ID="2">you</STYLE><STYLE ID="1">'re always making nata and maces, right? What do you do with so many of them?"</STYLE>
{PAUSE ""}
<BR>
"Ah, these I sell to people on the outside. The ones I make get bought as top-of-the-line pieces. 
{PAUSE ""}
Well, you could say I'm the one holding up Arata's finances! Hah hah hah!"
{PAUSE ""}
<BR>
<STYLE ID="1">"Whoa! </STYLE><STYLE ID="2">Shirozaki-san</STYLE><STYLE ID="1">, you're not just a drunk after all!"</STYLE><PG>
"A drink after work tastes goood! When <STYLE ID="1">you</STYLE>'re grown up, have a drink with me too, okay!"
{PAUSE ""}
<BR>
{CHANGECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜手を上げるバストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
<STYLE ID="1">"Ahaha! Then have some good drinks ready for my 20th birthday!</STYLE>
{PAUSE ""}
<STYLE ID="1">　I'll use this knife to hunt up the makings of some good snacks to go with them!"</STYLE>
{PAUSE ""}
<BR>
"I'm looking forward to it already."
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{MESOFF "500"}
{STOPSND "BGM" "3000" "PASS"}
{STOPSND "SE" "3000" "PASS"}
{DELETECG "000,人物1" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
<PG>
{}
<EVENT VALUE="MESEND">
;---------------------------------------
; END DECOMPILED SCRIPT
;---------------------------------------