{CREATECG "000" "グラフィック\背景\詫言編　夢から\新村本家玄関.gal" "NORMAL" "#1" "C" "B" "0" "4" "2000" "960" "1" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="5">"Uh, I'm back."</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{PLAYSND "SE\室内歩き.ogg" "VOICE" "NORMAL" "1000" "0"}
