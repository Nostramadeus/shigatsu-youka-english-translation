;---------------------------------------
; BEGIN DECOMPILED SCRIPT
;---------------------------------------
<SCENARIO VER="105">
{PLAYSND "BGM死月編\惑星宝石箱.ogg" "BGM" "REPEAT" "1000" "0"}
{WAIT "2000" "CLICK" "SKIP"}
{PLAYSND "SE\カーテン.ogg" "VOICE" "NORMAL" "1000" "0"}
{CREATECG "000" "グラフィック\背景\服屋.gal" "NORMAL" "#1" "C" "B" "0" "4" "1000" "960" "1" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>"How's this?!"
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\なつみ考えるバストアップ.gal" "NORMAL" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="1">"Hmm..."</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\五島考えるバストアップ.gal" "NORMAL" "#1" "L" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="2">"Same as always, huh..."</STYLE><PG>
"Well, yeah, this is always my style. A hoodie that's easy to move in and shorts are plenty, right?"
{PAUSE ""}
<BR>
<STYLE ID="1">"Hmm..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"It'd be nice to see a bit more change, or something along those lines... </STYLE>
{PAUSE ""}
<STYLE ID="2">Actually, do </STYLE>you<STYLE ID="2"> even own a skirt?"</STYLE><PG>
"A skirt? Nope, not in my own clothes, not for about ten years now."
{PAUSE ""}
<BR>
<STYLE ID="2">"Does it have anything to do with how </STYLE>you<STYLE ID="2"> talk like a guy?"</STYLE>
{PAUSE ""}
<BR>
"<STYLE ID="2">You</STYLE>... that's a tactless thing to ask..."
{PAUSE ""}
<BR>
<STYLE ID="1">"But </STYLE>you<STYLE ID="1"> used to wear dresses and stuff and had long hair, right?"</STYLE><PG>
"Ah, well, yeah, that's true. But how do I put it... 
{PAUSE ""}
See, back in Megasawa I was weak in all sorts of ways, so I wanted to get even a little stronger, I guess."
{PAUSE ""}
<BR>
<STYLE ID="2">"So that's why the guy-like talk and clothes?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"</STYLE>Haruka<STYLE ID="1">, I don't think that's the same as being strong..."</STYLE><PG>
"Hey, what's the big deal? It's my style, so it's fine, isn't it..."
{PAUSE ""}
<BR>
<STYLE ID="2">"You're tall and you've got a nice figure, so I think there are clothes that would suit you better, you know?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"Yeah, shorts and a hoodie don't have much sex appeal..."</STYLE>
{PAUSE ""}
<BR>
"I don't need any sex appeal anyway..."<PG>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\なつみ腰に手バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="1">"No! It's about time you got more girly! You're 17 already, aren't you?!"</STYLE>
{PAUSE ""}
<BR>
{CHANGECG "人物2" "グラフィック\立ち絵\人物\五島怒りバストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
<STYLE ID="2">"Time to graduate from acting tough with just your looks and the way you talk! Truly strong people shine from the inside!"</STYLE>
{PAUSE ""}
<BR>
"How did this turn into a project to make me over... 
{PAUSE ""}
Even so, I can't just change the way I talk all of a sudden, and I'm not wearing some frilly dress..."<PG>
<STYLE ID="1">"All right, </STYLE>Haruka<STYLE ID="1">! Look forward to this Christmas! I'll give </STYLE>you<STYLE ID="1"> the outfit that suits you best!"</STYLE>
{PAUSE ""}
<BR>
{CHANGECG "人物2" "グラフィック\立ち絵\人物\五島挨拶バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
<STYLE ID="2">"Ha! That's a great idea! Leave it to </STYLE><STYLE ID="1">Kogori-senpai</STYLE><STYLE ID="2">!</STYLE>
{PAUSE ""}
<STYLE ID="2">　Hey, hey, what are you giving me for Christmas?!"</STYLE>
{PAUSE ""}
<BR>
{CHANGECG "人物1" "グラフィック\立ち絵\人物\なつみバストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
<STYLE ID="1">"For </STYLE><STYLE ID="2">you</STYLE><STYLE ID="1">, I was thinking of Zahha's Christmas tower parfait?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"Ooh...! As expected of </STYLE><STYLE ID="1">Kogori-senpai</STYLE><STYLE ID="2">, you know me so well...!"</STYLE><PG>
{MESOFF "500"}
{DELETECG "000,人物1,人物2" "1" "1000" "0" "0" "" "0"}
{MESON "500"}
"Hmm, this got troublesome... 
{PAUSE ""}
Well, I guess I'll leave it to <STYLE ID="1">Natsumi</STYLE>. It shouldn't turn out badly..."
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{MESOFF "500"}
{STOPSND "BGM" "3000" "PASS"}
{WAIT "3000" "CLICK" "SKIP"}
<PG>
{}
<EVENT VALUE="MESEND">
