{MESON "500"}
<STYLE ID="1">Right away, </STYLE><STYLE ID="12" RUBY="かな">Kana</STYLE><STYLE ID="13">-chan</STYLE><STYLE ID="1"> ran over to </STYLE><STYLE ID="5">Goto</STYLE><STYLE ID="1">.</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物4" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜手を上げる.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="13">"Nice to meet you, nice to meet you! I'm </STYLE><STYLE ID="6">Haruka-chan</STYLE><STYLE ID="13">'s cousin, </STYLE><STYLE ID="12" RUBY="かな">Kana</STYLE><STYLE ID="13"> Niimura!</STYLE>
{PAUSE ""}
<STYLE ID="13">　I'm </STYLE><STYLE ID="15">Chigaya Niimura</STYLE><STYLE ID="13">'s little sister, </STYLE><STYLE ID="12" RUBY="かな">Kana</STYLE><STYLE ID="13"> Niimura!</STYLE>
{PAUSE ""}
<STYLE ID="13">　I'm </STYLE><STYLE ID="10">Kotaro</STYLE><STYLE ID="9" RUBY="こうたろう"> Niimura</STYLE><STYLE ID="13">'s second daughter, </STYLE><STYLE ID="12" RUBY="かな">Kana</STYLE><STYLE ID="13"> Niimura!</STYLE>
{PAUSE ""}
<STYLE ID="13">　I'm </STYLE><STYLE ID="8">Eiichiro Niimura-san</STYLE><STYLE ID="13">'s </STYLE><STYLE ID="16" RUBY="めい">niece</STYLE><STYLE ID="13">, </STYLE><STYLE ID="12" RUBY="かな">Kana</STYLE><STYLE ID="13"> Niimura!</STYLE>
