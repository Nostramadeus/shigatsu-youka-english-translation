<SCENARIO VER="105">
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "togisuma.ogg" "BGM" "REPEAT" "1000" "0"}
{WAIT "3000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\背景\ザッハ中.gal" "NORMAL" "#1" "C" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\春花腕組み.gal" "WAIT" "#1" "R" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "100" "CLICK" "SKIP"}
<TXSPN>"Won't you help too, <STYLE ID="1">Niimura-senpai</STYLE>?"
{PAUSE ""}
<BR>
<STYLE ID="2">I know I'm asking for something outrageous.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"But, that kind of thing is for the police... </STYLE>
{PAUSE ""}
<STYLE ID="1">Besides, you'll definitely end up in danger. </STYLE>
{PAUSE ""}
<STYLE ID="1">The killer's mind isn't normal. </STYLE>
{PAUSE ""}
<STYLE ID="1">'Cause if it's the killer from the Megasawa City case..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Senpai</STYLE><STYLE ID="2"> was trying her best to break my resolve.</STYLE><PG>
<STYLE ID="2">It probably is dangerous, true.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">But... no matter what, I want to do something for her.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">With the help of the one who cares about </STYLE><STYLE ID="3">Kogori-senpai</STYLE><STYLE ID="2"> just as I do, </STYLE><STYLE ID="1">Niimura-senpai</STYLE><STYLE ID="2">, I would feel very reassured.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Should I try asking </STYLE><STYLE ID="1">Senpai</STYLE><STYLE ID="2"> one more time?</STYLE>
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{}
<EVENT VALUE="MESEND">
;---------------------------------------
; END DECOMPILED SCRIPT
