<STYLE ID="2">Across from this house! </STYLE>
{PAUSE ""}
<STYLE ID="2">　Ahahahaha! </STYLE><STYLE ID="12" RUBY="よば">A midnight</STYLE><STYLE ID="2"> seduction? </STYLE><STYLE ID="12" RUBY="よば">A midnight</STYLE><STYLE ID="2"> seduction? </STYLE>
