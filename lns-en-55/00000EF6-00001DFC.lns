{PAUSE ""}
<BR>
<STYLE ID="6"><TXSPN>"Ha... </STYLE><STYLE ID="1">Haruka</STYLE><STYLE ID="6">!? </STYLE><STYLE ID="1">Haruka</STYLE><STYLE ID="6">!? </STYLE>
{PAUSE ""}
<STYLE ID="6">　Did you talk!? Are you awake!?"</STYLE><PG>
