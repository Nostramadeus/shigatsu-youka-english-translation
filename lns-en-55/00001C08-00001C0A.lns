{STOPSND "VOICE" "5000" "PASS"}
{DELETECG "人物1,人物2" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="2">"</STYLE><STYLE ID="1">Sakura</STYLE><STYLE ID="2">..."</STYLE>
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
