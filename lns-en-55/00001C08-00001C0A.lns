{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>"No one will come here."
{PAUSE ""}
<BR>
<STYLE ID="1">"............"</STYLE>
{PAUSE ""}
<BR>
"Come on, <STYLE ID="1">Sakura</STYLE>. Come here."
{PAUSE ""}
<BR>
<STYLE ID="1">"............"</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\詫言編　夢から\砂利を歩く2人.ogg" "VOICE" "NORMAL" "1000" "0"}
{CHGVOL "VOICE" "500" "5000" "PASS"}
{WAIT "5000" "CLICK" "SKIP"}
{STOPSND "VOICE" "500" "PASS"}
{MESON "500"}
"Are you okay? Does it hurt?"
{PAUSE ""}
<BR>
<STYLE ID="1">"I'm fine..."</STYLE>
{PAUSE ""}
<BR>
"Here, let me see your other hand too. We have to treat it properly."
{PAUSE ""}
<BR>
<STYLE ID="1">"Sorry..."</STYLE>
{PAUSE ""}
<BR>
"No, I'm the one who's sorry... For not being able to do anything..."<PG>
<STYLE ID="1">"No, </STYLE>you<STYLE ID="1">'re here with me. </STYLE>
{PAUSE ""}
<STYLE ID="1">That alone makes me happy."</STYLE>
{PAUSE ""}
<BR>
"That's no good...!
{PAUSE ""}
　<STYLE ID="2">My brother</STYLE>, in <STYLE ID="2">his</STYLE> own way, is desperately trying to protect <STYLE ID="1">you</STYLE>, but I can't do a thing...!
{PAUSE ""}
　Uuu...!"
{PAUSE ""}
<BR>
<STYLE ID="1">"Don't cry, </STYLE>Eiichiro<STYLE ID="1">. </STYLE>
{PAUSE ""}
You<STYLE ID="1"> being sad is harder for me than anything..."</STYLE><PG>
"Uuu... I'm sorry..."
{PAUSE ""}
<BR>
<STYLE ID="1">"Come on, let's go home now. </STYLE><STYLE ID="2">Kotaro</STYLE><STYLE ID="1"> should be getting back about now, right?"</STYLE>
{PAUSE ""}
<BR>
"Yeah..."
{PAUSE ""}
<BR>
<STYLE ID="1">"Hey, </STYLE>Eiichiro<STYLE ID="1">..."</STYLE>
{PAUSE ""}
<BR>
"Hm?"<PG>
<STYLE ID="1">"Are you kind to me because I'm like this?"</STYLE>
{PAUSE ""}
<BR>
"............"
{PAUSE ""}
<BR>
<STYLE ID="1">"If I stopped being like this―"</STYLE>
{PAUSE ""}
<BR>
"I'll always be on <STYLE ID="1">your</STYLE> side. No matter what."
{PAUSE ""}
<BR>
<STYLE ID="1">"Okay, thank you. That makes me happy."</STYLE><PG>
"Come on, let's go home. Can you walk? Want to lean on my shoulder?"
{PAUSE ""}
<BR>
<STYLE ID="1">"I'm fine. </STYLE>
{PAUSE ""}
<STYLE ID="1">No... actually, I'd like to lean on your shoulder."</STYLE>
{PAUSE ""}
<BR>
"Sure, hold on to me."<PG>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\サクラ\サクラ栄一郎.gal" "NORMAL" "#1" "R" "B" "0" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
