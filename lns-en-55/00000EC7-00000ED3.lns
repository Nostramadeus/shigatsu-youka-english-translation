<STYLE ID="3">"It's </STYLE><STYLE ID="4">my mom</STYLE><STYLE ID="3">. </STYLE>
{PAUSE ""}
<STYLE ID="3">Hello? What's up?</STYLE>
{PAUSE ""}
<STYLE ID="3">　Uh-huh... </STYLE>
{PAUSE ""}
<STYLE ID="3">Uh-huh... </STYLE>
{PAUSE ""}
