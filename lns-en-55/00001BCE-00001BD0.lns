{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="1">"Um, </STYLE><STYLE ID="3">Sis</STYLE><STYLE ID="1">..."</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
