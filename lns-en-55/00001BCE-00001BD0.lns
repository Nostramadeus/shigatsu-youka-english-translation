{QUAKE "人物1" "QUAKE" "1" "50" "0" "0" "2000"}
{MESON "500"}
<STYLE ID="3">"Ah, </STYLE><STYLE ID="1">Kana</STYLE><STYLE ID="3">aa! Where'd you go, leaving all this great food sitting here?!</STYLE>
{PAUSE ""}
<STYLE ID="3">　I'm gonna eat it all myself-f!"</STYLE>
{PAUSE ""}
<BR>
{PLAYSND "BGM死月編\Bad_Luck.ogg" "BGM" "REPEAT" "1000" "0"}
<STYLE ID="8">"Nice, nice! </STYLE><STYLE ID="3">Chigaya-chan</STYLE><STYLE ID="8">... </STYLE>
{PAUSE ""}
<STYLE ID="3">Chigaya-tan</STYLE><STYLE ID="8"> can </STYLE><STYLE ID="9" RUBY="にょ">dwink</STYLE><STYLE ID="8"> this much!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Ahahahaha! </STYLE><STYLE ID="10" RUBY="しろざき">Shirozaki</STYLE><STYLE ID="11">, you old guy</STYLE><STYLE ID="3">, you're slurring your wooords!"</STYLE>
{PAUSE ""}
