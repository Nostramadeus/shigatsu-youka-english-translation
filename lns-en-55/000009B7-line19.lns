{PLAYSND "SE\詫言編　夢から\すぐ後ろだよ.ogg" "VOICE" "NORMAL" "1000" "0"}
{MESON "500"}
<STYLE ID="12">"Kyaa, no!"</STYLE><BR>
<STYLE ID="8">"I'm sorry, I'm sorry!"</STYLE><BR>
<STYLE ID="10">"No no no no no"</STYLE><BR>
<STYLE ID="11">"This is bad news! Bad news! Bad news!"</STYLE><PG>
{CREATECG "000" "グラフィック\背景\詫言編　夢から\新村本家居間暗い.gal" "NORMAL" "#1" "C" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "アイテム2" "グラフィック\立ち絵\アイテム\ろうそくの明かり.gal" "NORMAL" "#1" "C" "B" "100" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
