<SCENARIO VER="105">
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "100" "CLICK" "SKIP"}
<TXSPN>"Please! <STYLE ID="1">Senpai</STYLE>... <STYLE ID="1">the person who's precious to me</STYLE>... please don't abandon her...!"
{PAUSE ""}
<BR>
<STYLE ID="2">Along with those overblown words, I put my hands and forehead down on the table.</STYLE><PG>
<STYLE ID="2">As expected, </STYLE><STYLE ID="3">Senpai</STYLE><STYLE ID="2"> seemed troubled, but even so, I tried to push my selfish request through.</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\春花バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="3">"............ </STYLE>
{PAUSE ""}
<STYLE ID="3">Okay. If </STYLE>Goto<STYLE ID="3">'s gonna go that far, I've got no choice. I'll help!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">She turned a smile on me that looked a little </STYLE><STYLE ID="4" RUBY="あき">exasperated</STYLE><STYLE ID="2">.</STYLE>
{PAUSE ""}
<BR>
"Thank you! That's so reassuring."
{PAUSE ""}
<BR>
<STYLE ID="2">I wasn't in the mood to grin from ear to ear, but I thanked her as best I could.</STYLE>
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{}
<EVENT VALUE="MESEND">
