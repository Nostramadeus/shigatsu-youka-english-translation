{CREATECG "人物1" "グラフィック\立ち絵\人物\五島挨拶.gal" "NORMAL" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="4">"Sorry to intrude!"</STYLE>
{PAUSE ""}
<BR>
