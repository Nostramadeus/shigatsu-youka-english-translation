;    4: TDecorate(count=3980, unk2=65535, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    5: TDecorate(count=1, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=な, unk10=4294967295, unk11=4294967295)
;    6: TDecorate(count=9, unk2=16757864, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    7: TDecorate(count=4, unk2=11271932, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    8: TDecorate(count=3, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=ふところ, unk10=4294967295, unk11=4294967295)
;    9: TDecorate(count=1, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=おび, unk10=4294967295, unk11=4294967295)
;   10: TDecorate(count=2, unk2=65535, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=しれつ, unk10=4294967295, unk11=4294967295)
;   11: TDecorate(count=1, unk2=65535, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=おび, unk10=4294967295, unk11=4294967295)
;   12: TDecorate(count=1, unk2=65535, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=もだ, unk10=4294967295, unk11=4294967295)
;   13: TDecorate(count=3, unk2=65535, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=おきて, unk10=4294967295, unk11=4294967295)
;   14: TDecorate(count=10, unk2=8388863, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
; Display conditions:
;    0: TWdCondition(count=6548, target=)
; Links:
;    0: TWdLink(count=5998, event=, unk3=)
;---------------------------------------
; BEGIN DECOMPILED SCRIPT
;---------------------------------------
<SCENARIO VER="105">
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "最後の声・真呪殺\z50.ogg" "BGM" "REPEAT" "1000" "0"}
{WAIT "2000" "CLICK" "SKIP"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\なつみ倒れる.gal" "NORMAL" "#1" "R" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>"H-hey... <STYLE ID="1">Natsumi</STYLE>..."
{PAUSE ""}
<BR>
<STYLE ID="1">Natsumi</STYLE><STYLE ID="2"> gets a little poke in the arm from me.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">But there's no reaction.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">She went down from the smoke earlier too, so if her body has really </STYLE><STYLE ID="3" RUBY="きた">taken</STYLE><STYLE ID="2"> a bad turn, I can't just leave her like this, but...</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島バストアップ.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "000" "グラフィック\背景\詫言編　夢から\秘密基地内部.gal" "NORMAL" "#1" "C" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
"<STYLE ID="4">Goto</STYLE>, I'm gonna check outside. <STYLE ID="4">You</STYLE> keep an eye on <STYLE ID="1">Natsumi</STYLE>."
{PAUSE ""}
<BR>
<STYLE ID="4">"Huh!? But..."</STYLE>
{PAUSE ""}
<BR>
"It's fine, I'll be back in a minute."
{PAUSE ""}
<BR>
<STYLE ID="2">I force a command into legs heavy with exhaustion, put a hand to the rock wall, and stand up.</STYLE><PG>
<STYLE ID="4">"</STYLE>Senpai<STYLE ID="4">... hurry back...!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">I give </STYLE><STYLE ID="4">Goto</STYLE><STYLE ID="2">, still sitting there, a quick </STYLE><STYLE ID="5" RUBY="な">pat</STYLE><STYLE ID="2"> on the head and make for the mouth of the cave.</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\歩く響く.ogg" "SE" "REPEAT" "1000" "0"}
{DELETECG "人物1,000" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\背景\詫言編　夢から\秘密基地入口.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{STOPSND "SE" "500" "PASS"}
{WAIT "1000" "CLICK" "SKIP"}
{CHANGECG "000" "グラフィック\背景\最後の声から\星空.gal" "NORMAL" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="2">―The clouds have cleared completely, and the stars are out.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">And to sense any presence around me, I sharpen all five senses.</STYLE><PG>
<STYLE ID="2">Sight―</STYLE>
{PAUSE ""}
<STYLE ID="2">not to miss the slightest movement.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Hearing―</STYLE>
{PAUSE ""}
<STYLE ID="2">not to miss the faintest sound.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Smell―</STYLE>
{PAUSE ""}
<STYLE ID="2">alert to even the faintest strange odor.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Taste―</STYLE>
{PAUSE ""}
<STYLE ID="2">opening my mouth slightly to probe what's in the air.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Touch―</STYLE>
{PAUSE ""}
<STYLE ID="2">watching especially for any change in temperature.</STYLE><PG>
<STYLE ID="2">............ </STYLE>
{PAUSE ""}
<STYLE ID="2">Someone's there.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Someone is watching me.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Who is it...!?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">There's only one presence.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="6">Chiga-nee</STYLE><STYLE ID="2">!? </STYLE><STYLE ID="7">Kana</STYLE><STYLE ID="2">!?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Or―</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\砂利を歩く.ogg" "VOICE" "REPEAT" "500" "0"}
{CHGVOL "VOICE" "1000" "5000" "WAIT"}
{CHANGECG "000" "グラフィック\背景\詫言編　夢から\秘密基地入口.gal" "NORMAL" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\死神\般若全身.gal" "NORMAL" "#1" "R" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{STOPSND "VOICE" "500" "PASS"}
{MESON "500"}
<STYLE ID="2">It's the White Hannya...!</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Was this thing watching me the whole time?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">It knows we were hiding here, too.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">So this thing is on our side after all...?</STYLE><PG>
"Who are you...?"
{PAUSE ""}
<BR>
<STYLE ID="2">If this thing is an enemy, there's no way I can stand up to moves like that.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">So I deliberately put my knife away to show I'm not hostile.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Will it show some kind of reaction?</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\swish.ogg" "VOICE" "NORMAL" "1000" "0"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\死神\般若バストアップ.gal" "NORMAL" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="2">Then the White Hannya takes something out from </STYLE><STYLE ID="8" RUBY="ふところ">inside its robe</STYLE><STYLE ID="2">.</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "アイテム1" "グラフィック\立ち絵\アイテム\女神\本.gal" "NORMAL" "#1" "650" "B" "100" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="2">An old book...?</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
<EVENT VALUE="MOTION\r\n789\r\nアイテム1\r\n4\r\n540\r\n200\r\nINC\r\nPASS">
{WAIT "500" "CLICK" "SKIP"}
<EVENT VALUE="MOTION\r\n789\r\nアイテム1\r\n4\r\n540\r\n0\r\nINC\r\nPASS">
{PLAYSND "最後の声・真呪殺\SE\草の上に落とす.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAITPLAY "VOICE" "CLICK"}
{WAIT "500" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="2">Then it sets the book down at its feet―</STYLE>
{PAUSE ""}
{MESOFF "500"}
{DELETECG "人物1" "1" "1000" "0" "0" "" "0"}
{MESON "500"}
<STYLE ID="2">and vanishes into the forest again like the wind.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">This time, every sense of anyone nearby is truly gone.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">There's nobody around, which means it's safe.</STYLE><PG>
<STYLE ID="2">I pick up the book the White Hannya left behind.</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
<EVENT VALUE="MOTION\r\n789\r\nアイテム1\r\n4\r\n200\r\n2000\r\nDEC\r\nPASS">
{WAIT "2000" "CLICK" "SKIP"}
<EVENT VALUE="MOTION\r\n789\r\nアイテム1\r\n4\r\n200\r\n0\r\nDEC\r\nPASS">
{MESON "500"}
<STYLE ID="2">It's dark and hard to see, but it seems to be written in an old style.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">Goto</STYLE><STYLE ID="2"> might be able to read it.</STYLE><PG>
{MESOFF "500"}
{DELETECG "000,アイテム1" "1" "1000" "0" "0" "" "0"}
{PLAYSND "SE\歩く響く.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAIT "3000" "CLICK" "SKIP"}
{PLAYSND "最後の声・真呪殺\SE\五島泣き声.ogg" "VOICE2" "REPEAT" "1000" "0"}
{WAIT "4000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="2">............?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">From deep inside comes </STYLE><STYLE ID="4">Goto</STYLE><STYLE ID="2">'s crying...</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Crying as if she's stifling her voice, and yet so </STYLE><STYLE ID="9" RUBY="おび">frightened</STYLE><STYLE ID="2"> she can't bear it.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">What happened?</STYLE><PG>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\五島うつむき.gal" "NORMAL" "#1" "R" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "000" "グラフィック\背景\詫言編　夢から\秘密基地内部.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{STOPSND "VOICE" "500" "PASS"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">"Uuh... uh... uh..."</STYLE>
{PAUSE ""}
<BR>
"Hey, <STYLE ID="4">Goto</STYLE>, what's wrong?"
{PAUSE ""}
<BR>
<STYLE ID="2">From what I can see, neither </STYLE><STYLE ID="4">Goto</STYLE><STYLE ID="2"> nor </STYLE><STYLE ID="1">Natsumi</STYLE><STYLE ID="2"> looks any different...</STYLE><PG>
{STOPSND "VOICE2" "500" "PASS"}
<STYLE ID="4">"</STYLE>Senpai<STYLE ID="4">... you idiot..."</STYLE>
{PAUSE ""}
<BR>
"Huh?"
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島怒りバストアップ.gal" "NORMAL" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="4">"Please don't leave me alone again...! I was scared..."</STYLE>
{PAUSE ""}
<BR>
"R-right, sorry..."
{PAUSE ""}
<BR>
<STYLE ID="2">Looks like she was just crying because she was scared.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">I go right over to </STYLE><STYLE ID="4">Goto</STYLE><STYLE ID="2"> and pull her head into a hug.</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
"Geez, you idiot... 
{PAUSE ""}
If you knew it was dangerous here, you should've stayed in Motoki-cho..."
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\なつみ倒れる.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "000" "1" "1000" "0" "0" "" "0"}
{MESON "500"}
<STYLE ID="4">"</STYLE><STYLE ID="1">Kogori-senpai</STYLE><STYLE ID="4">―I couldn't let her go alone..."</STYLE>
{PAUSE ""}
<BR>
"Well, that's true... 
{PAUSE ""}
With nerves of steel like <STYLE ID="1">this one</STYLE>'s, there's no telling what reckless thing she'd do..."
{PAUSE ""}
<BR>
<STYLE ID="2">I look over at </STYLE><STYLE ID="1">Natsumi</STYLE><STYLE ID="2">, who still shows no sign of waking up.</STYLE><PG>
"Oh right, <STYLE ID="4">Goto</STYLE>, can you read this? It looks like an old book..."
{PAUSE ""}
<BR>
<STYLE ID="4">Goto</STYLE><STYLE ID="2"> wipes her tears as she takes the book, and turns on her phone's light.</STYLE><PG>
{PLAYSND "SE\紙ペラ.ogg" "VOICE" "NORMAL" "1000" "0"}
{MESOFF "500"}
{DELETECG "人物1" "1" "1000" "0" "0" "" "0"}
{MESON "500"}
<STYLE ID="2">For a while </STYLE><STYLE ID="4">Goto</STYLE><STYLE ID="2"> is absorbed in the book, and everything goes quiet.</STYLE>
{PAUSE ""}
<BR>
{PLAYSND "SE\紙ペラ.ogg" "VOICE" "NORMAL" "1000" "0"}
<STYLE ID="4">Goto</STYLE><STYLE ID="2">'s page-turning is the only sound echoing through the cave.</STYLE><PG>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\五島うつむき.gal" "NORMAL" "#1" "R" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "000" "グラフィック\背景\詫言編　夢から\秘密基地内部.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">"</STYLE>Senpai<STYLE ID="4">, where did you find this book?"</STYLE>
{PAUSE ""}
<BR>
"It was the White Hannya from before. 
{PAUSE ""}
I ran into it outside the cave, and it left this behind."
{PAUSE ""}
<BR>
<STYLE ID="4">"The White Hannya... I see..."</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島バストアップ.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "アイテム1" "グラフィック\立ち絵\アイテム\女神\本.gal" "NORMAL" "#1" "650" "B" "100" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="2">Then </STYLE><STYLE ID="4">Goto</STYLE><STYLE ID="2"> shows me the book's cover.</STYLE><PG>
{STOPSND "BGM" "3000" "PASS"}
<STYLE ID="4">"This book is about the Goddess Verde."</STYLE>
{PAUSE ""}
<BR>
"R-really!? Can you read all of it!?"
{PAUSE ""}
<BR>
<STYLE ID="4">"Hmm, it's a little sloppy, and some parts don't fit together..."</STYLE><PG>
{MESOFF "500"}
{DELETECG "人物1,000,アイテム1" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "太古の暗い鳴動.ogg" "BGM" "REPEAT" "1000" "0"}
{WAIT "3000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\背景\荒田集落イメージ.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">"The Goddess Verde appears to have been a girl who was born in Shiyo 352―450 years ago―and died at 14. </STYLE>
{PAUSE ""}
<STYLE ID="4">They say she took her own life to protect this Arata settlement―"</STYLE>
{PAUSE ""}
<BR>
"Yeah, I heard that from <STYLE ID="6">Chiga-nee</STYLE>."<PG>
<STYLE ID="4">"The girl who came to be called Verde after her death―</STYLE>
{PAUSE ""}
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\真呪殺\女神\トミ.gal" "NORMAL" "#1" "R" "B" "0" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">in life, she was called 'Tomi,' it seems. </STYLE>
{PAUSE ""}
<STYLE ID="4">Apparently there were no class differences in the Arata settlement, and she was a perfectly ordinary girl, but―</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{PLAYSND "SE\怖い効果音.ogg" "VOICE" "NORMAL" "1000" "0"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\真呪殺\女神\トミ緑.gal" "NORMAL" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">Tomi was born with one green eye, they say. </STYLE>
{PAUSE ""}
<STYLE ID="4">But her parents were pure Yamato Japanese with no foreign blood."</STYLE><PG>
"Born to pure Japanese parents, and one eye was green...?"
{PAUSE ""}
<BR>
<STYLE ID="4">"That's right. Tomi was treated as a great rarity and raised with care, it says. </STYLE>
{PAUSE ""}
<STYLE ID="4">But then one day, something happens."</STYLE><PG>
{MESOFF "500"}
{CHANGECG "000" "$0000FF" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1" "33" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">"Suddenly, a resident of the Arata settlement whose eyes had turned green appeared and began massacring people, it says."</STYLE>
{PAUSE ""}
<BR>
"A massacre!? Did Tomi do it!?"
{PAUSE ""}
<BR>
<STYLE ID="4">"No, the one whose eyes turned green and carried out the massacre was apparently an adult woman, not Tomi. </STYLE>
{PAUSE ""}
<STYLE ID="4">And strictly speaking, it wasn't a massacre. It seems she tried, alone, to kill every last one of the residents, as if she'd gone mad."</STYLE><PG>
<STYLE ID="4">"But since she was a woman, and she only used weapons like sickles and hoes, she was quickly subdued."</STYLE>
{PAUSE ""}
<BR>
"What the heck... 
{PAUSE ""}
So a woman whose eyes turned green started killing people, right?"<PG>
<STYLE ID="4">"Yes. And her symptoms never subsided, and she died in a frenzy. </STYLE>
{PAUSE ""}
<STYLE ID="4">What the residents did next was―</STYLE>
{PAUSE ""}
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\女神\キリスト教.gal" "NORMAL" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">to suspect the Westerners who had settled there a few decades earlier, and their descendants. </STYLE>
{PAUSE ""}
<STYLE ID="4">Hadn't the residents' eyes turned green because they'd taken in the blue-eyed foreigners? </STYLE>
{PAUSE ""}
<STYLE ID="4">And hadn't Tomi, too, been born with a green eye through some influence of theirs? </STYLE>
{PAUSE ""}
<STYLE ID="4">Hadn't the Arata settlement been cursed by the Westerners?"</STYLE><PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\スチル\戦.gal" "NORMAL" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{PLAYSND "最後の声・真呪殺\SE\戦.ogg" "SE" "NORMAL" "1000" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">"And so for several days, a civil war raged between Arata's original settlers and the Westerners. </STYLE>
{PAUSE ""}
<STYLE ID="4">This happened in April of Shiyo 340. </STYLE>
{PAUSE ""}
<STYLE ID="4">They say it was a war fought using Droga, which had been developed in the Arata settlement a few decades before, and it was </STYLE><STYLE ID="10" RUBY="しれつ">savage</STYLE><STYLE ID="4">. </STYLE>
{PAUSE ""}
<STYLE ID="4">But the really terrible part comes next."</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\sceneswitch2.ogg" "VOICE" "NORMAL" "1000" "0"}
{CHANGECG "000" "グラフィック\背景\スチル\戦転調.gal" "NORMAL" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">"Those who were bathed in the blood of the war dead turned green-eyed and began massacring people indiscriminately. </STYLE>
{PAUSE ""}
<STYLE ID="4">The green-eyed gradually grew in number, until the war was the least of anyone's worries. </STYLE>
{PAUSE ""}
<STYLE ID="4">The two sides agreed to a temporary truce and worked together to stop the massacre by the 'green eyes' by force of arms. </STYLE>
{PAUSE ""}
<STYLE ID="4">The Arata settlement's population, about 100 at the time, dropped to about 50 through this war and the incident."</STYLE><PG>
<STYLE ID="4">"Both the original settlers and the Westerners realized it. </STYLE>
{PAUSE ""}
<STYLE ID="4">'The curse of the green eyes didn't happen because the Westerners came to the Arata settlement.' </STYLE>
{PAUSE ""}
<STYLE ID="4">'If it were the Westerners' fault, there's no way the Westerners' side would have been harmed.' </STYLE>
{PAUSE ""}
<STYLE ID="4">'In that case, it must have been Droga that caused it.'"</STYLE><PG>
<STYLE ID="4">"Either way, the green-eyed had to be eliminated―</STYLE>
{PAUSE ""}
<STYLE ID="4">that became their shared understanding, and every green-eyed person was killed. </STYLE>
{PAUSE ""}
<STYLE ID="4">So what became of Tomi?"</STYLE><PG>
{MESOFF "500"}
{STOPSND "SE" "3000" "PASS"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\真呪殺\女神\トミ緑.gal" "NORMAL" "#1" "R" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "000" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">"She was green-eyed from birth. </STYLE>
{PAUSE ""}
<STYLE ID="4">Tomi, only 2 at the time, had never used Droga and showed no sign of attacking anyone. </STYLE>
{PAUSE ""}
<STYLE ID="4">The people discussed what to do with her."</STYLE><PG>
<STYLE ID="4">"―One said: </STYLE>
{PAUSE ""}
<STYLE ID="4">'Tomi hasn't done anything yet. So there's no point in punishing her.' </STYLE>
{PAUSE ""}
<STYLE ID="4">―Another said: </STYLE>
{PAUSE ""}
<STYLE ID="4">'It's precisely because she hasn't done anything yet that there's still time. She should be killed right now.' </STYLE>
{PAUSE ""}
<STYLE ID="4">―Yet another said: </STYLE>
{PAUSE ""}
<STYLE ID="4">'Isn't Tomi someone special, who can overcome the curse?'"</STYLE><PG>
<STYLE ID="4">"Gradually she came to be seen as special and, as I said earlier, was raised with great care. </STYLE>
{PAUSE ""}
<STYLE ID="4">Then 12 years passed. </STYLE>
{PAUSE ""}
<STYLE ID="4">And at last, what they had feared came to pass."</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\sceneswitch2.ogg" "VOICE" "NORMAL" "1000" "0"}
{CREATECG "000" "$0000FF" "NORMAL" "#1" "C" "B" "0" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">"In the middle of the night, Tomi ran outside and thrashed about, screaming. </STYLE>
{PAUSE ""}
<STYLE ID="4">The residents who noticed the commotion thought, 'Has it finally begun?' and, though </STYLE><STYLE ID="11" RUBY="おび">trembling with fear</STYLE><STYLE ID="4">, took up weapons to kill Tomi. </STYLE>
{PAUSE ""}
<STYLE ID="4">But as she thrashed, Tomi spoke."</STYLE><PG>
<STYLE ID="4">"'I don't want to kill anyone, but if I don't kill, I'll die. </STYLE>
{PAUSE ""}
<STYLE ID="4">If my eye being green is what makes me want to kill, I don't need an eye like this.'"</STYLE><PG>
<STYLE ID="4">"And then Tomi―</STYLE>
{PAUSE ""}
{MESOFF "500"}
{PLAYSND "SE\bodyrip1.ogg" "VOICE" "NORMAL" "1000" "0"}
{DELETECG "人物1" "1" "3000" "0" "0" "" "0"}
{MESON "500"}
<STYLE ID="4">gouged out her own green eye with her bare hands. </STYLE>
{PAUSE ""}
<STYLE ID="4">The residents froze at the gruesome sight, and even those who had meant to kill Tomi began to back away."</STYLE><PG>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\真呪殺\女神\目玉取り出す.gal" "NORMAL" "#1" "R" "540" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
{QUAKE "人物1" "QUAKE" "1" "5" "5" "0" "30"}
<EVENT VALUE="MOTION\r\n789\r\n人物1\r\n4\r\n10\r\n3000\r\nDEC\r\nPASS">
{WAIT "3000" "CLICK" "SKIP"}
<EVENT VALUE="MOTION\r\n789\r\n人物1\r\n4\r\n10\r\n0\r\nDEC\r\nPASS">
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">"'Look... </STYLE>
{PAUSE ""}
<STYLE ID="4">my eye's out... </STYLE>
{PAUSE ""}
<STYLE ID="4">it's out.' </STYLE>
{PAUSE ""}
<STYLE ID="4">Tomi, </STYLE><STYLE ID="12" RUBY="もだ">writhing</STYLE><STYLE ID="4"> with an unbearable desire to kill and the pain in her eye, set her own eyeball on her palm and showed it to the residents. </STYLE>
{PAUSE ""}
<STYLE ID="4">But then Tomi said: </STYLE>
{PAUSE ""}
<STYLE ID="4">'But I still want to kill. </STYLE>
{PAUSE ""}
<STYLE ID="4">Even with my eye out, I still want to kill. </STYLE>
{PAUSE ""}
<STYLE ID="4">No good anymore.'"</STYLE><PG>
{MESOFF "500"}
{DELETECG "人物1" "1" "500" "0" "0" "" "0"}
{QUAKESTOP "0"}
{PLAYSND "SE\bodyrip1.ogg" "VOICE" "NORMAL" "1000" "0"}
{DELETECG "000" "1" "1000" "0" "0" "" "0"}
{WAITPLAY "VOICE" "CLICK"}
{MESON "500"}
<STYLE ID="4">"And then Tomi shoved her hand deep into the hole where she'd gouged out her eye, churned up her brain, and killed herself. </STYLE>
{PAUSE ""}
<STYLE ID="4">Having witnessed her harrowing end, the residents wondered whether they could really bury Tomi like this, as one who was cursed―</STYLE>
{PAUSE ""}
<STYLE ID="4">or whether they ought instead to revere Tomi, who had resisted the curse to the very end."</STYLE><PG>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\真呪殺\女神\ミイラ能面.gal" "NORMAL" "#1" "R" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">"And so her body was made into a mummy and became an object of worship for the residents. </STYLE>
{PAUSE ""}
<STYLE ID="4">And she was given the name of a god, Verde. </STYLE>
{PAUSE ""}
<STYLE ID="4">Incidentally, 'Verde' is Portuguese for 'green.'"</STYLE><PG>
<STYLE ID="4">"Ever since then, the Arata settlement has had two </STYLE><STYLE ID="13" RUBY="おきて">rules</STYLE><STYLE ID="4">. </STYLE>
{PAUSE ""}
<STYLE ID="4">One is to never touch Droga again. </STYLE>
{PAUSE ""}
<STYLE ID="4">And the other is to keep worshipping the Goddess Verde."</STYLE><PG>
{MESOFF "500"}
{PLAYSND "BGM死月編\鬱蒼.ogg" "BGM2" "REPEAT" "0" "0"}
{CHGVOL "BGM2" "1000" "3000" "PASS"}
{STOPSND "BGM" "5000" "PASS"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島バストアップ.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "000" "グラフィック\背景\詫言編　夢から\秘密基地内部.gal" "NORMAL" "#1" "C" "B" "0" "1" "5000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">"This book was written in June of Shiyo 354―</STYLE>
{PAUSE ""}
<STYLE ID="4">2 years and 2 months after Tomi died, then."</STYLE>
{PAUSE ""}
<BR>
"I get the background of why Verde's worshipped, but... 
{PAUSE ""}
why would just that make the people here today keep blindly believing in a Verde who suddenly showed up?
{PAUSE ""}
　Even I didn't know about it!"<PG>
<STYLE ID="4">"There are two possibilities I can think of. </STYLE>
{PAUSE ""}
<STYLE ID="4">Over a long time, the residents failed to pass their faith on to their descendants, Verde became little more than a ritual implement, and she was stored away as good as discarded. </STYLE>
{PAUSE ""}
<STYLE ID="4">Then recently the mummy was found, and the residents began worshipping her again."</STYLE>
{PAUSE ""}
<BR>
"No, no, that's weird. 
{PAUSE ""}
Just because of that, <STYLE ID="14">Sakura-san</STYLE> gets turned into a mummy and they suddenly start blindly believing in Verde..."<PG>
<STYLE ID="4">"Exactly. It's far too much of a stretch. </STYLE>
{PAUSE ""}
<STYLE ID="4">Which brings up the other possibility, but... </STYLE>
{PAUSE ""}
<STYLE ID="4">um... </STYLE>
{PAUSE ""}
<STYLE ID="4">it's a little too far removed from reality..."</STYLE>
{PAUSE ""}
<BR>
"Everything's already way removed from reality... 
{PAUSE ""}
I'm not gonna be surprised now."<PG>
<STYLE ID="4">"All right. Then, this is just my guess, but..."</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島うつむき.gal" "NORMAL" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="2">Without her notepad, </STYLE><STYLE ID="4">Goto</STYLE><STYLE ID="2"> closes her eyes and lowers her head as if searching her memory.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">And she's slow to say anything.</STYLE><PG>
"<STYLE ID="4">Goto</STYLE>, you okay?"
{PAUSE ""}
<BR>
<STYLE ID="4">"Yes... </STYLE>
{PAUSE ""}
<STYLE ID="4">Even if I'm going to talk, I need to get things in order first..."</STYLE>
{PAUSE ""}
<BR>
{STOPSND "BGM2" "3000" "PASS"}
<STYLE ID="4">Goto</STYLE><STYLE ID="2"> taking time to put things in order means it's serious, doesn't it?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Then </STYLE><STYLE ID="4">Goto</STYLE><STYLE ID="2">, eyes still closed and head still bowed, slowly begins to speak.</STYLE><PG>
{PLAYSND "最後の声・真呪殺\z50逆.ogg" "BGM" "REPEAT" "1000" "0"}
<STYLE ID="4">"The existence of a fourth generation―</STYLE>
{PAUSE ""}
<STYLE ID="4">and... </STYLE>
{PAUSE ""}
<STYLE ID="4">it might be because of a parasitic species..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Generation? Parasite?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">What's she talking about?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Nobody's said anything like that until now...</STYLE><PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\荒田集落イメージ.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">"I told you I gathered all kinds of information before I came here, and I also got hold of at least some information about Droga.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">First generation: those who used Droga</STYLE><BR>
<STYLE ID="4">Second generation: those bathed in first-generation blood</STYLE><BR>
<STYLE ID="4">Third generation: those bathed in second-generation blood"</STYLE><PG>
<STYLE ID="4">"Furthermore,</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">First generation: superhuman strength, only right after using Droga</STYLE><BR>
<STYLE ID="4">Second generation: precognition under certain conditions in cherry-blossom season</STYLE><BR>
<STYLE ID="4">Third generation: green eyes"</STYLE><PG>
"So then, <STYLE ID="1">Natsumi</STYLE> and <STYLE ID="14">Sakura-san</STYLE> are second generation, and Verde and <STYLE ID="7">Kana</STYLE> are third generation?"
{PAUSE ""}
<BR>
<STYLE ID="4">"I couldn't find out anything about the third generation beyond 'green eyes' either."</STYLE><PG>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\真呪殺\女神\トミ.gal" "NORMAL" "#1" "R" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜バストアップ.gal" "NORMAL" "#1" "L" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="4">"But according to this book, the green-eyed try to kill people once they reach about the age of puberty. </STYLE>
{PAUSE ""}
<STYLE ID="4">They're struck by murderous intent so strong they can't control it with their own will."</STYLE><PG>
<STYLE ID="4">"Verde became a mummy while still third generation, and her body has gone on existing to the present day. </STYLE>
{PAUSE ""}
<STYLE ID="4">The truth is, Droga's symptoms by generation are only known up to the third generation. </STYLE>
{PAUSE ""}
<STYLE ID="4">That's because after the third generation go into a frenzy, they're most likely killed or die in the frenzy, so there's no data on the fourth generation or later."</STYLE><PG>
<STYLE ID="4">"So the question remains: 'What happens if someone is bathed in third-generation blood?' </STYLE>
{PAUSE ""}
<STYLE ID="4">Let's tentatively call that the fourth generation."</STYLE><PG>
<STYLE ID="4">"I don't really know why the third generation's massacres happen, but because of the killing, I think in the end only one person is left alive. </STYLE>
{PAUSE ""}
<STYLE ID="4">How does the one who survives the third generation go on living after that―</STYLE>
{PAUSE ""}
<STYLE ID="4">No, rather: once they're alone, what kind of society do they build? </STYLE>
{PAUSE ""}
<STYLE ID="4">Think of it as something like bees or ants."</STYLE><PG>
"Hey now, you're thinking of people the same as bees and ants?"
{PAUSE ""}
<BR>
<STYLE ID="4">"Well, we just saw it, didn't we? </STYLE>
{PAUSE ""}
{MESOFF "500"}
{PLAYMOVIE "111.wmv" "256" "C" "C" "REPEAT" "FALSE" "200" "0"}
<EVENT VALUE="MOTION\r\n789\r\nムービー\r\n11\r\n50\r\n3000\r\nNORMAL\r\nPASS">
{CHANGECG "000" "グラフィック\背景\女神\集落全景.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1,人物2" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">The residents of the Arata settlement, like worker bees guarding a 'queen bee' called Verde―</STYLE>
{PAUSE ""}
<STYLE ID="4">What would you call that, if not a controlled, insect-like society?"</STYLE><PG>
<STYLE ID="4">"I don't know why they build a society like this. </STYLE>
{PAUSE ""}
<STYLE ID="4">But if we also factor in what you, </STYLE>Niimura-senpai<STYLE ID="4">, heard from that </STYLE><STYLE ID="6">Chiga-nee</STYLE><STYLE ID="4"> person, I think we can see the true roles of the generations produced by those who used Droga."</STYLE><PG>
<STYLE ID="2">First generation: parasitization and the start of reproduction</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Second generation: expansion of the parasitic range</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Third generation: selection of the parasitic host</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Fourth generation: completion of reproduction</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">What if we think of it this way?</STYLE><PG>
"U-um, hey, <STYLE ID="4">Goto-san</STYLE>... 
{PAUSE ""}
All this sudden talk of parasitizing and completing reproduction, I don't really follow..."
{PAUSE ""}
<BR>
<STYLE ID="4">"Then stop focusing only on humans and try thinking about it from the Arata cherry's position. </STYLE>
{PAUSE ""}
<STYLE ID="4">Why did the Arata cherry evolve to be able to supply humans with an alluring substance like Droga? </STYLE>
{PAUSE ""}
<STYLE ID="4">As a living thing, it must have some ultimate goal."</STYLE><PG>
<STYLE ID="4">"The Arata cherry is a rare variety unique to the Arata district, yet until 70 years ago it was reproducing in this area. </STYLE>
{PAUSE ""}
<STYLE ID="4">But only one tree is left, and it's doomed to go extinct. </STYLE>
{PAUSE ""}
<STYLE ID="4">Why can't it reproduce? </STYLE>
{PAUSE ""}
<STYLE ID="4">Using seedlings or seeds, it should be possible to bring the cherry back again."</STYLE><PG>
{MESOFF "500"}
<EVENT VALUE="MOTION\r\n789\r\nムービー\r\n11\r\n0\r\n1000\r\nNORMAL\r\nPASS">
{CREATECG "人物1" "グラフィック\立ち絵\人物\五島うつむき.gal" "NORMAL" "#1" "R" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CHANGECG "000" "グラフィック\背景\詫言編　夢から\秘密基地内部.gal" "NORMAL" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<EVENT VALUE="STOPMOVIE">
"H-hold on a sec, <STYLE ID="4">Goto</STYLE>!
{PAUSE ""}
　Uh, my head really can't keep up with this... 
{PAUSE ""}
for now, more than the background, I wanna know how to get out of this awful situation..."
{PAUSE ""}
<BR>
<STYLE ID="4">"Ah, sorry... </STYLE>
{PAUSE ""}
<STYLE ID="4">If my hypothesis... or rather, my guess, is right, there are two things we need to do. </STYLE>
{PAUSE ""}
<STYLE ID="4">One is to completely eliminate Verde's mummy. </STYLE>
{PAUSE ""}
<STYLE ID="4">And the other is to completely destroy the Arata cherry."</STYLE><PG>
"The mummy and the cherry...?"
{PAUSE ""}
<BR>
<STYLE ID="4">"Yes. Going by what the residents said, the mummy is probably giving off some substance from its body―</STYLE>
{PAUSE ""}
<STYLE ID="4">what they call 'Blessing,' and it's putting the residents into an awakened state. </STYLE>
{PAUSE ""}
<STYLE ID="4">And the root cause of it is the Arata cherry. </STYLE>
{PAUSE ""}
<STYLE ID="4">The Arata cherry wants companions. </STYLE>
{PAUSE ""}
<STYLE ID="4">Increasing those companions is, in other words, what you could call the destruction of the Arata settlement."</STYLE><PG>
"The cherry wants more companions... You don't mean..."
{PAUSE ""}
<BR>
<STYLE ID="4">"That's right. If the Arata cherry's biology is to reproduce using humans as hosts―</STYLE>
{PAUSE ""}
<STYLE ID="4">It spreads the infection using the blood of those who used Droga as a medium, and seeks out whoever is best suited to be a host. </STYLE>
{PAUSE ""}
<STYLE ID="4">Finally, with that one at the center, everyone around them becomes a host, their bodies taken over like a caterpillar fungus, and they end up as seedbeds for the cherry."</STYLE><PG>
"<STYLE ID="4">Goto</STYLE>... that's just not realistic at all..."
{PAUSE ""}
<BR>
<STYLE ID="4">"I know. I'm aware I'm going overboard with my delusions. </STYLE>
{PAUSE ""}
<STYLE ID="4">But when I put together everything that's happened so far, Droga's properties, and the Arata cherry's biology, this fits the best."</STYLE><PG>
<STYLE ID="4">Goto</STYLE><STYLE ID="2">'s guess, summed up my own way, goes like this.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">The Arata cherry is a living thing that parasitizes humans, and Droga is the Arata cherry's seed.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Through blood infection it finds the best host, and with that host in a queen-bee position (the third generation), it turns everyone around them into cherry hosts too.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">In other words, this generation-to-generation infection through Droga is something the Arata cherry needs in order to reproduce.</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="4">"</STYLE>Niimura-senpai<STYLE ID="4">, for now, please think of all that as my delusion. </STYLE>
{PAUSE ""}
<STYLE ID="4">Something like, 'Oh, so you can force a logic onto it if you really try.'"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Just then, </STYLE>
{PAUSE ""}
{MESOFF "500"}
{PLAYSND "SE\swish.ogg" "VOICE" "NORMAL" "1000" "0"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\なつみ倒れる.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "000" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="1">Natsumi</STYLE><STYLE ID="2"> starts to stir.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Has she come to?</STYLE>
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{MESOFF "500"}
{STOPSND "BGM" "3000" "PASS"}
{DELETECG "人物1" "1" "3000" "0" "0" "" "0"}
<PG>
{}
