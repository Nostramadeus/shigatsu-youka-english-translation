<SCENARIO VER="105">
{MESOFF "0"}
{PLAYSND "環境音\渓流.ogg" "SE" "REPEAT" "600" "0"}
{CHANGECG "000" "グラフィック\背景\エデン\墓地昼.gal" "NORMAL" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
