<STYLE ID="3">Mifuyu Niimura</STYLE>
{PAUSE ""}
<BR>
<BR>
<STYLE ID="3">Obasan</STYLE><STYLE ID="1">'s turn.</STYLE><PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\詫言編　夢から\新村本家居間暗い.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\美冬腰に手バストアップ.gal" "NORMAL" "#1" "R" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
