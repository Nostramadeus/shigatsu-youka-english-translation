<EVENT VALUE="MOTION\r\n789\r\n人物2\r\n3\r\n700\r\n0\r\nDEC\r\nPASS">
{MESON "500"}
<STYLE ID="1">I felt someone's breath from behind me.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">A smell that reeked of blood and made me want to throw up.</STYLE><PG>
