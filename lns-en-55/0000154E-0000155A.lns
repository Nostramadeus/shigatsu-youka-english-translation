;    2: TDecorate(count=80, unk2=255, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    3: TDecorate(count=16, unk2=16755370, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    4: TDecorate(count=589, unk2=16757864, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    5: TDecorate(count=58, unk2=11271932, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    6: TDecorate(count=9, unk2=13464750, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    7: TDecorate(count=733, unk2=8388863, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    8: TDecorate(count=885, unk2=65535, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    9: TDecorate(count=1, unk2=65535, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=むち, unk10=4294967295, unk11=4294967295)
;   10: TDecorate(count=14, unk2=16755455, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;   11: TDecorate(count=719, unk2=5265653, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;   12: TDecorate(count=6, unk2=16757864, unk3=4294967295, unk4=48, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;   13: TDecorate(count=3, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=じんちょうげ, unk10=4294967295, unk11=4294967295)
;   14: TDecorate(count=2, unk2=5265653, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=ふくしゅう, unk10=4294967295, unk11=4294967295)
;   15: TDecorate(count=1, unk2=5265653, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=あお, unk10=4294967295, unk11=4294967295)
;   16: TDecorate(count=2, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=だま, unk10=4294967295, unk11=4294967295)
; Display conditions:
;    0: TWdCondition(count=5609, target=)
; Links:
;    0: TWdLink(count=5086, event=, unk3=)
;---------------------------------------
; BEGIN DECOMPILED SCRIPT
;---------------------------------------
<SCENARIO VER="105">
{CREATECG "000" "グラフィック\背景\詫言編　夢から\集会場.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "1" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>―<STYLE ID="1">Uncle</STYLE>'s thirteenth-year memorial service ended without incident.
{PAUSE ""}
<BR>
Everyone had spent the whole night dealing with <STYLE ID="2">Shigatsu Youka</STYLE>, so some people were dozing off, but no one blamed them for it.<PG>
Will Arata's own custom of wearing Noh masks and red robes come to an end now, too?
{PAUSE ""}
<BR>
It had already been hollowed out to a mere form, but the Noh masks and red robes helped us.
{PAUSE ""}
<BR>
It is the precious wisdom of our ancestors.
{PAUSE ""}
<BR>
Even if it is hollowed out further still, I want to keep at least its form.<PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\詫言編　夢から\新村本家玄関.gal" "NORMAL" "1" "3000" "0" "0" "" "1" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\春花腕組み.gal" "NORMAL" "#1" "R" "B" "0" "1" "500" "0" "0" "" "1" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="3">"Aah, I'm done! I'm going to sleep!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">"Mm... Good work, everyone."</STYLE>
{PAUSE ""}
<BR>
On my back, <STYLE ID="5">Kana</STYLE> was breathing softly in her sleep.
{PAUSE ""}
<BR>
Because everyone truly did their best, we were able to bring the curse-killing case to an end.<PG>
The Motoki-cho group, I heard, would stay tonight as originally planned and go home tomorrow.
{PAUSE ""}
<BR>
Everyone will probably fall asleep now, but I wonder about their body clocks.
{PAUSE ""}
<BR>
Waking at night and not being able to sleep will make going home tomorrow hard.<PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\エデン\幸太郎の部屋.gal" "NORMAL" "" "0" "0" "0" "" "1" "0" "0" "255" ""}
{DELETECG "人物1" "1" "3000" "0" "0" "" "1"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">"</STYLE><STYLE ID="5">Kana</STYLE><STYLE ID="4">..."</STYLE>
{PAUSE ""}
<BR>
I laid <STYLE ID="5">Kana</STYLE> down on the futon and gently stroked her face.
{PAUSE ""}
<BR>
Painful-looking wounds remained all over her body, but these, too, would soon heal.
{PAUSE ""}
<BR>
The herbal medicine <STYLE ID="6">Grandma</STYLE> made should work well.<PG>
What had <STYLE ID="5">Kana</STYLE> thought, meeting <STYLE ID="7">Mom</STYLE>?
{PAUSE ""}
<BR>
She may have gotten to see <STYLE ID="7">Mom</STYLE>, but it was a painful sight, a body rotting and crumbling away.
{PAUSE ""}
<BR>
I was glad I got to exchange words with <STYLE ID="7">Mom</STYLE> once more at the end.
{PAUSE ""}
<BR>
But it was painful.<PG>
<STYLE ID="7">Mom</STYLE>... all this time, it must have been so painful for you.
{PAUSE ""}
<BR>
For so long, so very long, controlled by <STYLE ID="2">Shigatsu Youka</STYLE>―
{PAUSE ""}
<BR>
But... I had realized.<PG>
{STOPSND "BGM" "5000" "PASS"}
The curse-killing case had not yet reached its true solution.
{PAUSE ""}
<BR>
There was still something that had to be pursued.<PG>
{MESOFF "500"}
{PLAYSND "SE\ノック.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAITPLAY "VOICE" "CLICK"}
{MESON "500"}
<STYLE ID="4">"Mm... Yes?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="8">"Excuse me, coming in."</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\詫言編　夢から\ふすま.ogg" "VOICE" "NORMAL" "1000" "0"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\五島バストアップ.gal" "NORMAL" "#1" "R" "B" "0" "1" "1000" "0" "0" "" "1" "0" "0" "255" ""}
{WAITPLAY "VOICE" "CLICK"}
{MESON "500"}
The one who came in was <STYLE ID="8">Goto-chan</STYLE>.
{PAUSE ""}
<BR>
Her eyes looked sleepy, but the light in them was strangely sharp.
{PAUSE ""}
<BR>
She turned those eyes toward <STYLE ID="5">Kana</STYLE>.<PG>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島うつむき.gal" "NORMAL" "1" "1000" "0" "0" "" "1" "0" "0" "255" ""}
{MESON "500"}
{PLAYSND "togisuma.ogg" "BGM" "REPEAT" "1000" "0"}
<STYLE ID="8">"</STYLE><STYLE ID="5">Kana-chan</STYLE><STYLE ID="8"> really did her best to save us, didn't she. </STYLE>
{PAUSE ""}
<STYLE ID="8">She </STYLE><STYLE ID="9" RUBY="むち">pushed</STYLE><STYLE ID="8"> her injured leg to pull </STYLE><STYLE ID="10">Kogori-senpai</STYLE><STYLE ID="8"> out, and when </STYLE><STYLE ID="4">Chiga-nee</STYLE><STYLE ID="8"> was strangling me, she honestly tried to help."</STYLE>
{PAUSE ""}
<BR>
Is she saying this to blame me?
{PAUSE ""}
<BR>
It was only an act, but I put <STYLE ID="8">Goto-chan</STYLE> through excessive fear and pain.<PG>
<STYLE ID="4">"Mm... I'm sorry, </STYLE><STYLE ID="8">Goto-chan</STYLE><STYLE ID="4">..."</STYLE>
{PAUSE ""}
<BR>
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島バストアップ.gal" "NORMAL" "1" "1000" "0" "0" "" "1" "0" "0" "255" ""}
<STYLE ID="8">"Huh?</STYLE>
{PAUSE ""}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島考えるバストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "1" "0" "0" "255" ""}
<STYLE ID="8">　Oh, I'm sorry, I didn't mean it that way. </STYLE>
{PAUSE ""}
<STYLE ID="8">I know you had no choice."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="8">Goto-chan</STYLE> said this while gently holding me by both shoulders.
{PAUSE ""}
<BR>
Even so, that doesn't change the fact that I made <STYLE ID="8">Goto-chan</STYLE> suffer.<PG>
<STYLE ID="4">"Mm... Still, back then it was only all right because </STYLE><STYLE ID="11">Dad</STYLE><STYLE ID="4"> injected me with falsificaso. If he hadn't..."</STYLE>
{PAUSE ""}
<BR>
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島バストアップ.gal" "NORMAL" "1" "1000" "0" "0" "" "1" "0" "0" "255" ""}
<STYLE ID="8">"If you start on that, there's no end to it. </STYLE>
{PAUSE ""}
<STYLE ID="8">Whatever the case, if any one thing had gone wrong..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">"Mm... You're right. </STYLE>
{PAUSE ""}
<STYLE ID="4">But still, what I did to you, </STYLE><STYLE ID="8">Goto-chan</STYLE><STYLE ID="4">..."</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島挨拶バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "1" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="8">"Then next time, treat me at that ryotei in Tokyo!"</STYLE>
{PAUSE ""}
<BR>
{QUAKE "メッセージボックス土台" "QUAKE" "1" "15" "15" "0" "30"}
<STYLE ID="12">"Whaat!!?</STYLE>
{QUAKESTOP "500"}
{PAUSE ""}
<STYLE ID="4">　That's... a bit..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="8">"Ahahaha! Just kidding! If I did that, </STYLE><STYLE ID="4">Chiga-nee</STYLE><STYLE ID="8"> would be up to her neck in loan-shark debt!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">"Mm... Just how much do you plan to eat..."</STYLE><PG>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜寝るバストアップ.gal" "NORMAL" "#1" "L" "B" "0" "1" "500" "0" "0" "" "1" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="5">"</STYLE><STYLE ID="8">Eri-nee</STYLE><STYLE ID="5">...?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">Kana</STYLE>, who had been asleep, seemed to have reacted to <STYLE ID="8">Goto-chan</STYLE>'s voice.
{PAUSE ""}
<BR>
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "1" "0" "0" "255" ""}
<STYLE ID="8">"Ah, sorry, </STYLE><STYLE ID="5">Kana-chan</STYLE><STYLE ID="8">, I got carried away..."</STYLE>
{PAUSE ""}
<BR>
{CHANGECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "1" "0" "0" "255" ""}
<STYLE ID="5">"Ehe."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="8">"Hm?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">"I've got... two big sisters..."</STYLE>
{PAUSE ""}
<BR>
At that, <STYLE ID="8">Goto-chan</STYLE> and I looked at each other.<PG>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島挨拶バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "1" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="8">"Then I guess </STYLE><STYLE ID="4">Chiga-nee</STYLE><STYLE ID="8"> and I are sisters too?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">"Mm... Hee hee, I suppose so."</STYLE>
{PAUSE ""}
<BR>
And we laughed together.
{PAUSE ""}
<BR>
It was a calm, warm atmosphere that made us forget even our sleepiness.<PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\女神\集落全景.gal" "NORMAL" "" "0" "0" "0" "" "1" "0" "0" "255" ""}
{DELETECG "人物1,人物2" "1" "3000" "0" "0" "" "1"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
Still, why had <STYLE ID="8">Goto-chan</STYLE> come to this room?
{PAUSE ""}
<BR>
I still hadn't heard what she came to say.
{PAUSE ""}
<BR>
<STYLE ID="8">Goto-chan</STYLE> stroked <STYLE ID="5">Kana</STYLE>'s head, trying to get her back to sleep.
{PAUSE ""}
<BR>
She kept gazing at <STYLE ID="5">Kana</STYLE> with gentle eyes, and <STYLE ID="5">Kana</STYLE>, too, smiled peacefully, as if looking at her mother.
{PAUSE ""}
<BR>
The sharp light from before was nowhere in <STYLE ID="8">Goto-chan</STYLE>'s eyes now.<PG>
This means... 
{PAUSE ""}
{STOPSND "BGM" "5000" "PASS"}
<STYLE ID="8">Goto-chan</STYLE> is thinking the same thing I am.
{PAUSE ""}
<BR>
Something we can't discuss while <STYLE ID="5">Kana</STYLE> is awake.
{PAUSE ""}
<BR>
Something hidden underneath, that we still haven't finished pursuing.<PG>
{MESOFF "500"}
{DELETECG "000" "1" "3000" "0" "0" "" "1"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
―Before long, <STYLE ID="5">Kana</STYLE> fell asleep again and began breathing softly and peacefully.<PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\エデン\幸太郎の部屋.gal" "NORMAL" "" "0" "0" "0" "" "1" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\五島うつむき.gal" "NORMAL" "#1" "R" "B" "0" "1" "3000" "0" "0" "" "1" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="8">"............"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">"Mm... </STYLE><STYLE ID="8">Goto-chan</STYLE><STYLE ID="4">, you came here because there's something you want to tell me, didn't you?"</STYLE>
{PAUSE ""}
<BR>
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島バストアップ.gal" "NORMAL" "1" "1000" "0" "0" "" "1" "0" "0" "255" ""}
{PLAYSND "BGM死月編\鬱蒼.ogg" "BGM" "REPEAT" "1000" "0"}
<STYLE ID="8">"Come with me a moment. There's somewhere we need to go."</STYLE>
{PAUSE ""}
<BR>
That light came back into <STYLE ID="8">Goto-chan</STYLE>'s eyes.
{PAUSE ""}
<BR>
<STYLE ID="4">"Mm... All right."</STYLE><PG>
{MESOFF "500"}
{DELETECG "000,人物1" "1" "3000" "0" "0" "" "1"}
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "SE\詫言編　夢から\引き戸.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAITPLAY "VOICE" "CLICK"}
{CREATECG "000" "グラフィック\背景\エデン\蔵火事昼.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "1" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">"Mm... What is... this..."</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\五島バストアップ.gal" "NORMAL" "#1" "R" "B" "0" "1" "500" "0" "0" "" "1" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="8">"You may not have known, </STYLE><STYLE ID="4">Chiga-nee</STYLE><STYLE ID="8">, but this storehouse burned yesterday."</STYLE>
{PAUSE ""}
<BR>
The second floor was heavily blackened with soot, clearly showing there had been a fire.<PG>
<STYLE ID="8">"Only the second floor burned in this fire."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">"Mm... The second floor...?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="8">"Yes. If a fire breaks out in a storehouse with no source of flame, it's a short circuit or arson. </STYLE>
{PAUSE ""}
<STYLE ID="8">But there was nothing wrong with the wiring, and the only things that burned were the books on the table."</STYLE><PG>
<STYLE ID="4">"Mm... Was it </STYLE><STYLE ID="1">Uncle</STYLE><STYLE ID="4">, or </STYLE><STYLE ID="7">Mom</STYLE><STYLE ID="4">, I wonder..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="8">"No. The books in the storehouse were what it needed to lead us to the summit. </STYLE>
{PAUSE ""}
<STYLE ID="10">Kogori-senpai</STYLE><STYLE ID="8"> and one other person were meant to become divine messengers, part of </STYLE><STYLE ID="2">Shigatsu Youka</STYLE><STYLE ID="8">."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">"Mm... Then someone who noticed </STYLE><STYLE ID="2">Shigatsu Youka</STYLE><STYLE ID="4">'s ambition burned them?"</STYLE><PG>
<STYLE ID="8">"That's not it either. We already knew about </STYLE><STYLE ID="2">Shigatsu Youka</STYLE><STYLE ID="8"> before the fire, so it was too late for that. </STYLE>
{PAUSE ""}
<STYLE ID="8">Quite simply, someone didn't want us reading any more of those books."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">"Mm... A person...?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="8">"Yes. The arsonist is someone from the settlement."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">"............"</STYLE>
{PAUSE ""}
<BR>
I see. So that's how it is.
{PAUSE ""}
<BR>
Then it ties in with what I want to pursue, too.<PG>
<STYLE ID="4">"Mm... </STYLE><STYLE ID="8">Goto-chan</STYLE><STYLE ID="4">, there's something I want you to see too. Will you come with me?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="8">"Yes."</STYLE><PG>
{MESOFF "500"}
{DELETECG "000,人物1" "1" "2000" "0" "0" "" "1"}
{CREATECG "000" "グラフィック\背景\詫言編　夢から\荒田森1朝.gal" "NORMAL" "#1" "R" "B" "0" "1" "2000" "0" "0" "" "1" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{CHANGECG "000" "グラフィック\背景\詫言編　夢から\秘密基地昼.gal" "NORMAL" "1" "1000" "0" "0" "" "1" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
