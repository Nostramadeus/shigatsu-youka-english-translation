{CHANGECG "人物1" "グラフィック\立ち絵\人物\なつみ横顔前.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\なつみ茅萱握手.gal" "NORMAL" "#1" "C" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
