{WAIT "1000" "CLICK" "SKIP"}
{STOPSND "VOICE" "1000" "PASS"}
{MESON "500"}
"She ran off home again... 
{PAUSE ""}
Is she avoiding me?"
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{MESOFF "500"}
{STOPSND "BGM" "3000" "PASS"}
