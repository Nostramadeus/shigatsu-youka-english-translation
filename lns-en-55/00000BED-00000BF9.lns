;---------------------------------------
; BEGIN DECOMPILED SCRIPT
;---------------------------------------
<SCENARIO VER="105">
{PLAYSND "BGM死月編\春の兆し.ogg" "BGM" "REPEAT" "1000" "0"}
{WAIT "2000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\背景\詫言編　夢から\豊岳駅外.gal" "NORMAL" "#1" "C" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\春花うつむき電話.gal" "NORMAL" "#1" "R" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>"Hello, <STYLE ID="1">Mom</STYLE>? At <STYLE ID="2" RUBY="とよたけえき">Toyotake Station</STYLE>, we ran into <STYLE ID="3">Kana</STYLE>... 
{PAUSE ""}
Yeah... yeah..."
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島ぐったり.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="4">Goto</STYLE><STYLE ID="5"> was worn out before we'd even set off.</STYLE><PG>
<STYLE ID="4">"I understand that following </STYLE><STYLE ID="6">Kogori-senpai</STYLE><STYLE ID="4">'s intuition is best... </STYLE>
{PAUSE ""}
<STYLE ID="4">But climbing that mountain..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="6">"Sorry, I guess..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">So in the end, we followed </STYLE><STYLE ID="3">Kana-chan</STYLE><STYLE ID="5">.</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島バストアップ.gal" "NORMAL" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="4">"Um... </STYLE><STYLE ID="3">Kana-chan</STYLE><STYLE ID="4">?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">Goto</STYLE><STYLE ID="5"> called out to her hesitantly.</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜手を上げるバストアップ.gal" "NORMAL" "#1" "L" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="3">"Yes! Kana Niimura here! What's up, </STYLE><STYLE ID="4">Goto-chan</STYLE><STYLE ID="3">!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Kana-chan</STYLE><STYLE ID="5"> latched onto </STYLE><STYLE ID="4">Goto</STYLE><STYLE ID="5">'s arm.</STYLE><PG>
<STYLE ID="4">"How long do we have to walk...?"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="3">"Um... </STYLE>
{PAUSE ""}
<STYLE ID="3">for a normal person, about 2 hours?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="6">"T-two hours!?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">This wasn't a stroll. It was full-on mountain climbing.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">And with all this luggage, too...</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜手前バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="3">"Hup!"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="5">With that, </STYLE><STYLE ID="3">Kana-chan</STYLE><STYLE ID="5"> grabbed our bags and slung them over her shoulders.</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜手を上げるバストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="3">"I'll take full responsibility for these bags! </STYLE>
{PAUSE ""}
<STYLE ID="3">　And if I lose them or anything... </STYLE>
{PAUSE ""}
{MESOFF "500"}
{CHANGECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="3">I'll make it up to you with my body... </STYLE>
{PAUSE ""}
<STYLE ID="3">Be gentle with me..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">I was struck speechless along with </STYLE><STYLE ID="4">Goto</STYLE><STYLE ID="5"> by the 10-year-old's blatant dirty joke.</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\春花腰に手1バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
"Okay! I let <STYLE ID="1">Mom</STYLE> know! <STYLE ID="3">Kana</STYLE>, you sure you're okay carrying all that?"
{PAUSE ""}
<BR>
<STYLE ID="3">"I'm fine, I'm fine! I've carried heavier stuff lots of times! I'll take </STYLE>Haruka-chan<STYLE ID="3">'s too!"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\詫言編　夢から\豊岳.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1,人物2" "1" "1000" "0" "0" "" "0"}
{MESON "500"}
<STYLE ID="5">She was going to climb that mountain carrying luggage for three...?</STYLE><PG>
{MESOFF "500"}
{STOPSND "BGM" "3000" "PASS"}
{PLAYSND "SE\詫言編　夢から\砂利を歩く2人.ogg" "SE2" "REPEAT" "0" "0"}
{CHGVOL "SE2" "800" "3000" "PASS"}
{PLAYSND "環境音\春の山.ogg" "SE" "REPEAT" "0" "0"}
{CHGVOL "SE" "1000" "3000" "PASS"}
{PLAYSND "SE\詫言編　夢から\Shortbridge03-1.ogg" "VOICE" "NORMAL" "1000" "0"}
{CHANGECG "000" "グラフィック\背景\詫言編　夢から\登山道1.gal" "NORMAL" "2" "1000" "960" "1" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="6">"Hah... hah..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">"Wheeze... wheeze..."</STYLE>
{PAUSE ""}
<BR>
"This is rough..."
{PAUSE ""}
<BR>
<STYLE ID="5">30 minutes in.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">As the sky burned orange, the slope began to wear on my legs and back.</STYLE><PG>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜手を上げるバストアップ.gal" "NORMAL" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="3">"Come on, everyone, hang in there, hang in there!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Kana-chan</STYLE><STYLE ID="5"> was at the back, shouting </STYLE><STYLE ID="7" RUBY="げき">encouragement</STYLE><STYLE ID="5">.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">Her cheering was so hearty you'd never think she was carrying all that luggage.</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\春花頭かく.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
"L-let's take a break..."
{STOPSND "SE2" "1000" "PASS"}
{PAUSE ""}
<BR>
{MESOFF "500"}
{DELETECG "人物1" "1" "500" "0" "0" "" "0"}
{MESON "500"}
Haruka<STYLE ID="5"> sat down on a rock by the path.</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜バストアップ.gal" "NORMAL" "#1" "L" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="3">"</STYLE>Haruka-chan<STYLE ID="3">, won't sitting down just make it harder?"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\春花うつむき.gal" "NORMAL" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
"Just be quiet a sec... Let me sit for a little..."
{PAUSE ""}
<BR>
<STYLE ID="5">Still, neither </STYLE>Haruka<STYLE ID="5"> nor </STYLE><STYLE ID="4">Goto</STYLE><STYLE ID="5"> had complained once since we started climbing.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">It's probably because it's my intuition, but I still feel bad...</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物2" "グラフィック\立ち絵\人物\五島考えるバストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="4">"But... </STYLE>
{PAUSE ""}
<STYLE ID="4">what a nice view!"</STYLE>
{PAUSE ""}
<BR>
{STOPSND "SE" "5000" "PASS"}
<STYLE ID="4">Goto</STYLE><STYLE ID="5"> looked out at the scenery visible between the trees.</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{PLAYSND "BGM死月編\誰もいない校舎で.ogg" "BGM" "REPEAT" "1000" "0"}
{CHANGECG "000" "グラフィック\背景\詫言編　夢から\登山夕日.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1,人物2" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="5">The sun was cut in half by the horizon, and from its half circle it sent us light that was dazzling yet gentle.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">And far off, I could see a mountain stream flowing.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"The finish line is around that stream!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">It looked like there were still 3 km to go.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">A distance that would take over 30 minutes even on flat ground, and we had to climb it on this mountain path...</STYLE><PG>
<STYLE ID="6">"</STYLE><STYLE ID="3">Kana-chan</STYLE><STYLE ID="6">, are you okay? Isn't it heavy?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Tooootally fine! This kind of thing is my job, since I'm the youngest in the settlement!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Kana-chan</STYLE><STYLE ID="5"> hadn't broken a single sweat.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">I could never live here...</STYLE><PG>
<STYLE ID="3">"Come on, </STYLE>Haruka-chan<STYLE ID="3">, up you get! Let's go, let's go! It'll be bad if it gets pitch dark!"</STYLE>
{PAUSE ""}
<BR>
"Daaamn... guess we're going..."
{PAUSE ""}
<BR>
Haruka<STYLE ID="5"> pushed herself up in one go.</STYLE>
{PAUSE ""}
<BR>
<BR>
{STOPSND "BGM" "3000" "PASS"}
<STYLE ID="5">Just then, something cold hit my face.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">―Rain.</STYLE>
{PLAYSND "環境音\雷雨.ogg" "SE" "REPEAT" "0" "0"}
{CHGVOL "SE" "1000" "5000" "PASS"}
<PG>
{MESOFF "500"}
{PLAYMOVIE "雨1.wmv" "256" "C" "C" "REPEAT" "FALSE" "100" "0"}
<EVENT VALUE="MOTION\r\n789\r\nムービー\r\n11\r\n50\r\n3000\r\nNORMAL\r\nPASS">
{CHANGECG "000" "グラフィック\背景\詫言編　夢から\登山雨1.gal" "NORMAL" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
<EVENT VALUE="MOTION\r\n789\r\nムービー\r\n11\r\n50\r\n0\r\nNORMAL\r\nPASS">
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="5">The rain grew stronger in an instant, and as if the clear sky of a moment ago had been a lie, everything was wrapped in darkness.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Everyone, over here, over here!"</STYLE>
{PAUSE ""}
<BR>
{PLAYSND "SE\詫言編　夢から\砂利を歩く2人.ogg" "SE2" "REPEAT" "800" "0"}
<STYLE ID="5">We hurried after </STYLE><STYLE ID="3">Kana-chan</STYLE><STYLE ID="5">.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">The mountain path had turned into a muddy torrent, impossible to walk on properly.</STYLE><PG>
"Ugh, what the heck is this!"
{PAUSE ""}
<BR>
<STYLE ID="4">"I haaate mountain weather!"</STYLE><PG>
{MESOFF "500"}
{STOPSND "SE2" "3000" "PASS"}
<EVENT VALUE="MOTION\r\n798\r\nムービー\r\n11\r\n0\r\n3000\r\nNORMAL\r\nPASS">
{DELETECG "000" "1" "3000" "0" "0" "" "0"}
<EVENT VALUE="STOPMOVIE">
{WAIT "1000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\背景\詫言編　夢から\登山雨宿り.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="5">―Where </STYLE><STYLE ID="3">Kana-chan</STYLE><STYLE ID="5"> led us was a rock </STYLE><STYLE ID="8" RUBY="ひさし">overhang</STYLE><STYLE ID="5">.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">It was about 3 meters deep, and a little </STYLE><STYLE ID="9" RUBY="ひまつ">spray</STYLE><STYLE ID="5"> from the rain blew in, but it kept the rain off better than an umbrella.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">The ground inside was a bit raised, too, so there was no worry of the muddy water flowing in.</STYLE><PG>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\エデン\夏菜見上げる.gal" "NORMAL" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="3">"Rain like this'll stop soon!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Kana-chan</STYLE><STYLE ID="5"> showed no sign of being tired as she gazed up at the murky black sky.</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\春花頭かく.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
"Damn... I'm soaking <STYLE ID="10" RUBY="ぬ">wet</STYLE>..."
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\五島考えるバストアップ.gal" "NORMAL" "#1" "L" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="4">"Can't we make a fire? We'll catch colds like this..."</STYLE>
{PAUSE ""}
<BR>
"I don't have anything for that... 
{PAUSE ""}
Oh, <STYLE ID="4">Goto</STYLE>!<STYLE ID="5"> </STYLE><STYLE ID="4">You</STYLE>'ve got that fireworks set, right!? Got matches or a lighter!?"
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物2" "グラフィック\立ち絵\人物\五島挨拶バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="4">"</STYLE>Niimura-senpai<STYLE ID="4">'s so smart!"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\春花腕組み.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
