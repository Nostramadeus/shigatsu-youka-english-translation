{CHANGECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜ジャンプ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{PLAYSND "SE\棒を振る.ogg" "VOICE" "NORMAL" "1000" "0"}
<EVENT VALUE="MOTION\r\n789\r\n人物2\r\n4\r\n-540\r\n500\r\nDEC\r\nPASS">
