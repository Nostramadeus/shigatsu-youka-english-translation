{MESON "500"}
<STYLE ID="3">"No! </STYLE><STYLE ID="4">Eri-nee</STYLE><STYLE ID="3"> is mine! </STYLE>
{PAUSE ""}
<STYLE ID="3">　Look! </STYLE><STYLE ID="4">Eri-nee</STYLE><STYLE ID="3"> lent me these clothes!"</STYLE>
