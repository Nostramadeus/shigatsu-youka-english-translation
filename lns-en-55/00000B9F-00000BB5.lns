{CREATECG "人物4" "グラフィック\立ち絵\人物\五島.gal" "NORMAL" "#1" "L" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="2">"</STYLE><STYLE ID="3">Kana-chan</STYLE><STYLE ID="2">! Don't! </STYLE><STYLE ID="6">That person</STYLE><STYLE ID="2"> is...!"</STYLE>
