{QUAKE "メッセージボックス土台" "QUAKE" "1" "15" "15" "0" "30"}
<STYLE ID="11">"That's not it!!"</STYLE>
{QUAKESTOP "500"}
{PAUSE ""}
<BR>
<STYLE ID="1">Suddenly </STYLE>Senpai<STYLE ID="1"> shouted, and with a fearsome look, </STYLE><STYLE ID="12" RUBY="にら">glared</STYLE><STYLE ID="1"> at me.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">I was overwhelmed by </STYLE>Senpai<STYLE ID="1">'s look and voice, and no words came out.</STYLE>
{PAUSE ""}
<BR>
"Hahaha...! This stuff on the surface of the paper, you know what it is?"
{PAUSE ""}
<BR>
{MESOFF "500"}
{PLAYSND "SE\紙ペラ.ogg" "VOICE" "NORMAL" "1000" "0"}
