{CHANGECG "000" "グラフィック\リファレンス用\背景\五島家二階廊下.gal" "NORMAL" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
