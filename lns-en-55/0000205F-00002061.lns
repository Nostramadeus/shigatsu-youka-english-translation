{MESON "500"}
<STYLE ID="3">"Say, </STYLE>Erina<STYLE ID="3">, are you and </STYLE><STYLE ID="1">your sister</STYLE><STYLE ID="3"> still </STYLE><STYLE ID="4" RUBY="けんか">fighting</STYLE><STYLE ID="3">?</STYLE>
