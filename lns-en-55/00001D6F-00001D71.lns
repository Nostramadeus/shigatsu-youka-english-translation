{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="9">That's why </STYLE><STYLE ID="10">the Princess</STYLE><STYLE ID="9"> permitted </STYLE>you<STYLE ID="9"> an </STYLE><STYLE ID="11" RUBY="えっけん">audience</STYLE><STYLE ID="9"> with the Goddess."</STYLE>
{PAUSE ""}
<BR>
"<STYLE ID="9">Eiichiro-san</STYLE>...!"
{PAUSE ""}
<BR>
<STYLE ID="9">"Now, </STYLE>Mifuyu-chan<STYLE ID="9">, let's go home to Motoki-cho with everyone. </STYLE>
{PAUSE ""}
<STYLE ID="9">Just a little more and all the </STYLE><STYLE ID="12" RUBY="しんし">divine messengers</STYLE><STYLE ID="9"> will be assembled."</STYLE><PG>
<STYLE ID="2">With everyone―</STYLE>
{PAUSE ""}
<STYLE ID="9">Eiichiro-san</STYLE><STYLE ID="2"> and I, together, to Motoki-cho.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">I've been chosen as a </STYLE><STYLE ID="13" RUBY="しんし">divine messenger</STYLE><STYLE ID="2">.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="10">The Princess</STYLE><STYLE ID="2"> has allowed me to meet the goddess.</STYLE><PG>
<STYLE ID="2">I don't understand at all what the two of them are saying.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">But... </STYLE>
