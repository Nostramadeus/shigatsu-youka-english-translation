<PG>
{STOPSND "BGM" "2000" "PASS"}
<STYLE ID="2">Kogori-senpai</STYLE><STYLE ID="1">'s head lifted high in her hands, </STYLE>Niimura-senpai<STYLE ID="1"> spoke to it quietly.</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
