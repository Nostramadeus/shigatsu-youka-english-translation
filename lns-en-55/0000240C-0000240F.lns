{MESON "500"}
<STYLE ID="3">Mom</STYLE>, huh.
{PAUSE ""}
<BR>
{PLAYSND "SE\携帯押す.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAIT "500" "CLICK" "SKIP"}
<STYLE ID="2">"Hello?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Hello, </STYLE><STYLE ID="2">Haruka</STYLE><STYLE ID="3">? Are you okay over there?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"Huh?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"You know, there was an incident, wasn't there?"</STYLE><PG>
<STYLE ID="2">"Oh, well... I'm fine..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"I see..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"What's wrong?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Nothing. It looks like I'll be late from work today. Will you be all right?"</STYLE><PG>
<STYLE ID="2">"I told you, I can look after the house fine. I'll lock up properly, too."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Make sure you do, okay? And don't stay out walking around too long, okay?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"I know already. </STYLE>
{PAUSE ""}
<STYLE ID="2">Yeah, bye."</STYLE><PG>
