{CHANGECG "人物1" "グラフィック\立ち絵\人物\エデン\フィオ\フィオ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="11">"Uh... well, now...?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="11">The transfer student</STYLE><STYLE ID="3">, seeing everyone's reaction, began to break out in a cold sweat.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Just as I thought, this is...!</STYLE><PG>
{PLAYSND "SE\椅子から立つ.ogg" "VOICE" "NORMAL" "1000" "0"}
{STOPSND "BGM" "0" "PASS"}
<STYLE ID="3">Unable to stand that impossible hunch, or this frozen air, any longer, I stood up.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">And then―!</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\sceneswitch2.ogg" "VOICE" "NORMAL" "1000" "0"}
{CHANGECG "000" "グラフィック\背景\エデン\なつみの教室ブラー.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "2000" "CLICK" "SKIP"}
{MESON "500"}
{QUAKE "メッセージボックス土台" "QUAKE" "1" "50" "50" "0" "30"}
<STYLE ID="19">"Oh, come ON!"</STYLE>
