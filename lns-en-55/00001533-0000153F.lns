;---------------------------------------
; BEGIN DECOMPILED SCRIPT
;---------------------------------------
<SCENARIO VER="105">
{WAIT "2000" "CLICK" "SKIP"}
{PLAYSND "僕らの日常.ogg" "BGM" "REPEAT" "1000" "0"}
{WAIT "3000" "CLICK" "SKIP"}
{CHANGECG "000" "グラフィック\背景\新村家廊下.gal" "NORMAL" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>"Okay, I'm off!"
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\なつみ母.gal" "NORMAL" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="1">"Be careful."</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\良治正面バストアップ.gal" "NORMAL" "#1" "C" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="2">"Yaaawn... have a good day."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Seen off by a bright-eyed </STYLE><STYLE ID="1">Mom</STYLE><STYLE ID="3"> and a still-sleepy </STYLE><STYLE ID="2">Dad</STYLE><STYLE ID="3">, I left home.</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\iron_door2_O.ogg" "VOICE" "NORMAL" "1000" "0"}
{DELETECG "000,人物1,人物2" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "SE\iron_door1_C.ogg" "VOICE" "NORMAL" "1000" "0"}
{CREATECG "000" "グラフィック\シナリオ\外廊下.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "SE\インターホン.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAIT "2000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="3">Early as it was, I pressed the intercom next door without a second thought.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Into the clear sky over quiet Motoki-cho, the faint sound of the intercom rang out.</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\iron_door2_O.ogg" "VOICE" "NORMAL" "1000" "0"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\美冬腰に手バストアップ.gal" "NORMAL" "#1" "R" "B" "0" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">"Oh my, </STYLE>Natsumi-chan<STYLE ID="4">! Morning, morning!"</STYLE>
{PAUSE ""}
<BR>
"Morning!
{PAUSE ""}
　Oh, your bandage is off!"
{PAUSE ""}
<BR>
<STYLE ID="4">"That's right! I put so much into it that time that I stabbed too deep!"</STYLE><PG>
<STYLE ID="3">At the moment, everyone had a cut on their arm.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">Erika-chan</STYLE><STYLE ID="3"> had put a medicinal herb for cuts on them, and it worked better than we'd imagined. Our injuries were healing steadily.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">It's only a matter of time before our injuries are completely healed.</STYLE><PG>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\春花頭かく.gal" "NORMAL" "#1" "L" "B" "0" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="6">"Aaah, I'm sleepy..."</STYLE>
{PAUSE ""}
<BR>
"Morning. Did you stay up late?"
{PAUSE ""}
<BR>
<STYLE ID="6">"No, it's, you know, entrance-exam studying..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">"</STYLE><STYLE ID="6">Haruka</STYLE><STYLE ID="4">'s got entrance exams this year! I'm going to drill her hard!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="6">"Man, I never figured </STYLE><STYLE ID="4">Mom</STYLE><STYLE ID="6"> for such a pushy education mom..."</STYLE><PG>
<STYLE ID="4">"I can't raise her in a way that would disappoint </STYLE><STYLE ID="7">Eiichiro-san</STYLE><STYLE ID="4">!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="6">"That's </STYLE><STYLE ID="8" RUBY="ひきょう">cheating</STYLE><STYLE ID="6">, saying that..."</STYLE>
{PAUSE ""}
<BR>
{PLAYSND "SE\iron_door2_O.ogg" "SE" "NORMAL" "1000" "0"}
<STYLE ID="3">Just then, the door to my apartment opened.</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物2" "グラフィック\立ち絵\人物\なつみ母腕組み.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="1">"</STYLE><STYLE ID="4">Mifuyu</STYLE><STYLE ID="1">, that's enough, it's only 6:30. Shouting like that is so middle-aged..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">"Oh my, </STYLE><STYLE ID="1">Akane</STYLE><STYLE ID="4">, morning, morning to you too!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">A second shrill greeting from </STYLE><STYLE ID="4">Obasan</STYLE><STYLE ID="3">.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">She seemed to have gotten even livelier since coming back from Arata.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">I leaned in close to </STYLE><STYLE ID="6">Haruka</STYLE><STYLE ID="3">'s ear.</STYLE><PG>
"You don't think <STYLE ID="4">Obasan</STYLE> used Droga or something?"
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物3" "グラフィック\立ち絵\人物\春花腕組みアップ.gal" "NORMAL" "#1" "C" "B" "100" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="6">"No, this is more like divine-messenger energy, isn't it?"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\美冬セクシー.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="4">"Oh, </STYLE><STYLE ID="1">Akane</STYLE><STYLE ID="4">, to stay young forever you have to be lively from the heart!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"No, that's not what I..."</STYLE><PG>
<STYLE ID="6">"</STYLE>Natsumi<STYLE ID="6">, let's get out while we can..."</STYLE>
{PAUSE ""}
<BR>
"Yup..."
{PAUSE ""}
<BR>
<STYLE ID="3">Slipping out from between a friendship of more than 40 years, </STYLE><STYLE ID="6">Haruka</STYLE><STYLE ID="3"> and I left the apartment building.</STYLE><PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\エレベーター前.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1,人物2,人物3" "1" "1000" "0" "0" "" "0"}
{PLAYSND "SE\エレベーター.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAIT "2000" "CLICK" "SKIP"}
{CHANGECG "000" "グラフィック\背景\エレベーター中.gal" "NORMAL" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{CHANGECG "000" "グラフィック\背景\マンション入り口.gal" "NORMAL" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{CHANGECG "000" "グラフィック\背景\マンション前.gal" "NORMAL" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\春花腕組み全身.gal" "NORMAL" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="6">"Mmm, the air's so good! Arata's nice too, but Motoki-cho's the best!"</STYLE>
{PAUSE ""}
<BR>
"<STYLE ID="6">Haruka</STYLE>, you've said that every day since we got back..."
{PAUSE ""}
<BR>
<STYLE ID="6">"The town you were born and raised in is dearer than anything!</STYLE>
{PAUSE ""}
<STYLE ID="6">　Right?"</STYLE>
{PAUSE ""}
<BR>
"Of course!"<PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\駐輪場.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1" "1" "1000" "0" "0" "" "0"}
{PLAYSND "SE\自転車開始.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAITPLAY "VOICE" "CLICK"}
{PLAYSND "SE\自転車開始.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAITPLAY "VOICE" "CLICK"}
{PLAYSND "SE\自転車こぐ.ogg" "SE" "REPEAT" "1000" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{CHANGECG "000" "グラフィック\背景\桜道.gal" "NORMAL" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{STOPSND "SE" "5000" "PASS"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="3">For us, with no club activities, leaving home at 6:30 was way too early.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">But today, there was something important we had to do.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">We rode our bikes down the row of cherry trees, showered from head to toe in a storm of cherry petals.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">It was already warm today, warm enough for short sleeves.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">The weather forecast said it would go over 25 degrees, despite the time of year.</STYLE><PG>
<STYLE ID="3">I really do love cherry blossoms.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">There are all kinds of memories, but still, I love this flower.</STYLE><PG>
<STYLE ID="3">To me, the cherry blossom is a special flower.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Through these cherry blossoms, I've learned about the happy things, the painful things, and the hard things too.</STYLE><PG>
<STYLE ID="3">Still, I can't even imagine now that this Motoki-cho almost sank into a forest of cherry trees.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">But now, I can't hear the voice of the cherry trees anymore.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">That proves what happened in Arata.</STYLE><PG>
<STYLE ID="6">"Hey, </STYLE>Natsumi<STYLE ID="6">! Want to come to Arata this summer vacation!?"</STYLE>
{PAUSE ""}
<BR>
"To Arata?"
{PAUSE ""}
<BR>
<STYLE ID="6">"Yeah, we had a rough time of it last time, but normally it's a nice, peaceful place. </STYLE>
{PAUSE ""}
<STYLE ID="6">Next time no memorial service or anything, just sightseeing."</STYLE>
{PAUSE ""}
<BR>
"Ha! Sounds great!
{PAUSE ""}
　I want to see <STYLE ID="9">Chiga-nee</STYLE> and <STYLE ID="10">Kana-chan</STYLE> too, and talk more with <STYLE ID="5">Erika-chan</STYLE>!"<PG>
<STYLE ID="6">"'</STYLE><STYLE ID="5">Erika-chan</STYLE><STYLE ID="6">,' she says... </STYLE>
{PAUSE ""}
<STYLE ID="5">Grandma</STYLE><STYLE ID="6">'s tastes really are young..."</STYLE>
{PAUSE ""}
<BR>
"I hope she stays healthy forever..."
{PAUSE ""}
<BR>
<STYLE ID="6">"Oh, that reminds me, </STYLE><STYLE ID="5">Grandma</STYLE><STYLE ID="6"> had a checkup the other day, just in case, and the blood vessels in her heart were apparently in a bad way. </STYLE>
{PAUSE ""}
<STYLE ID="6">But they caught it before any attack, so she should be fine."</STYLE><PG>
"I hope she takes good care of herself... 
{PAUSE ""}
Maybe the stress from the curse-killings got to her after all. 
{PAUSE ""}
But she only got the checkup because of that incident, right?
{PAUSE ""}
　In a way, maybe <STYLE ID="11">Shigatsu Youka</STYLE> saved her?"
{PAUSE ""}
<BR>
<STYLE ID="6">"Hahaha, well, it's all in how you look at it!</STYLE>
{PAUSE ""}
<STYLE ID="6">　Anyway, let's ask </STYLE><STYLE ID="12">Goto</STYLE><STYLE ID="6"> about summer vacation too. </STYLE><STYLE ID="12">She</STYLE><STYLE ID="6">'s got no friends anyway, so she's bound to be free."</STYLE><PG>
{STOPSND "BGM" "5000" "PASS"}
<STYLE ID="3">Before long, the cherry trees of Central Park came into view.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">But the park looked a little different from the one we were used to.</STYLE><PG>
{MESOFF "500"}
{DELETECG "000" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "環境音\quiet-residential-area1.ogg" "SE" "REPEAT" "1000" "0"}
{WAIT "3000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\シナリオ\公園.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\春花.gal" "NORMAL" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="6">"</STYLE><STYLE ID="12">Goto</STYLE><STYLE ID="6"> here yet?"</STYLE>
{PAUSE ""}
<BR>
"Oh, look, <STYLE ID="6">Haruka</STYLE>. <STYLE ID="12">Goto</STYLE>'s already here, isn't she?"
{PAUSE ""}
<BR>
<STYLE ID="3">A familiar bike was parked at the park entrance.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">This mini-size bike for riding to school was definitely </STYLE><STYLE ID="12">Goto</STYLE><STYLE ID="3">'s.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">I looked further in.</STYLE><PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\中央公園素材\中央公園背景1gal.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="12">Goto</STYLE><STYLE ID="3"> was standing there.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">And one more person, a girl in a Motoki High School uniform.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">But she soon stepped away from </STYLE><STYLE ID="12">Goto</STYLE><STYLE ID="3"> and left by a different exit.</STYLE><PG>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\五島挨拶バストアップ.gal" "NORMAL" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="12">"Oh, Senpai! Good morning!"</STYLE>
{PAUSE ""}
<BR>
"Morning, <STYLE ID="12">Goto</STYLE>. Who was that just now?"
{PAUSE ""}
<BR>
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島考えるバストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
<STYLE ID="12">"No idea... While I was standing here she asked me, 'Did the cherry tree here disappear?' </STYLE>
{PAUSE ""}
<STYLE ID="12">She left without giving her name, but she's not in my year."</STYLE><PG>
"Hmm."
{PAUSE ""}
<BR>
<STYLE ID="12">"I feel like I've seen her somewhere, though..."</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\春花腰に手1バストアップ.gal" "NORMAL" "#1" "L" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="6">"Well, never mind that, let's get started."</STYLE>
{PAUSE ""}
<BR>
"Okay."<PG>
<STYLE ID="12">Goto</STYLE><STYLE ID="3"> had been standing where that goshinboku used to be.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">But because of what happened, the goshinboku had apparently withered all of a sudden and crumbled to pieces.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">By now the tree had been completely removed, and there was no trace of it to be seen.</STYLE><PG>
<STYLE ID="3">It had caused a huge stir as an unexplained phenomenon, but that would probably die down before long.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Because of that stir, we had decided to gather today, this early in the morning, when there would be as few people around as possible.</STYLE><PG>
{PLAYSND "SE\swish.ogg" "VOICE" "NORMAL" "1000" "0"}
<STYLE ID="3">I took a handkerchief out of my bag.</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{STOPSND "SE" "5000" "PASS"}
{DELETECG "000,人物1,人物2" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="3">Then the three of us crouched down on the spot and gazed at what I had wrapped in the handkerchief.</STYLE><PG>
{MESOFF "500"}
{PLAYSND "エデンの桜\懐かしの里.ogg" "BGM" "REPEAT" "1000" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\背景\エデン\昔荒田\折れたかんざし.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="3">Out of the handkerchief came the broken hairpin.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="11">Itohime</STYLE><STYLE ID="3">'s remains had been lying right beside it.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="11">Itohime</STYLE><STYLE ID="3">'s last wish―that we bury the hairpin at the goshinboku where </STYLE><STYLE ID="6">Nii-sama</STYLE><STYLE ID="3"> sleeps.</STYLE><PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\中央公園素材\中央公園背景1gal.gal" "NORMAL" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="3">I picked up a stick lying nearby and dug a small hole.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">I gently laid the hairpin in the hole and covered it with earth.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Bathed in the rising morning sun, the three of us put our hands together.</STYLE><PG>
<STYLE ID="3">Please, be happy over there with </STYLE><STYLE ID="6">Nii-sama</STYLE><STYLE ID="3">.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">And if you feel like it, please come to Motoki-cho.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="11">Itohime</STYLE><STYLE ID="3"> suffered for 800 years. To make up for it, may the rest of her time be happy.</STYLE><PG>
"Hey, <STYLE ID="12">Goto</STYLE>, there's something I still don't understand. 
{PAUSE ""}
Why were <STYLE ID="7">Ojisan</STYLE>, <STYLE ID="13">Sakura-san</STYLE>, <STYLE ID="9">Chiga-nee</STYLE> and I needed back then?"
{PAUSE ""}
<BR>
<STYLE ID="3">She had said that the living one and the dead one of the first generation, and the living one and the dead one of the second generation, were needed as divine messengers.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">What on earth were we going to be used for?</STYLE><PG>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\五島うつむき.gal" "NORMAL" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="12">"I don't know the exact mechanism, but for </STYLE><STYLE ID="11">Shigatsu Youka</STYLE><STYLE ID="12"> to live forever, it probably needed spores produced inside those four bodies. </STYLE>
{PAUSE ""}
<STYLE ID="12">To build resistance to third-generation blood, a weakness far too deadly to call a weakness."</STYLE><PG>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\春花横顔逆.gal" "NORMAL" "#1" "L" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="6">"She did say she'd stretch her arms from Arata to Motoki-cho, right?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="12">"Once its arms reached Motoki-cho, all that was left was to suck up the land's nourishment and grow huge. </STYLE>
{PAUSE ""}
<STYLE ID="12">But that alone wouldn't let it live forever. </STYLE>
{PAUSE ""}
<STYLE ID="12">By absorbing the divine messengers, its final goal―</STYLE>
{PAUSE ""}
<STYLE ID="12">I think agelessness and deathlessness would at last be achieved."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="6">"This is all way too epic, I can't follow it... </STYLE>
{PAUSE ""}
{CHANGECG "人物2" "グラフィック\立ち絵\人物\春花腰に手1バストアップ.gal" "NORMAL" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
<STYLE ID="6">Well, none of that matters anymore."</STYLE>
{PAUSE ""}
<BR>
"Yeah..."<PG>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島バストアップ.gal" "NORMAL" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="12">"Well, it's only 6:50. What now? Head to school already?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="6">"School's not even open yet..."</STYLE>
{PAUSE ""}
<BR>
"Right! Then let's... 
{PAUSE ""}
{STOPSND "BGM" "0" "PASS"}
go to Zahha, it's open 24 hours!"
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物2" "グラフィック\立ち絵\人物\春花腕組み.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="6">"Rejected!</STYLE>
{PAUSE ""}
{PLAYSND "ごろごろゲームする日_2.ogg" "BGM" "REPEAT" "1000" "0"}
<STYLE ID="6">　We went through hell yesterday!"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島考えるバストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="12">"Five rounds of Russian-roulette takoyaki was a bit much, even for me..."</STYLE><PG>
"Come on, you're no fun..."
{PAUSE ""}
<BR>
<STYLE ID="6">"</STYLE>You<STYLE ID="6">, how many rounds of Russian-roulette takoyaki do you need before you're satisfied! You gambler!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="12">"</STYLE>Senpai<STYLE ID="12"> during Russian-roulette takoyaki is way scarier than </STYLE><STYLE ID="11">Shigatsu Youka</STYLE><STYLE ID="12">."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="6">"Agreed."</STYLE>
{PAUSE ""}
<BR>
"Hmph! Fine, no Russian-roulette takoyaki, so Zahha, okay?"<PG>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島挨拶バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="12">"Then I'm all for it!</STYLE>
{PAUSE ""}
<STYLE ID="12">　Hey, hey, </STYLE><STYLE ID="6">Niimura-senpai</STYLE><STYLE ID="12">! What are you treating me to today?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="6">"Are you stupid, you </STYLE><STYLE ID="12">hyena</STYLE><STYLE ID="6">!</STYLE>
{PAUSE ""}
<STYLE ID="6">　One ice cream, tops!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="12">"Oooh! I only said it as a joke, and she's really treating me...!"</STYLE>
{PAUSE ""}
<BR>
"<STYLE ID="6">Haruka</STYLE>, you're pretty soft on <STYLE ID="12">Goto</STYLE>, aren't you..."<PG>
{MESOFF "500"}
{STOPSND "BGM" "5000" "PASS"}
{DELETECG "000,人物1,人物2" "1" "5000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\背景\エデン\元木高校外観.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
