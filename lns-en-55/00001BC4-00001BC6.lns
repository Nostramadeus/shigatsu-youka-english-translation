;    0: TWdLink(count=991, event=, unk3=)
;---------------------------------------
; BEGIN DECOMPILED SCRIPT
;---------------------------------------
<SCENARIO VER="105">
{PLAYSND "BGM死月編\春の兆し.ogg" "BGM" "REPEAT" "1000" "0"}
{WAIT "2000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\背景\詫言編　夢から\新村本家居間.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>"<STYLE ID="1" RUBY="しろざき">Shirozaki</STYLE><STYLE ID="2">-san</STYLE>, you're in top form again this year..."
{PAUSE ""}
<BR>
<STYLE ID="3">"Fwahahahaha! </STYLE>Haruka-chan<STYLE ID="3">! A life without drinking is 80 percent wasted!"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\エリカバストアップ.gal" "NORMAL" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="4">"Now then, </STYLE><STYLE ID="1" RUBY="しろざき">Shirozaki</STYLE><STYLE ID="4">! Pestering a minor with your drinking?"</STYLE>
{PAUSE ""}
<BR>
"Hahaha, <STYLE ID="4">Grandma</STYLE>, it's fine, it's fine. I'm used to it by now."
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\幸太郎横顔.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="5">"Snorrrk! Snorrrk!"</STYLE>
{PAUSE ""}
<BR>
"<STYLE ID="5">Kotaro-san</STYLE>'s already passed out drunk, huh..."<PG>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\美冬腰に手バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="6">"Here you go, thanks for waiting! A gift from </STYLE><STYLE ID="1" RUBY="しろざき">Shirozaki</STYLE><STYLE ID="2">-san</STYLE><STYLE ID="6">: salt-grilled </STYLE><STYLE ID="7" RUBY="まかはどま">Makahadoma</STYLE><STYLE ID="6"> sweetfish!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Ooh, here it comes! Arata's specialty, midwinter </STYLE><STYLE ID="8" RUBY="まかはどま">Makahadoma</STYLE><STYLE ID="3"> sweetfish!</STYLE>
{PAUSE ""}
<STYLE ID="3">　Sweetfish fattened up plump by the cold, you can't eat those anywhere but here!"</STYLE>
{PAUSE ""}
<BR>
"<STYLE ID="2">You</STYLE> brought it as a gift, and <STYLE ID="2">you</STYLE>'re the first one eating it? 
{PAUSE ""}
Actually, what even is a Makahadoma?"<PG>
<STYLE ID="3">"</STYLE><STYLE ID="8" RUBY="まかはどま">Makahadoma</STYLE><STYLE ID="3">'s supposedly the harshest of Buddhism's eight cold hells!</STYLE>
{PAUSE ""}
<STYLE ID="3">　Ooh! Delicious, as expected!"</STYLE>
{PAUSE ""}
<BR>
"Arata's food sure has catastrophic names..."
{PAUSE ""}
<BR>
<STYLE ID="3">"I heard it was to make the place seem unappealing and keep outside invaders away, even a little. </STYLE>
{PAUSE ""}
<STYLE ID="3">Even Arata here almost got the name </STYLE><STYLE ID="9" RUBY="あまた">Amata</STYLE><STYLE ID="3"> at first, they say."</STYLE><PG>
"Huh. Arata does sound more like a barren place." [TN: Arata's kanji mean rough field; Amata's, heavenly field.]
{PAUSE ""}
<BR>
<STYLE ID="3">"By the way, where's </STYLE><STYLE ID="10">Chigaya-chan</STYLE><STYLE ID="3">? </STYLE><STYLE ID="10">She</STYLE><STYLE ID="3">'s finally turned 20, so I want to </STYLE><STYLE ID="11" RUBY="く">share</STYLE><STYLE ID="3"> a drink with her soon!"</STYLE>
{PAUSE ""}
<BR>
"Come to think of it, it looks like she went outside with <STYLE ID="12">Kana</STYLE> about an hour ago..."
{PAUSE ""}
<BR>
<STYLE ID="6">"A little while ago, </STYLE><STYLE ID="12">Kana-chan</STYLE><STYLE ID="6"> came back by herself!</STYLE>
{PAUSE ""}
<STYLE ID="6">　Looks like she went upstairs, though. Did something happen?"</STYLE><PG>
"She went upstairs without eating anything, with a New Year's feast like this...?
{PAUSE ""}
　And <STYLE ID="10">Chiga-nee</STYLE> still isn't back―"
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\幸太郎横顔.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="5">"Snorrrk! Snorrrk!"</STYLE><PG>
{MESOFF "500"}
{DELETECG "人物1" "1" "500" "0" "0" "" "0"}
{PLAYSND "SE\詫言編　夢から\ふすま.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAIT "2000" "CLICK" "SKIP"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\茅萱バストアップ.gal" "NORMAL" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="10">"Mm... I'm home. Sorry I'm late."</STYLE>
{PAUSE ""}
<BR>
"Speak of the devil. Welcome back, <STYLE ID="10">Chiga-nee</STYLE>. <STYLE ID="1" RUBY="しろざき">Shirozaki</STYLE><STYLE ID="2">-san</STYLE>'s been waiting for you this whole time!"
{PAUSE ""}
<BR>
<STYLE ID="3">"All right, come on, let's drink! You're an adult now!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="10">"Mm... Yes, I suppose I'll have some..."</STYLE><PG>
{STOPSND "BGM" "3000" "PASS"}
"<STYLE ID="10">Chiga-nee</STYLE>, what's wrong? You look pale."
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\エリカバストアップ.gal" "NORMAL" "#1" "L" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="4">"</STYLE><STYLE ID="10">Chigaya</STYLE><STYLE ID="4">, what's that cut on your neck?"</STYLE>
{PAUSE ""}
<BR>
"Oh, you're right! It looks like you got cut with a knife."
{PAUSE ""}
<BR>
{PLAYSND "BGM死月編\鬱蒼.ogg" "BGM" "REPEAT" "1000" "0"}
<STYLE ID="10">"Mm... It's nothing... </STYLE>
{PAUSE ""}
<STYLE ID="10">I found a wild hare, and I tried to hunt it with </STYLE><STYLE ID="12">Kana</STYLE><STYLE ID="10">, but it went wrong..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Fwahahaha! Even </STYLE><STYLE ID="10">Chigaya-chan</STYLE><STYLE ID="3"> can't take a wild hare with a knife, can she?"</STYLE><PG>
<STYLE ID="10">"Mm... Y-yes, I suppose not. </STYLE>
{PAUSE ""}
<STYLE ID="10">Besides, living in Tokyo has probably made me a bit rusty..."</STYLE>
{PAUSE ""}
<BR>
"Huh? Where's <STYLE ID="6">Mom</STYLE>?"
{PAUSE ""}
<BR>
<STYLE ID="10">"Mm... I passed her in the hallway just now. It looked like she was going upstairs."</STYLE>
{PAUSE ""}
<BR>
"Upstairs means... she's with <STYLE ID="12">Kana</STYLE>?"
{PAUSE ""}
<BR>
<STYLE ID="5">"Snorrrk! Snorrrk!"</STYLE>
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{MESOFF "500"}
{STOPSND "BGM" "3000" "PASS"}
{DELETECG "人物1,000,人物2" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
<PG>
{}
<EVENT VALUE="MESEND">
