{MESON "500"}
<STYLE ID="3">"Y-you </STYLE><STYLE ID="2">damn brat</STYLE><STYLE ID="3">! Where'd you pop out from!?"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
