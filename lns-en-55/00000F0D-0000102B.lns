{MESON "500"}
<STYLE ID="10">"So, </STYLE><STYLE ID="7">Ise-san, Ise-san</STYLE><STYLE ID="10">!</STYLE>
{PAUSE ""}
<STYLE ID="10">　You're still not going out with </STYLE><STYLE ID="6">Kana-chan</STYLE><STYLE ID="10">!?"</STYLE>
