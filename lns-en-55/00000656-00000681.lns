{STOPSND "SE" "3000" "PASS"}
{DELETECG "000,人物1" "1" "3000" "0" "0" "" "0"}
{MESON "500"}
<STYLE ID="3">Now I'm going to the </STYLE><STYLE ID="9" RUBY="あらた">Arata</STYLE><STYLE ID="3"> settlement.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Haruka</STYLE><STYLE ID="3">... </STYLE>
{PAUSE ""}
<STYLE ID="3">the real witch... </STYLE>
{PAUSE ""}
<STYLE ID="3">and the shinigami. I'm going to meet them.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">The incident 2 years ago was only the tip of the iceberg.</STYLE>
{PAUSE ""}
<BR>
<BR>
<STYLE ID="3"><TXSPS>The incident still </STYLE>
