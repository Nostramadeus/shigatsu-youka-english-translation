<SCENARIO VER="105">
{MESON "500"}
<TXSPN>"Who...?"
{PAUSE ""}
<BR>
<STYLE ID="1">...But there was no answer.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">A woman's voice I had never heard before, with something childlike in it.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">I put on sandals and went down into the garden.</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\詫言編　夢から\dark_attack.ogg" "VOICE" "NORMAL" "1000" "0"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\幸太郎幽霊.gal" "WAIT" "#1" "L" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1" "1" "3000" "0" "0" "" "0"}
{MESON "500"}
"!!?"
{PAUSE ""}
<BR>
<STYLE ID="1">There it is again! I'm definitely not seeing things!</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Is it really </STYLE><STYLE ID="2">Ojisan</STYLE><STYLE ID="1">'s ghost...?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Off toward the back, I had clearly seen the shape of </STYLE><STYLE ID="2">Ojisan</STYLE><STYLE ID="1">.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Ojisan</STYLE><STYLE ID="1">'s ghost, and a woman's voice...</STYLE><PG>
{MESOFF "500"}
{DELETECG "000,111" "1" "3000" "0" "0" "" "0"}
{MESON "500"}
<STYLE ID="1">I closed my eyes and listened closely to the voice of the wind.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">............</STYLE>
{PAUSE ""}
<STYLE ID="1">............</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">But no answer came from the wind at all.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">That probably meant there was no danger.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">I walked toward the spot where I had seen </STYLE><STYLE ID="2">Ojisan</STYLE><STYLE ID="1">.</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\砂利を歩く.ogg" "VOICE" "NORMAL" "1000" "0"}
{CHANGECG "111" "グラフィック\背景\詫言編　夢から\新村本家庭夜2.gal" "WAIT" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "2000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="1">―</STYLE><STYLE ID="2">Ojisan</STYLE><STYLE ID="1"> had been somewhere around here.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">But there wasn't anything in particular here.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">What on earth had </STYLE><STYLE ID="2">Ojisan</STYLE><STYLE ID="1"> been doing here...?</STYLE><PG>
{}
<EVENT VALUE="MESEND">
