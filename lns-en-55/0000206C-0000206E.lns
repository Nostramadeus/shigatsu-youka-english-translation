{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="1">"Yeah... yeah... </STYLE>
{PAUSE ""}
<STYLE ID="1">I was with a guy?</STYLE>
{PAUSE ""}
<STYLE ID="1">　Ha ha, that was a customer from my part-time job. </STYLE>
{PAUSE ""}
<STYLE ID="1">Yeah... yeah... </STYLE>
{PAUSE ""}
<STYLE ID="1">You want to meet now?</STYLE>
{PAUSE ""}
<STYLE ID="1">　Shinji-kun, you'll come over?</STYLE>
{PAUSE ""}
