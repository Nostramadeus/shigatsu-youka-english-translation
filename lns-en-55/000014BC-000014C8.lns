<EVENT VALUE="STOPMOVIE">
{MESON "500"}
<STYLE ID="7">"</STYLE><STYLE ID="1">Obasan</STYLE><STYLE ID="7">! Do you have Noh masks and red robes!?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"Wh-what's gotten into you all of a sudden?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="7">"I need Noh masks and red robes!"</STYLE><PG>
{MESOFF "500"}
{STOPSND "BGM" "500" "PASS"}
