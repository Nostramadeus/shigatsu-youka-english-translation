<SCENARIO VER="105">
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "SE\電話呼び出し.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAIT "2000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\背景\ザッハ夕方.gal" "NORMAL" "#1" "C" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "アイテム1" "グラフィック\立ち絵\アイテム\スマフォ黄入.gal" "NORMAL" "#1" "650" "C" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>"<STYLE ID="1">Senpai</STYLE>, pick up, quick...!"<PG>
{STOPSND "SE" "0" "PASS"}
"Hello, <STYLE ID="1">Senpai</STYLE>!? Um... 
{PAUSE ""}
Um...!"
{PAUSE ""}
<BR>
<STYLE ID="1">"</STYLE>Goto<STYLE ID="1">? What's wrong?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">The strangely calm voice of </STYLE><STYLE ID="1">Senpai</STYLE><STYLE ID="2">.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">If anything, I'm the one who needs to calm down.</STYLE><PG>
"<STYLE ID="1">Senpai</STYLE>, where are you right now!?"<PG>
{STOPSND "BGM" "0" "PASS"}
{PLAYSND "環境音\駅ホーム.ogg" "SE" "REPEAT" "1000" "0"}
{CHANGECG "000" "グラフィック\背景\元木駅夕方.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "アイテム1" "1" "0" "0" "0" "" "0"}
<STYLE ID="1">"At Motoki Station right now. I'm about to get on a train with </STYLE><STYLE ID="3">Haruka</STYLE><STYLE ID="1">."</STYLE>
{PAUSE ""}
<BR>
{CHGVOL "SE" "500" "0" "PASS"}
{CHANGECG "000" "グラフィック\背景\ザッハ夕方.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "アイテム1" "グラフィック\立ち絵\アイテム\スマフォ黄入.gal" "WAIT" "#1" "650" "C" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
"With <STYLE ID="3">Niimura-senpai</STYLE>, on a train!? 
{PAUSE ""}
　You can't! <STYLE ID="1">Senpai</STYLE>, please go to the police right away! I'll go too!"<PG>
<STYLE ID="1">"Sorry, </STYLE>Goto<STYLE ID="1">... I can't go to the police."</STYLE>
{PAUSE ""}
<BR>
"What are you saying! <STYLE ID="1">Senpai</STYLE>, it's dangerous! <STYLE ID="3">Niimura-senpai</STYLE> is... 
{PAUSE ""}
<STYLE ID="3">Niimura-senpai</STYLE> is...!"
{PAUSE ""}
<BR>
<STYLE ID="2">I pleaded desperately, but for some reason it didn't feel like my voice was reaching her.</STYLE>
{PAUSE ""}
<BR>
{PLAYSND "ネジの壊れたロボット.ogg" "BGM" "REPEAT" "1000" "0"}
<STYLE ID="1">"</STYLE>Goto<STYLE ID="1">, you're kind. Me, I really love you for being like that, </STYLE>Goto<STYLE ID="1">. Thanks. I'm sure we'll see each other again."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">At first I had thought </STYLE><STYLE ID="1">Senpai</STYLE><STYLE ID="4">'s voice was calm, but somehow </STYLE><STYLE ID="2">it also sounded a little sad.</STYLE><PG>
"Then I'll come to where you are too, <STYLE ID="1">Senpai</STYLE>! 
{PAUSE ""}
　Wait for me, plea―"<BR>
<STYLE ID="1">"Sorry, the train's here. I'm hanging up."</STYLE>
{PAUSE ""}
<BR>
"Please wait! The one who died in the incident is <STYLE ID="1">Senpai</STYLE>'s...!"<BR>
{PLAYSND "SE\電話切れる.ogg" "VOICE" "NORMAL" "1000" "0"}
{PAUSE ""}
<STYLE ID="2">The call was cut off.</STYLE>
{PAUSE ""}
<BR>
"<STYLE ID="1">Senpai</STYLE>..."
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{}
<EVENT VALUE="MESEND">
