<SCENARIO VER="105">
{WAIT "3000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>First, we would like you to take a look at this.
{PAUSE ""}
<BR>
Pay particular attention to the sound.<PG>
{MESOFF "500"}
{CREATECG "000" "グラフィック\リファレンス用\背景\アポカリ動画導入.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{PLAYMOVIE "アポカリ.wmv" "256" "C" "C" "NORMAL" "FALSE" "0" "255"}
{DELETECG "000" "1" "0" "0" "0" "" "0"}
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{}
<EVENT VALUE="MESEND">
