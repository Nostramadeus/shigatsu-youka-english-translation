<SCENARIO VER="105">
{CREATECG "000" "グラフィック\背景\ザッハ中.gal" "NORMAL" "#1" "C" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\五島バストアップ.gal" "WAIT" "#1" "R" "B" "0" "1" "2000" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>Natsumi<STYLE ID="1"> dashed to the restroom just as </STYLE><STYLE ID="2">Goto</STYLE><STYLE ID="1"> came back.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"Oh, </STYLE><STYLE ID="3">Niimura-senpai</STYLE><STYLE ID="2">, you won!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Yeah... I didn't win by luck alone... I won by skill!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">As of today, I proclaim it:</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">I, who defeated Fury Girl </STYLE>Natsumi Kogori<STYLE ID="1"> and Genius Girl </STYLE><STYLE ID="2">Erina Goto</STYLE><STYLE ID="1">―</STYLE>
{PAUSE ""}
<STYLE ID="1">am Prodigy Girl </STYLE><STYLE ID="3">Haruka Niimura</STYLE><STYLE ID="1">!</STYLE>
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{}
<EVENT VALUE="MESEND">
