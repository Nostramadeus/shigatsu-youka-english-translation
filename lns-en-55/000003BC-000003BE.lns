<SCENARIO VER="105">
{CREATECG "0000" "グラフィック\リファレンス\リファレンス詳細\rrr84\盗難車.gal" "NORMAL" "#1" "C" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\伊勢眠い.gal" "WAIT" "#1" "R" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>"<STYLE ID="1">Assistant Inspector Ise</STYLE>, excuse me, but..."<PG>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\伊勢バストアップ.gal" "WAIT" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="1">"Mm... </STYLE>
{PAUSE ""}
<STYLE ID="1">Oh, sorry. What is it?"</STYLE>
{PAUSE ""}
<BR>
"A stolen-car report just came in..."
{PAUSE ""}
<BR>
<STYLE ID="1">"A stolen car? Here in Motoki-cho?</STYLE>
{PAUSE ""}
<STYLE ID="1">　Rare things do happen."</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\紙ペラ.ogg" "VOICE" "NORMAL" "1000" "0"}
{CREATECG "アイテム1" "グラフィック\立ち絵\アイテム\手紙.gal" "WAIT" "#1" "600" "B" "100" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\伊勢考えるバストアップ.gal" "WAIT" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="1">"A white minivan, a vehicle for setting up the food stalls at Central Park... </STYLE>
{PAUSE ""}
<STYLE ID="1">They sure stole a conspicuous one."</STYLE>
{PAUSE ""}
<BR>
"<STYLE ID="1">Assistant Inspector</STYLE>, let's go out and search first thing tomorrow."<PG>
{MESOFF "500"}
{PLAYSND "SE\紙ペラ.ogg" "VOICE" "NORMAL" "1000" "0"}
{DELETECG "アイテム1" "1" "500" "0" "0" "" "0"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\伊勢バストアップ.gal" "WAIT" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="1">"What are you saying! We search right now!</STYLE>
{PAUSE ""}
<STYLE ID="1">　The person it was stolen from must be in trouble!"</STYLE>
{PAUSE ""}
<BR>
"Hold on... <STYLE ID="1">Assistant Inspector</STYLE>, you've been working too hard lately. 
{PAUSE ""}
You should rest a little..."
{PAUSE ""}
<BR>
<STYLE ID="1">"If we don't steadily clear up small cases like this one... </STYLE>
{PAUSE ""}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\伊勢眠い.gal" "NORMAL" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
<STYLE ID="1">Mm... damn..."</STYLE><PG>
"See, you've barely slept, have you? 
{PAUSE ""}
Besides, even if we search now, it's impossible at this hour."
{PAUSE ""}
<BR>
<STYLE ID="1">"Mm... all right... </STYLE>
{PAUSE ""}
<STYLE ID="1">Damn... and I work all the time for moments like this..."</STYLE>
{PAUSE ""}
<BR>
―You just always work too hard, that's all.
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{MESOFF "500"}
{DELETECG "0000,人物1,アイテム1" "1" "2000" "0" "0" "" "0"}
<PG>
{}
<EVENT VALUE="MESEND">
