;    1: TDecorate(count=70, unk2=16757864, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    2: TDecorate(count=2, unk2=8388863, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    3: TDecorate(count=2, unk2=5265653, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    4: TDecorate(count=2, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=どうこく, unk10=4294967295, unk11=4294967295)
; Display conditions:
;    0: TWdCondition(count=788, target=)
; Links:
;    0: TWdLink(count=687, event=, unk3=)
;---------------------------------------
; BEGIN DECOMPILED SCRIPT
;---------------------------------------
<SCENARIO VER="105">
{PLAYSND "最後の声・真呪殺\夕焼け.ogg" "BGM" "REPEAT" "1000" "0"}
{WAIT "3000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPS>Sway, sway...
{PAUSE ""}
<BR>
Sway, sway...
{PAUSE ""}
<BR>
My body is swaying back and forth.
{PAUSE ""}
<BR>
I wake up from my sleep.<PG>
<TXSPN>I'm being held?
{PAUSE ""}
<BR>
Who's holding me?
{PAUSE ""}
<BR>
I've only just managed to start crawling.
{PAUSE ""}
<BR>
I don't understand words, and I can't talk either.<PG>
But, but, I can tell how the person holding me right now is feeling.
{PAUSE ""}
<BR>
The one holding me right now is... 
{PAUSE ""}
Yeah, it's <STYLE ID="1">my big sister</STYLE>.
{PAUSE ""}
<BR>
Not <STYLE ID="2">Mommy</STYLE> or <STYLE ID="3">Daddy</STYLE>, but <STYLE ID="1">my big sister</STYLE>.
{PAUSE ""}
<BR>
My very kind <STYLE ID="1">big sister</STYLE>.
{PAUSE ""}
<BR>
My <STYLE ID="1">big sister</STYLE>, who I love so much.<PG>
Where am I?
{PAUSE ""}
<BR>
{PLAYSND "環境音\渓流.ogg" "SE2" "REPEAT" "0" "0"}
{CHGVOL "SE2" "800" "3000" "PASS"}
The sound of water?
{PAUSE ""}
<BR>
{PLAYSND "環境音\春の山.ogg" "SE" "REPEAT" "0" "0"}
{CHGVOL "SE" "800" "3000" "PASS"}
Birds singing?
{PAUSE ""}
<BR>
Am I... up in the mountains?
{PAUSE ""}
<BR>
Is there a river nearby?<PG>
No, that's not all.
{PAUSE ""}
<BR>
I can hear a voice.
{PAUSE ""}
<BR>
<STYLE ID="1">My big sister</STYLE>'s voice.
{PAUSE ""}
<BR>
{PLAYSND "最後の声・真呪殺\SE\夏菜泣き声.ogg" "VOICE" "REPEAT" "0" "0"}
{CHGVOL "VOICE" "1000" "5000" "PASS"}
<STYLE ID="1">My big sister</STYLE> is loudly―crying?<PG>
Holding me in her arms, <STYLE ID="1">my big sister</STYLE> is crying in the mountains, by the river, all by herself.
{PAUSE ""}
<BR>
What's wrong, <STYLE ID="1">Sis</STYLE>? Are you scared? Are you lonely?
{PAUSE ""}
<BR>
I don't like it when <STYLE ID="1">you</STYLE>'re sad.<PG>
Yeah, it's okay. Right now, you can lean on me.
{PAUSE ""}
<BR>
<STYLE ID="1">My big sister</STYLE> hugs me tight and leans on me.
{PAUSE ""}
<BR>
I can't hug her back, but if holding me tight makes her sadness fade even a little...
{PAUSE ""}
<BR>
But, <STYLE ID="1">Sis</STYLE>, why are you crying?<PG>
―!!
{PAUSE ""}
<BR>
I see.
{PAUSE ""}
<BR>
Right.
{PAUSE ""}
<BR>
Anyone would want to cry.
{PAUSE ""}
<BR>
You shouldn't have looked.
{PAUSE ""}
<BR>
I shouldn't have looked either.<PG>
'Cause... there's nothing sadder than this.
{PAUSE ""}
<BR>
<STYLE ID="1">Sis</STYLE>, I'm sorry.
{PAUSE ""}
<BR>
I want to let you lean on me, but―
{PAUSE ""}
<BR>
My sadness has reached its limit too.<PG>
{STOPSND "VOICE" "5000" "PASS"}
{STOPSND "SE" "5000" "PASS"}
{STOPSND "SE2" "5000" "PASS"}
<STYLE ID="1">My big sister</STYLE>'s <STYLE ID="4" RUBY="どうこく">wailing</STYLE> and mine spread over the whole mountain.
{PAUSE ""}
<BR>
<STYLE ID="1">My big sister</STYLE> will probably remember this sadness and never forget it, ever.
{PAUSE ""}
<BR>
Little as I am, I won't even be able to remember this sadness. I'll probably forget it right away.<PG>
Soon I'll cry myself out, fall asleep, forget everything―
{PAUSE ""}
<BR>
And I'll probably keep on searching, crawling.
{PAUSE ""}
<BR>
Forever.
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{MESOFF "500"}
{STOPSND "BGM" "3000" "PASS"}
{WAIT "4000" "CLICK" "SKIP"}
<PG>
{}
<EVENT VALUE="MESEND">
;---------------------------------------
; END DECOMPILED SCRIPT
;---------------------------------------