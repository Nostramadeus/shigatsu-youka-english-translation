{MESON "500"}
<STYLE ID="4">"</STYLE><STYLE ID="3">Niimura-senpai</STYLE><STYLE ID="4">... Between </STYLE><STYLE ID="9">Obaasan</STYLE><STYLE ID="4"> and </STYLE><STYLE ID="1">Chiga-nee</STYLE><STYLE ID="4">... </STYLE>
{PAUSE ""}
