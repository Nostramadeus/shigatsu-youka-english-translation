; BEGIN DECOMPILED SCRIPT
;---------------------------------------
<SCENARIO VER="105">
{PLAYSND "エデンの桜\箱からの脱出.ogg" "BGM" "REPEAT" "1000" "0"}
{WAIT "2000" "CLICK" "SKIP"}
{PLAYSND "エデンの桜\SE\砂利を走る2人.ogg" "VOICE" "REPEAT" "0" "0"}
{CHGVOL "VOICE" "1000" "3000" "PASS"}
{WAIT "3000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\リファレンス用\背景\林走る夜.gal" "NORMAL" "#1" "C" "B" "0" "32" "500" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CHGVOL "VOICE" "800" "5000" "PASS"}
<TXSPN>"<STYLE ID="1">Mom</STYLE>! That's one huge fire!"
{PAUSE ""}
<BR>
<STYLE ID="1">"Don't tell me the settlement's going to be wiped out...!</STYLE>
{PAUSE ""}
<STYLE ID="1">　</STYLE><STYLE ID="2">Eiichiro-san's</STYLE><STYLE ID="1"> hometown...!"</STYLE>
{PAUSE ""}
<BR>
"<STYLE ID="1">Mom</STYLE>, you go back to <STYLE ID="3" RUBY="いとひめやま">Mount Itohime</STYLE>! If outsiders come because of this fire, you're gonna get arrested!"<PG>
<STYLE ID="1">"Either way, this whole area is going to be searched!</STYLE>
{PAUSE ""}
<STYLE ID="1">　So I'll think of a way to put out the fire!"</STYLE>
{PAUSE ""}
<BR>
"Can that even be put out...!?"
{PAUSE ""}
<BR>
<STYLE ID="1">"I can't just leave it. </STYLE>
{PAUSE ""}
<STYLE ID="1">I'll go to the settlement, so </STYLE>Haruka<STYLE ID="1">, you head for the graveyard clearing!"</STYLE><PG>
"Why the graveyard clearing?"
{PAUSE ""}
<BR>
<STYLE ID="1">"There are no trees there, so the fire shouldn't spread easily. </STYLE>
{PAUSE ""}
<STYLE ID="1">I'll lead everyone there, so </STYLE>Haruka<STYLE ID="1">, you make sure the graveyard clearing is safe!"</STYLE>
{PAUSE ""}
<BR>
"Got it!"
{PAUSE ""}
<BR>
<STYLE ID="1">"Then let's split up here."</STYLE><PG>
"<STYLE ID="1">Mom</STYLE>!"
{PAUSE ""}
<BR>
<STYLE ID="1">"Hm?"</STYLE>
{PAUSE ""}
<BR>
"I got stronger, right?"
{PAUSE ""}
<BR>
<STYLE ID="1">"Yes. You may not match </STYLE><STYLE ID="4">Chigaya-chan</STYLE><STYLE ID="1"> or </STYLE><STYLE ID="5">Kana-chan</STYLE><STYLE ID="1">, but even so, you've become a fine woman of Arata."</STYLE>
{PAUSE ""}
<BR>
"Heh, I'm not planning to beat those <STYLE ID="6" RUBY="ましら">monkeys</STYLE>!
{PAUSE ""}
　See you, <STYLE ID="1">Mom</STYLE>!"<PG>
{MESOFF "500"}
{STOPSND "BGM" "3000" "PASS"}
{STOPSND "VOICE" "3000" "PASS"}
{DELETECG "000" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="1">"</STYLE>Haruka<STYLE ID="1">... </STYLE>
{PAUSE ""}
<STYLE ID="1">I'm sorry. </STYLE>Haruka<STYLE ID="1">, you've been through </STYLE><STYLE ID="7" RUBY="さんろう">the mountain seclusion</STYLE><STYLE ID="1"> long enough. </STYLE>
{PAUSE ""}
<STYLE ID="1">You can... go back to the world you came from now. </STYLE>
{PAUSE ""}
<STYLE ID="1">If I'm gone, </STYLE>Haruka<STYLE ID="1">, you'll be free."</STYLE><PG>
{MESOFF "500"}
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "環境音\火事.ogg" "SE" "REPEAT" "1000" "0"}
{WAIT "2000" "CLICK" "SKIP"}
{PLAYMOVIE "火の粉.wmv" "256" "C" "C" "REPEAT" "FALSE" "200" "0"}
<EVENT VALUE="MOTION\r\n789\r\nムービー\r\n11\r\n50\r\n3000\r\nNORMAL\r\nPASS">
{CREATECG "000" "グラフィック\リファレンス用\背景\荒田火事美冬なし.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
<EVENT VALUE="MOTION\r\n789\r\nムービー\r\n11\r\n50\r\n0\r\nNORMAL\r\nPASS">
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="8">What enormous flames...</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="8">There's no saving this now...</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="8">But this is as far as I go, too.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="8">I, too, in this land where </STYLE><STYLE ID="2">Eiichiro-san</STYLE><STYLE ID="8"> sleeps, just like this―</STYLE><PG>
{MESOFF "500"}
{PLAYSND "最後の声・真呪殺\SE\銃声6発.ogg" "VOICE" "NORMAL" "700" "0"}
{WAITPLAY "VOICE" "CLICK"}
{PLAYSND "最後の声・真呪殺\SE\銃声6発.ogg" "VOICE" "NORMAL" "700" "0"}
{WAITPLAY "VOICE" "CLICK"}
{MESON "500"}
<STYLE ID="1">"Gunshots...?</STYLE>
{PAUSE ""}
<STYLE ID="1">　What was that? It came from where </STYLE>Haruka<STYLE ID="1"> went."</STYLE>
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{MESOFF "500"}
{STOPSND "SE" "3000" "PASS"}
<EVENT VALUE="MOTION\r\n789\r\nムービー\r\n11\r\n0\r\n3000\r\nNORMAL\r\nPASS">
{DELETECG "000" "1" "3000" "0" "0" "" "0"}
<EVENT VALUE="STOPMOVIE">
{WAIT "1000" "CLICK" "SKIP"}
<PG>
{}
<EVENT VALUE="MESEND">
