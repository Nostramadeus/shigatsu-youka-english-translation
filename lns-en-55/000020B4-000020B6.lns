;---------------------------------------
; BEGIN DECOMPILED SCRIPT
;---------------------------------------
<SCENARIO VER="105">
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "BGM死月編\Erica.ogg" "BGM" "REPEAT" "1000" "0"}
{WAIT "2000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\背景\詫言編　夢から\新村本家居間.gal" "NORMAL" "#1" "C" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\茅萱バストアップ.gal" "NORMAL" "#1" "R" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜バストアップ.gal" "NORMAL" "#1" "L" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>"Mm... How's <STYLE ID="1">Haruka</STYLE> doing?"
{PAUSE ""}
<BR>
<STYLE ID="2">"The funeral's starting soon, but we'd better leave her alone for a little while."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Hey, </STYLE><STYLE ID="2">Mommy</STYLE><STYLE ID="3">, can't you talk to </STYLE><STYLE ID="1">Haruka-chan</STYLE><STYLE ID="3"> and cheer her up?"</STYLE><PG>
<STYLE ID="2">"</STYLE><STYLE ID="3">Kana</STYLE><STYLE ID="2">, I know how you feel, but..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"But the way she is, </STYLE><STYLE ID="1">Haruka-chan</STYLE><STYLE ID="3"> won't come out until </STYLE><STYLE ID="4">Auntie</STYLE><STYLE ID="3"> is buried, will she?</STYLE>
{PAUSE ""}
<STYLE ID="3">　She'll never get to see </STYLE><STYLE ID="4">Auntie's</STYLE><STYLE ID="3"> face again, right?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"You're right... Not getting to see her face one last time might be something she'd regret. </STYLE>
{PAUSE ""}
<STYLE ID="2">All right, I'll go see her."</STYLE><PG>
{MESOFF "500"}
{DELETECG "000,人物1,人物2" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "SE\ノック.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAITPLAY "VOICE" "CLICK"}
{MESON "500"}
<STYLE ID="2">"</STYLE><STYLE ID="1">Haruka</STYLE><STYLE ID="2">, I'm coming in, okay?"</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\詫言編　夢から\ふすま.ogg" "VOICE" "NORMAL" "1000" "0"}
{CREATECG "000" "グラフィック\背景\詫言編　夢から\新村本家2階.gal" "NORMAL" "#1" "C" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\春花うつむき.gal" "NORMAL" "#1" "R" "B" "0" "2" "2000" "960" "1" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="1">"............"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"Hey, </STYLE><STYLE ID="1">Haruka</STYLE><STYLE ID="2">, could we talk for a bit?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"</STYLE><STYLE ID="2">Sakura-san</STYLE><STYLE ID="1">... </STYLE>
{PAUSE ""}
<STYLE ID="1">Why did </STYLE><STYLE ID="4">Mom</STYLE><STYLE ID="1"> suffer?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"............"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"</STYLE><STYLE ID="4">Mom</STYLE><STYLE ID="1">... something about the way she moved wasn't human. </STYLE>
{PAUSE ""}
<STYLE ID="1">Is that what killed her...?"</STYLE><PG>
<STYLE ID="2">"That's..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"Did </STYLE><STYLE ID="4">Mom</STYLE><STYLE ID="1"> sell her soul to the devil or something...? </STYLE>
{PAUSE ""}
<STYLE ID="5">Natsumi's dad</STYLE><STYLE ID="1">―she even went and killed him."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"</STYLE><STYLE ID="1">Haruka</STYLE><STYLE ID="2">... I'm sorry..."</STYLE>
{PAUSE ""}
<BR>
{CHANGECG "人物1" "グラフィック\立ち絵\人物\春花バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
<STYLE ID="1">"Why are you apologizing, </STYLE><STYLE ID="2">Sakura-san</STYLE><STYLE ID="1">...?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"The responsibility is mine, too."</STYLE><PG>
<STYLE ID="1">"I see..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"10 years ago, I―"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"</STYLE><STYLE ID="2">Sakura-san</STYLE><STYLE ID="1">, it's okay. It's okay now. </STYLE>
{PAUSE ""}
<STYLE ID="2">Sakura-san</STYLE><STYLE ID="1">, I don't know what you did, but talking about 10 years ago won't bring </STYLE><STYLE ID="4">Mom</STYLE><STYLE ID="1"> back to life."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"............"</STYLE><PG>
<STYLE ID="1">"Everyone who gets involved with me ends up unhappy, don't they..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"That's... not true..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"No, it really is true. Because I'm weak... </STYLE>
{PAUSE ""}
<STYLE ID="1">That's gotta be why </STYLE><STYLE ID="4">Mom</STYLE><STYLE ID="1"> ended up like that too."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"............"</STYLE><PG>
<STYLE ID="1">"Hey, </STYLE><STYLE ID="2">Sakura-san</STYLE><STYLE ID="1">, it's okay for me to live here, right?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"Huh? Yes, of course."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"I've been thinking. </STYLE>
{PAUSE ""}
<STYLE ID="1">In that case, I can't go causing trouble for this settlement. </STYLE>
{PAUSE ""}
<STYLE ID="1">I can't stay as weak as I am now. </STYLE>
{PAUSE ""}
<STYLE ID="1">So..."</STYLE><PG>
<STYLE ID="1">"I'm going to do the mountain seclusion."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"The mountain seclusion!?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"It's the duty of every woman who lives in Arata, right? I'll do it too."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"But that's just a hollow ritual now... </STYLE>
{PAUSE ""}
<STYLE ID="6">Mother</STYLE><STYLE ID="2"> seemed to want </STYLE><STYLE ID="4">Mifuyu-chan</STYLE><STYLE ID="2"> to be the last, too."</STYLE><PG>
<STYLE ID="1">"No, it's not because it's a ritual. </STYLE>
{PAUSE ""}
<STYLE ID="1">I want to train myself. </STYLE>
{PAUSE ""}
<STYLE ID="1">I don't want to be some weakling who does nothing but whine forever."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"</STYLE><STYLE ID="1">Haruka</STYLE><STYLE ID="2">, just being able to say that already makes you strong enough."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"I'm the one who can't accept it! </STYLE><STYLE ID="4">Mom</STYLE><STYLE ID="1"> carried that burden alone ever since </STYLE><STYLE ID="7">Dad</STYLE><STYLE ID="1"> died!</STYLE>
{PAUSE ""}
<STYLE ID="1">　If I'd been strong, this never would have...!"</STYLE><PG>
<STYLE ID="2">"............"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"I want to be strong. I want to get stronger and be of use to the people I care about."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"The mountain seclusion... I really don't recommend it.</STYLE>
{PAUSE ""}
<STYLE ID="2">　Are you really going to do it anyway?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"Yeah. Once </STYLE><STYLE ID="4">Mom's</STYLE><STYLE ID="1"> funeral is over, I'll do it. </STYLE>
{PAUSE ""}
<STYLE ID="1">And also..."</STYLE><PG>
<STYLE ID="1">"Also, I don't want you contacting anyone in Motoki-cho. When the mountain seclusion's over, I'll get in touch myself. </STYLE>
{PAUSE ""}
<STYLE ID="1">I'm not planning to see anyone until I'm satisfied with myself."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"Don't push yourself too hard, all right? You can come back here anytime."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"Thanks, </STYLE><STYLE ID="2">Sakura-san</STYLE><STYLE ID="1">. </STYLE>
{PAUSE ""}
<STYLE ID="1">Well... let's go to the funeral. It's no good if I'm not there."</STYLE>
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{MESOFF "500"}
{STOPSND "BGM" "3000" "PASS"}
{DELETECG "000,人物1" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
<PG>
{}
<EVENT VALUE="MESEND">
;---------------------------------------
; END DECOMPILED SCRIPT
