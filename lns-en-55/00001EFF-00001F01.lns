{CREATECG "人物3" "グラフィック\立ち絵\人物\詫言編　始まり以降\幸太郎うつむき逆.gal" "NORMAL" "#1" "-150" "400" "0" "" "0" "0" "0" "" "1" "0" "0" "255" ""}
{DELETECG "000" "1" "1000" "0" "0" "" "1"}
