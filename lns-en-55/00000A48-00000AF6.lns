<BR>
{MESOFF "500"}
{PLAYSND "BGM死月編\そよかぜ.ogg" "BGM" "REPEAT" "1000" "0"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜寝るバストアップ.gal" "NORMAL" "#1" "L" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="2">Kana-chan</STYLE><STYLE ID="3"> was nodding off sleepily.</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\春花腕組み.gal" "WAIT" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
"Hey, <STYLE ID="2">Kana</STYLE>, <STYLE ID="2">you</STYLE> seriously need to go to bed now."
{PAUSE ""}
<BR>
<STYLE ID="2">"Nnyaah... Don't wanna..."</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜バストアップ.gal" "NORMAL" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="2">"Mm... If </STYLE><STYLE ID="4">Goto-chan</STYLE><STYLE ID="2">'s going... I'm going..."</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島考えるバストアップ.gal" "WAIT" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="4">"Ehh..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">At this rate, she's probably planning to cling to </STYLE><STYLE ID="4">Goto</STYLE><STYLE ID="3"> all over again.</STYLE>
{WAIT "100" "CLICK" "SKIP"}
