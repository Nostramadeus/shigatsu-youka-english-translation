<TXSPN>"............
{PAUSE ""}
Mm..."
{PAUSE ""}
<BR>
<STYLE ID="1">"</STYLE>Haruka<STYLE ID="1">! You're awake!?"</STYLE>
{PAUSE ""}
<BR>
"<STYLE ID="1">Natsumi</STYLE>...?"
{PAUSE ""}
<BR>
<STYLE ID="2">I had been dozing, and that exchange woke me.</STYLE><PG>
{MESOFF "500"}
