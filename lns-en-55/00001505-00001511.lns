<BR>
<STYLE ID="13">"You're an unfair one..."</STYLE><PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\エデン\昔荒田\雪山菜の花.gal" "NORMAL" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
