{MESON "500"}
<STYLE ID="2"><TXSPN>Itohime</STYLE>'s face: I was dragged right up in front of it.
{PAUSE ""}
<BR>
<STYLE ID="13">"I-</STYLE><STYLE ID="2">Itohime</STYLE><STYLE ID="13">... Wake... up..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2"><TXSPS>"I　　am　　　　the　one　　called　　Shigatsu　　Youka"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="13"><TXSPN>"</STYLE><STYLE ID="2">Itohime</STYLE><STYLE ID="13">...! The person you care about would grieve to see you like this, you know!?"</STYLE><PG>
{MESOFF "500"}
{CREATECG "111" "グラフィック\イラスト\エデンの桜編\なつみと糸姫.gal" "NORMAL" "#1" "C" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物2,人物1,000" "1" "3000" "0" "0" "" "0"}
