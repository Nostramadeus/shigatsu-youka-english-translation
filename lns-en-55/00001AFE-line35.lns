{WAIT "2000" "NORMAL" "NORMAL"}
{MESOFF "500"}
<EVENT VALUE="TEXTCLEAR">
<PG>
{PLAYSND "SE\sceneswitch2.ogg" "VOICE" "NORMAL" "1000" "0"}
{CHANGECG "000" "グラフィック\立ち絵\アイテム\サクラ写真.gal" "NORMAL" "33" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
This is <STYLE ID="4">Sakura-san</STYLE>.
{WAIT "1000" "NORMAL" "SKIP"}
