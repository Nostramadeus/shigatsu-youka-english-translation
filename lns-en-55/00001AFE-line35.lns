{CREATECG "000" "グラフィック\背景\詫言編　夢から\新村本家夜.gal" "WAIT" "#1" "C" "B" "0" "1" "2000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "NORMAL" "NORMAL"}
{MOTION "789" "000" "4" "0" "3000" "DEC" "WAIT"}
{MESON "500"}
<TXSPD TIME="4294967246">This is <STYLE ID="1">Haruka</STYLE>'s hometown, <STYLE ID="2">the Arata settlement</STYLE>.
{WAIT "2000" "NORMAL" "NORMAL"}
{MESOFF "0"}
<EVENT VALUE="TEXTCLEAR">
<PG>
{DELETECG "000" "1" "0" "0" "0" "" "0"}
{WAIT "2000" "NORMAL" "NORMAL"}
{CREATECG "000" "グラフィック\背景\オッドアイ.gal" "WAIT" "#1" "R" "B" "0" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{PLAYSND "SE\sceneswitch2.ogg" "VOICE" "NORMAL" "1000" "0"}
{CREATECG "111" "グラフィック\イラスト\死月編\予告.gal" "NORMAL" "#1" "R" "B" "100" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\茅萱.gal" "NORMAL" "#1" "350" "B" "200" "" "0" "0" "0" "" "0" "0" "0" "180" ""}
{CREATECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜.gal" "NORMAL" "#1" "480" "B" "200" "32" "500" "0" "0" "" "0" "0" "0" "180" ""}
{WAIT "1000" "NORMAL" "SKIP"}
{MESON "500"}
Sisters with odd eyes?
{WAIT "2000" "NORMAL" "SKIP"}
{MESOFF "0"}
<EVENT VALUE="TEXTCLEAR">
<PG>
{PLAYSND "SE\sceneswitch2.ogg" "VOICE" "NORMAL" "1000" "0"}
{CHANGECG "000" "グラフィック\背景\スチル\紙人形6枚.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1,人物2,111" "32" "500" "0" "0" "" "0"}
{WAIT "1000" "NORMAL" "NORMAL"}
{MESON "500"}
Six paper dolls...
{WAIT "2000" "NORMAL" "SKIP"}
{MESOFF "0"}
<EVENT VALUE="TEXTCLEAR">
<PG>
{PLAYSND "SE\sceneswitch2.ogg" "VOICE" "NORMAL" "1000" "0"}
{CHANGECG "000" "グラフィック\背景\詫言編　夢から\荒田桜1.gal" "NORMAL" "32" "500" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "NORMAL" "NORMAL"}
<EVENT VALUE="MOTION\r\n789\r\n000\r\n4\r\n0\r\n3000\r\nNORMAL\r\nPASS">
{MESON "500"}
The Arata settlement has a goshinboku too...?
{WAIT "2000" "NORMAL" "NORMAL"}
{MESOFF "500"}
<EVENT VALUE="TEXTCLEAR">
<PG>
{PLAYSND "SE\詫言編　夢から\dark_attack.ogg" "VOICE" "NORMAL" "1000" "0"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\幸太郎幽霊.gal" "NORMAL" "#1" "C" "B" "0" "32" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1" "11" "1000" "0" "0" "" "0"}
{MESON "500"}
Ojisan is alive...!
{WAIT "1000" "NORMAL" "SKIP"}
<BR>
