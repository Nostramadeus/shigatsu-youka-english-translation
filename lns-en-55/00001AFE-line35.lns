{MESOFF "500"}
<EVENT VALUE="TEXTCLEAR">
<PG>
{PLAYSND "SE\sceneswitch2.ogg" "VOICE" "NORMAL" "1000" "0"}
{CHANGECG "000" "グラフィック\立ち絵\人物\死神\死神軍団武器.gal" "NORMAL" "33" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
