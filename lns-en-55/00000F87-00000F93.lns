{MESON "500"}
<STYLE ID="1">"Sorry, at a time like this... </STYLE>
{PAUSE ""}
<STYLE ID="1">when the one who wants to cry right now is </STYLE><STYLE ID="2">you</STYLE><STYLE ID="1">..."</STYLE><PG>
