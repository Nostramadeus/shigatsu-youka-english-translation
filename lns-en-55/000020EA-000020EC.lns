<SCENARIO VER="105">
{WAIT "1000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\背景\詫言編　夢から\新村本家昼車.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\詫言編　始まり以降\幸太郎バストアップ.gal" "NORMAL" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>"All right, that's everything."
{PAUSE ""}
<BR>
<STYLE ID="1">"Nata, maces, Noh masks and red robes... </STYLE>
{PAUSE ""}
<STYLE ID="1">Two sets of each of these, right?"</STYLE>
{PAUSE ""}
<BR>
"Yeah, they're definitely all in there."
{PAUSE ""}
<BR>
<STYLE ID="1">"Thank you. </STYLE>
{PAUSE ""}
<STYLE ID="1">............</STYLE>
{PAUSE ""}
<STYLE ID="2">Chigaya</STYLE><STYLE ID="1">...?"</STYLE><PG>
"<STYLE ID="1">Sakura</STYLE>, <STYLE ID="1">you</STYLE> don't need to worry about anything. 
{PAUSE ""}
Right now, just think about sending the package to <STYLE ID="3">Mifuyu-chan</STYLE>. 
{PAUSE ""}
As for <STYLE ID="2">Chigaya</STYLE>, just leave her to me and <STYLE ID="4">Mom</STYLE>."
{PAUSE ""}
<BR>
<STYLE ID="1">"Okay... I'm off, then."</STYLE><PG>
{MESOFF "500"}
{DELETECG "000,人物1" "1" "1000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "SE\車ドア開閉.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAITPLAY "VOICE" "CLICK"}
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "SE\車室内エンジン.ogg" "SE2" "NORMAL" "1000" "0"}
{PLAYSND "SE\車走行中ワゴン.ogg" "SE" "REPEAT" "0" "0"}
{CHGVOL "SE" "1000" "3000" "PASS"}
{WAIT "3000" "CLICK" "SKIP"}
{STOPSND "SE2" "1000" "PASS"}
{CREATECG "000" "グラフィック\背景\詫言編　夢から\荒田山道昼.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
{PLAYSND "環境音\アポカリプティック2.ogg" "SE2" "NORMAL" "100" "0"}
<STYLE ID="1">"What is it... this uneasy feeling..."</STYLE><PG>
<STYLE ID="1">"No, it's all right. I wrote the letter properly, too. </STYLE>
{PAUSE ""}
<STYLE ID="3">Mifuyu-chan</STYLE><STYLE ID="1"> couldn't possibly use these to kill anyone..."</STYLE><PG>
{DELETECG "000" "1" "0" "0" "0" "" "0"}
{STOPSND "SE" "0" "PASS"}
{MESOFF "0"}
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "SE\車走行中ワゴン.ogg" "SE" "REPEAT" "1000" "0"}
{CREATECG "000" "グラフィック\背景\詫言編　夢から\荒田山道昼.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="1">"............!?"</STYLE><PG>
{MESOFF "500"}
{STOPSND "SE" "1000" "PASS"}
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "SE\車エンジン切る.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAITPLAY "VOICE" "CLICK"}
{PLAYSND "SE\車ドア開閉.ogg" "VOICE" "NORMAL" "1000" "0"}
{PLAYSND "環境音\山の中.ogg" "SE" "REPEAT" "1000" "0"}
{WAITPLAY "VOICE" "CLICK"}
{MESON "500"}
<STYLE ID="1">"Who's there!? Is someone there!?"</STYLE><PG>
{MESOFF "500"}
{PLAYSND "エデンの桜\SE\walk-tussock1.ogg" "VOICE" "REPEAT" "1000" "0"}
{DELETECG "000" "1" "500" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="1">"I could have sworn, over here..."</STYLE><PG>
{STOPSND "VOICE" "500" "PASS"}
<STYLE ID="1">"............!?"</STYLE><PG>
{MESOFF "500"}
{CREATECG "000" "グラフィック\リファレンス用\背景\鹿.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="1">"A deer..."</STYLE>
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{MESOFF "500"}
{PLAYSND "エデンの桜\SE\walk-tussock1.ogg" "VOICE" "REPEAT" "1000" "0"}
{DELETECG "000" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\背景\詫言編　夢から\荒田山道昼.gal" "NORMAL" "#1" "C" "B" "0" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{STOPSND "VOICE" "500" "PASS"}
{WAITPLAY "VOICE" "CLICK"}
{STOPSND "SE" "1000" "PASS"}
{PLAYSND "SE\車ドア開閉.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAITPLAY "VOICE" "CLICK"}
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "SE\車室内エンジン.ogg" "SE2" "NORMAL" "1000" "0"}
{PLAYSND "SE\車走行中ワゴン.ogg" "SE" "REPEAT" "0" "0"}
{CHGVOL "SE" "1000" "3000" "PASS"}
{WAIT "3000" "CLICK" "SKIP"}
{DELETECG "000" "1" "3000" "0" "0" "" "0"}
{MESOFF "500"}
{STOPSND "SE" "3000" "PASS"}
{STOPSND "SE2" "3000" "PASS"}
{DELETECG "000,人物1,人物2" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
<PG>
{}
