{MESON "500"}
<STYLE ID="24">Tonight I'll coach you, hands-on and hips-on, in the </STYLE><STYLE ID="27" RUBY="ひけつ">secrets</STYLE><STYLE ID="24"> of being popular!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"Shut up, you </STYLE><STYLE ID="24">pervy dirty-joke girl</STYLE><STYLE ID="2">!"</STYLE>
{PAUSE ""}
