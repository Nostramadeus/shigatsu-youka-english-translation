<EVENT VALUE="MOTION\r\n789\r\n人物2\r\n4\r\n100\r\n0\r\nDEC\r\nPASS">
{CHANGECG "人物2" "グラフィック\立ち絵\人物\五島挨拶バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
