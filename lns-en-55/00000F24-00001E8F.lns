{MESON "500"}
<STYLE ID="8">"Who's there!?"</STYLE><PG>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\真呪殺\追加手直し\茜横顔逆.gal" "NORMAL" "#1" "L" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="8">"</STYLE><STYLE ID="11">Akane</STYLE><STYLE ID="8">...? Weren't you supposed to be with the police...?"</STYLE>
