;    1: TDecorate(count=974, unk2=4294967295, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    2: TDecorate(count=695, unk2=16776960, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    3: TDecorate(count=365, unk2=16757864, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    4: TDecorate(count=52, unk2=8388863, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    5: TDecorate(count=43, unk2=5265653, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    6: TDecorate(count=50, unk2=13464750, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    7: TDecorate(count=6, unk2=13464752, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    8: TDecorate(count=12, unk2=16755455, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    9: TDecorate(count=5, unk2=65535, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;   10: TDecorate(count=2, unk2=16776960, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=あいづち, unk10=4294967295, unk11=4294967295)
;   11: TDecorate(count=2, unk2=16755370, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;   12: TDecorate(count=5, unk2=16777215, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;   13: TDecorate(count=8, unk2=11271932, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
; Display conditions:
;    0: TWdCondition(count=2411, target=)
; Links:
;    0: TWdLink(count=2228, event=, unk3=)
;---------------------------------------
; BEGIN DECOMPILED SCRIPT
;---------------------------------------
<SCENARIO VER="105">
{CREATECG "000" "グラフィック\背景\エデン\料亭部屋.gal" "NORMAL" "#1" "C" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\美冬バストアップ.gal" "NORMAL" "#1" "R" "B" "0" "20" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
{QUAKE "メッセージボックス土台" "QUAKE" "1" "15" "15" "0" "30"}
<TXSPN>"That way!!"
{QUAKESTOP "500"}
{PAUSE ""}
<BR>
<STYLE ID="1">Maybe because I'd shouted so suddenly, </STYLE><STYLE ID="2">Auntie's</STYLE><STYLE ID="1"> body gave a jolt.</STYLE><PG>
{PLAYSND "最後の声・真呪殺\z50逆.ogg" "BGM" "REPEAT" "1000" "0"}
<STYLE ID="2">"W-what's wrong?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Mm... I was told 'that way'!</STYLE>
{PAUSE ""}
<STYLE ID="3">　Someone told me </STYLE><STYLE ID="4">Mom</STYLE><STYLE ID="3"> was over that way!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"Someone, meaning who...?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Mm... I don't know that part, but..."</STYLE><PG>
<STYLE ID="2">"Listen, </STYLE><STYLE ID="3">Chigaya-chan</STYLE><STYLE ID="2">, stay calm. </STYLE>
{PAUSE ""}
<STYLE ID="2">I've still only heard a little of what </STYLE><STYLE ID="3">you</STYLE><STYLE ID="2">'ve told me, but from where I stand, it's full of strange things. </STYLE>
{PAUSE ""}
<STYLE ID="2">Will you answer just a few more of my questions?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Mm... All right..."</STYLE><PG>
<STYLE ID="2">"</STYLE><STYLE ID="5">Kotaro-san</STYLE><STYLE ID="2"> never asked </STYLE><STYLE ID="6">your grandmother</STYLE><STYLE ID="2"> why she pushed </STYLE><STYLE ID="4">Sakura-san</STYLE><STYLE ID="2"> off?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Yeah..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"</STYLE><STYLE ID="5">Kotaro-san</STYLE><STYLE ID="2"> still believes </STYLE><STYLE ID="6">your grandmother</STYLE><STYLE ID="2"> pushed her, then?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Yeah..."</STYLE><PG>
<STYLE ID="2">"So the only ones who know about it are </STYLE><STYLE ID="5">Kotaro-san</STYLE><STYLE ID="2">, </STYLE><STYLE ID="6">your grandmother</STYLE><STYLE ID="2">, and </STYLE><STYLE ID="3">you</STYLE><STYLE ID="2">?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Yeah..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Having said that much, </STYLE><STYLE ID="2">Auntie</STYLE><STYLE ID="1"> stopped talking and reached for her water, its ice all melted.</STYLE><PG>
<STYLE ID="2">"Don't you think that's strange?</STYLE>
{PAUSE ""}
<STYLE ID="2">　At the end, </STYLE><STYLE ID="6">your grandmother</STYLE><STYLE ID="2"> grabbed </STYLE><STYLE ID="4">Sakura-san's</STYLE><STYLE ID="2"> hand and tried to pull her up, right?</STYLE>
{PAUSE ""}
<STYLE ID="2">　How could that look like pushing her off?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Now that she mentioned it... </STYLE>
{PAUSE ""}
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\エデン\サクラ捕まえる.gal" "NORMAL" "#1" "R" "T" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物3" "グラフィック\立ち絵\人物\エデン\エリカ捕まえる.gal" "NORMAL" "#1" "R" "T" "100" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1,000" "20" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="1">It really was strange.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Pushing someone off and trying to pull them up should be completely different motions, however you look at it.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">No matter how you look at it, that doesn't look like pushing.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Misread it...?</STYLE><PG>
<STYLE ID="5">Dad</STYLE><STYLE ID="1"> would have been watching it from below the cliff, so it was possible he'd misread it.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">But back then, </STYLE><STYLE ID="5">Dad</STYLE><STYLE ID="1"> told </STYLE><STYLE ID="6">Grandma</STYLE><STYLE ID="1"> without a moment's hesitation that she'd 'pushed </STYLE><STYLE ID="4">Mom</STYLE><STYLE ID="1"> off.'</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Besides, if he was watching, he should have been able to shout before she fell, to stop </STYLE><STYLE ID="7">Grandma</STYLE><STYLE ID="1"> or something.</STYLE><PG>
<STYLE ID="1">And yet, after </STYLE><STYLE ID="4">Mom</STYLE><STYLE ID="1"> fell, he appeared as if he'd timed it, and cut off her head.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">To me, more baffling by far than the chance he misread it is what </STYLE><STYLE ID="5">Dad</STYLE><STYLE ID="1"> did.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Almost as if he'd known </STYLE><STYLE ID="4">Mom</STYLE><STYLE ID="1"> would fall―</STYLE><PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\エデン\料亭部屋.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\美冬バストアップ.gal" "NORMAL" "#1" "R" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物2,人物3" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="2">"Maybe this incident really is 'something like a curse'..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Mm... A curse? But that's..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"But </STYLE><STYLE ID="4">Sakura-san</STYLE><STYLE ID="2"> and </STYLE><STYLE ID="8">Natsumi-chan</STYLE><STYLE ID="2"> have the ability to hear impossible voices, don't they?</STYLE>
{PAUSE ""}
<STYLE ID="2">　It's only normal to think something's off right there, isn't it?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Mm... Impossible voices... </STYLE>
{PAUSE ""}
<STYLE ID="3">Oh, right, </STYLE><STYLE ID="2">Auntie</STYLE><STYLE ID="3">, the truth is... I have the same ability."</STYLE><PG>
<STYLE ID="2">"What!? </STYLE><STYLE ID="3">Chigaya-chan</STYLE><STYLE ID="2">, you too!?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Mm... I'm sorry I never told you..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"I see... If you're </STYLE><STYLE ID="4">Sakura-san's</STYLE><STYLE ID="2"> child, it's no wonder you'd awaken to a power like that..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Mm... </STYLE><STYLE ID="8">Natsumi-chan</STYLE><STYLE ID="3"> isn't </STYLE><STYLE ID="4">Mom's</STYLE><STYLE ID="3"> child too, is she...?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"That's not possible. I was there at the birth."</STYLE><PG>
<STYLE ID="1">That I'd inherit </STYLE><STYLE ID="4">Mom's</STYLE><STYLE ID="1"> power, I can still understand, but is there something else in common that lets people gain the ability?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">At this point there's far too little information.</STYLE><PG>
<STYLE ID="3">"Mm... In that case, trying to push the deduction any further might just be a waste of effort."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"You're right. At times like this, it's so reassuring to have </STYLE><STYLE ID="9">Goto-chan</STYLE><STYLE ID="2"> around. </STYLE>
{PAUSE ""}
<STYLE ID="2">But just in case, I'd like to hear everything </STYLE><STYLE ID="3">you</STYLE><STYLE ID="2"> know."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Mm... Okay. Then let's set the deduction aside for now and put sharing what we know first."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"I'll just </STYLE><STYLE ID="10" RUBY="あいづち">nod along</STYLE><STYLE ID="2">, then. If I butt in, the story will stall again."</STYLE><PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\エデン\料亭外観.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="1">At 10, I tried to kill </STYLE><STYLE ID="4">Mom</STYLE><STYLE ID="1">, and a few days later the murderous intent suddenly vanished.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">A few days after that, </STYLE><STYLE ID="2">Auntie</STYLE><STYLE ID="1"> and </STYLE><STYLE ID="11">Haruka</STYLE><STYLE ID="1"> came to Arata, and that same day </STYLE><STYLE ID="4">Mom</STYLE><STYLE ID="1"> died.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">The next year, I stabbed to death Mrs. Shirozaki, who'd suspected </STYLE><STYLE ID="5">Dad</STYLE><STYLE ID="1">.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">After that, I killed one person each year, five in all.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="12">This proved that confining </STYLE><STYLE ID="5">Dad</STYLE><STYLE ID="1"> and watching him had been pointless.</STYLE><PG>
<STYLE ID="1">And as for the curse-killings of these last four years, I had nothing at all to do with them.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Who did them was completely unknown.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">I wanted to stop the curse-killings that had taken on a life of their own just as much.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Though that was presumptuous, coming from the one who'd killed first...</STYLE><PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\エデン\料亭部屋.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\美冬バストアップ.gal" "NORMAL" "#1" "R" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="2">"Thank you, </STYLE><STYLE ID="3">Chigaya-chan</STYLE><STYLE ID="2">, for telling me. </STYLE>
{PAUSE ""}
<STYLE ID="2">But, </STYLE><STYLE ID="3">Chigaya-chan</STYLE><STYLE ID="2">... </STYLE>
{PAUSE ""}
<STYLE ID="2">No matter how I think about it, this story is strange."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Mm... You're right. For </STYLE><STYLE ID="5">Dad</STYLE><STYLE ID="3"> to swear Grandma pushed her..."</STYLE><PG>
<STYLE ID="2">"That's not all. </STYLE><STYLE ID="3">You</STYLE><STYLE ID="2"> didn't do the curse-killings of these last four years, right?</STYLE>
{PAUSE ""}
<STYLE ID="2">　Even if someone else did them, how did they do it?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Mm... What do you mean?"</STYLE><PG>
<STYLE ID="2">"</STYLE><STYLE ID="3">You</STYLE><STYLE ID="2"> could sneak up on someone without them noticing and use a knife... that much you could do, but is there anyone else in the settlement who could do the same?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Now that she mentioned it, she was right.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">About the only one who could move like me was </STYLE><STYLE ID="13">Kana</STYLE><STYLE ID="1">.</STYLE><PG>
<STYLE ID="1">But </STYLE><STYLE ID="13">Kana</STYLE><STYLE ID="1"> had no motive to cause a curse-killing.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Could it be that </STYLE><STYLE ID="5">Dad</STYLE><STYLE ID="1"> noticed my curse-killings and had </STYLE><STYLE ID="13">Kana</STYLE><STYLE ID="1"> do them...?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">In that case </STYLE><STYLE ID="13">Kana</STYLE><STYLE ID="1"> would have done her first curse-killing at 6, and that's surely impossible.</STYLE><PG>
<STYLE ID="1">Was there anyone else who could copy my methods?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="6">Grandma</STYLE><STYLE ID="1"> was athletic too, but she couldn't move the way I could.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Besides, by that logic, </STYLE><STYLE ID="6">Grandma</STYLE><STYLE ID="1"> would have to know that I'm the curse-killer.</STYLE><PG>
<STYLE ID="6">Grandma</STYLE><STYLE ID="1"> is always racking her brains over how to solve the case, though.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="6">Grandma</STYLE><STYLE ID="1"> covering for me would be a different story, but then it would all just be a put-up job, and that would be the end of it.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Things shouldn't be that simple.</STYLE><PG>
<STYLE ID="2">"</STYLE><STYLE ID="3">Chigaya-chan</STYLE><STYLE ID="2">, do you know how the people who were curse-killed died?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">"Mm... They were stabbed with a knife, weren't they?"</STYLE>
{PAUSE ""}
<BR>
{STOPSND "BGM" "5000" "PASS"}
<STYLE ID="1">Why was she asking something so obvious?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">There was no way I, the one who'd done it, wouldn't know that.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">No way I wouldn't know...</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">She was going out of her way to ask me that.</STYLE><PG>
{MESOFF "500"}
{CHANGECG "000" "$000080" "NORMAL" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="2">"</STYLE><STYLE ID="3">Chigaya-chan</STYLE><STYLE ID="2">, no matter how I look at it, it's strange. </STYLE>
{PAUSE ""}
<STYLE ID="2">The truth is, the bodies of the curse-killed―"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">W-wait, wait...!</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Auntie</STYLE><STYLE ID="1"> was trying to say something, and I knew what.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">I stabbed them to death with a knife.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">And yet―</STYLE><PG>
<STYLE ID="2">"The bodies of the curse-killed―</STYLE>
{PAUSE ""}
<EVENT VALUE="TEXTCLEAR">
<PG>
{}
<EVENT VALUE="MESEND">
;---------------------------------------
; END DECOMPILED SCRIPT
;---------------------------------------