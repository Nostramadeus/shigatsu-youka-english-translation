<SCENARIO VER="105">
{WAIT "2000" "CLICK" "SKIP"}
{PLAYSND "エデンの桜\000.ogg" "BGM2" "REPEAT" "0" "0"}
{CHGVOL "BGM2" "900" "5000" "PASS"}
{WAIT "3000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\背景\エデン\山頂\桜縦長.gal" "NORMAL" "#1" "C" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\エデン\糸姫赤\死月妖花横.lcm" "REPEAT" "#1" "R" "-540" "100" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物2" "グラフィック\立ち絵\人物\エデン\なつみ横顔縛り.gal" "NORMAL" "#1" "L" "-540" "100" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
<EVENT VALUE="MOTION\r\n789\r\n000\r\n4\r\n0\r\n7000\r\nDEC\r\nPASS">
<EVENT VALUE="MOTION\r\n456\r\n人物1\r\n4\r\n0\r\n7000\r\nDEC\r\nPASS">
<EVENT VALUE="MOTION\r\n123\r\n人物2\r\n4\r\n0\r\n7000\r\nDEC\r\nPASS">
{WAIT "7000" "CLICK" "SKIP"}
<EVENT VALUE="MOTION\r\n789\r\n000\r\n4\r\n0\r\n0\r\nDEC\r\nPASS">
<EVENT VALUE="MOTION\r\n456\r\n人物1\r\n4\r\n0\r\n0\r\nDEC\r\nPASS">
<EVENT VALUE="MOTION\r\n123\r\n人物2\r\n4\r\n0\r\n0\r\nDEC\r\nPASS">
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPS>"I　　am　the　　one　　called　　　Shigatsu　　Youka"
{PAUSE ""}
<BR>
<STYLE ID="1"><TXSPN>"Is this </STYLE>your<STYLE ID="1"> wish?</STYLE>
{PAUSE ""}
<STYLE ID="1">　You want to... see </STYLE><STYLE ID="2">Nii-sama</STYLE><STYLE ID="1">?"</STYLE>
{PAUSE ""}
<BR>
<TXSPS>"I　　am　　the　　one　　called　　Shigatsu　Youka"
{PAUSE ""}
<BR>
<STYLE ID="1"><TXSPN>"</STYLE>Itohime<STYLE ID="1">! Can you hear me!? </STYLE>You<STYLE ID="1">'ve been waiting for </STYLE><STYLE ID="2">Nii-sama</STYLE><STYLE ID="1"> all this time, haven't you!?"</STYLE>
{PAUSE ""}
<BR>
<TXSPS>"I　　am　the　one　　called　　Shigatsu　　Youka"<PG>
<STYLE ID="1"><TXSPN>"Is this ugly form what </STYLE>you<STYLE ID="1"> want!?</STYLE>
{PAUSE ""}
<STYLE ID="1">　Is this how you want </STYLE><STYLE ID="2">Nii-sama</STYLE><STYLE ID="1"> to see you!? </STYLE><STYLE ID="2">Nii-sama</STYLE><STYLE ID="1"> went off to help the poor!</STYLE>
{PAUSE ""}
<STYLE ID="1">　How sad do you think he'd be if he knew what </STYLE>you<STYLE ID="1">'ve done!? Are you going to go on showing this disgrace forever!?"</STYLE>
{PAUSE ""}
<BR>
<TXSPS>"I　　am
{WAIT "1000" "CLICK" "SKIP"}
　　Nii...
{WAIT "1000" "CLICK" "SKIP"}
-sama... 
{WAIT "1000" "CLICK" "SKIP"}
<TXSPD TIME="1000">I　am"<PG>
{PLAYSND "BGM死月編\夢見る憧憬.ogg" "BGM" "REPEAT" "1000" "0"}
{CHGVOL "BGM2" "600" "5000" "PASS"}
<STYLE ID="1"><TXSPN>"What </STYLE>you<STYLE ID="1">'re doing isn't for </STYLE><STYLE ID="2">Nii-sama</STYLE><STYLE ID="1">! It isn't for </STYLE>you<STYLE ID="1"> either!</STYLE>
{PAUSE ""}
<STYLE ID="1">　A monster called </STYLE>Shigatsu Youka<STYLE ID="1"> just </STYLE><STYLE ID="3" RUBY="そそのか">led you astray</STYLE><STYLE ID="1">! Wake up..."</STYLE>
{PAUSE ""}
<BR>
<TXSPS>"I　　want　you"
{PAUSE ""}
<BR>
<STYLE ID="1"><TXSPN>"Come to Motoki-cho with me!"</STYLE>
{PAUSE ""}
<BR>
<TXSPS>"I　　want　you to　
{WAIT "500" "CLICK" "SKIP"}
k
{WAIT "500" "CLICK" "SKIP"}
i
{WAIT "500" "CLICK" "SKIP"}
ll　
{WAIT "500" "CLICK" "SKIP"}
me"<PG>
<STYLE ID="1"><TXSPN>"</STYLE>Itohime<STYLE ID="1">...!"</STYLE>
{PAUSE ""}
<BR>
<TXSPS>"I　　want　　you to　
{PAUSE ""}
de―
{WAIT "200" "CLICK" "SKIP"}
s―
{WAIT "200" "CLICK" "SKIP"}
troy―
{WAIT "200" "CLICK" "SKIP"}
―
{WAIT "200" "CLICK" "SKIP"}
me―
{PAUSE ""}
Destroy me"
{PAUSE ""}
<BR>
<STYLE ID="1"><TXSPN>"Are you really... </STYLE>
{PAUSE ""}
<STYLE ID="1">sure that's what you want...?"</STYLE>
{PAUSE ""}
<BR>
"I　am　　beyond　saving... 
{PAUSE ""}
I　　beg　you　
{PAUSE ""}
<STYLE ID="1">Natsumi-san</STYLE>...!"<PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\lcm\夏菜ナイフドローガ.lcm" "NORMAL" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1,人物2" "1" "0" "0" "0" "" "0"}
{WAITPLAY "000" "CLICK"}
{WAIT "1000" "CLICK" "SKIP"}
{DELETECG "000" "1" "0" "0" "0" "" "0"}
{MESON "500"}
<STYLE ID="4">The hyphae that had me bound were slashed to pieces.</STYLE><PG>
{MESOFF "500"}
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "SE\布団.ogg" "VOICE" "NORMAL" "1000" "0"}
{STOPSND "BGM2" "3000" "PASS"}
{CREATECG "000" "グラフィック\背景\エデン\山頂\桜のじゅうたん.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
{QUAKE "000" "QUAKE" "1" "5" "5" "500" "30"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">I dropped straight down onto the piled-up cherry blossoms.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">Thanks to the blossoms being thicker than I'd imagined, I felt almost no pain.</STYLE><PG>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\エデン\夏菜ナイフ血.gal" "NORMAL" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="5">"</STYLE><STYLE ID="1">Natsumi-chan</STYLE><STYLE ID="5">! Are you okay!?</STYLE>
{PAUSE ""}
<STYLE ID="5">　Ow ow ow... my leg..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"</STYLE><STYLE ID="5">Kana-chan</STYLE><STYLE ID="1">...!"</STYLE>
{PAUSE ""}
<BR>
Shigatsu Youka<STYLE ID="4"> had been distracted by me, and it seemed Kana-chan had used that opening to climb all the way up.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">But </STYLE><STYLE ID="5">Kana-chan's</STYLE><STYLE ID="4"> leg seemed to be at its limit too. She must have squeezed out the last of her strength.</STYLE><PG>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\春花腕組み.gal" "NORMAL" "#1" "L" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="2">"</STYLE><STYLE ID="1">Natsumi</STYLE><STYLE ID="2">, you okay!?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"Y-yeah!"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島怒りバストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="6">"Thank goodness! Operation Cherry Cushion is a success!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">Come to think of it, the blossoms were piled up oddly high just here.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">They seemed to have heaped the blossoms up right beneath me.</STYLE><PG>
<STYLE ID="4">But even if I'm saved, unless we destroy </STYLE>Shigatsu Youka<STYLE ID="4">, there's no escaping from here.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">And not only that. Motoki-cho will sink into this sea of fungus.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">So... </STYLE>
{PAUSE ""}
<STYLE ID="4">So the only thing I can do now is this.</STYLE><PG>
<STYLE ID="1">"Everyone, lend me your strength."</STYLE>
{PAUSE ""}
<BR>
Itohime<STYLE ID="4">'s words had reached me. She wanted to be destroyed.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">For that, I need everyone's strength.</STYLE><PG>
<STYLE ID="1">"</STYLE><STYLE ID="5">Kana-chan</STYLE><STYLE ID="1">, lend me the knife."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">"Huh?"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{DELETECG "000,人物1,人物2" "1" "500" "0" "0" "" "0"}
{MESON "500"}
<STYLE ID="5">Kana-chan</STYLE><STYLE ID="4"> was about to hand it to me, but before she could, I snatched the knife away.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">And then―</STYLE>
{PAUSE ""}
{MESOFF "500"}
{CREATECG "人物3" "グラフィック\立ち絵\人物\エデン\なつみ腕.gal" "NORMAL" "#1" "R" "250" "100" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{CREATECG "アイテム1" "グラフィック\立ち絵\アイテム\サード\ナイフ下向き.gal" "NORMAL" "#1" "600" "-540" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
{PLAYSND "最後の声・真呪殺\SE\ナイフ投げる.ogg" "VOICE" "NORMAL" "1000" "0"}
<EVENT VALUE="MOTION\r\n789\r\nアイテム1\r\n4\r\n-150\r\n100\r\nNORMAL\r\nPASS">
{WAIT "100" "CLICK" "SKIP"}
<EVENT VALUE="MOTION\r\n789\r\nアイテム1\r\n4\r\n-150\r\n0\r\nNORMAL\r\nPASS">
{PLAYSND "SE\hit_axe1.ogg" "VOICE" "NORMAL" "1000" "0"}
{QUAKE "アイテム1,人物3" "QUAKE" "1" "15" "15" "500" "30"}
{CREATECG "000" "$000080" "NORMAL" "#1" "C" "B" "0" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="4">I drove it into my arm as hard as I could.</STYLE><PG>
{QUAKE "アイテム1,人物3" "QUAKE" "1" "5" "5" "0" "30"}
<STYLE ID="1">"Ngh...!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"</STYLE><STYLE ID="1">Natsumi</STYLE><STYLE ID="2">! What the hell are you doing!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"Don't touch me!</STYLE>
{PAUSE ""}
<STYLE ID="1">　Don't touch me... </STYLE>
{PAUSE ""}
<STYLE ID="1">This is the only way for us to make it out of here."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">Right after the cold of the knife, the pain came through as heat.</STYLE><PG>
{QUAKESTOP "0"}
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\エデン\山頂\桜のじゅうたん.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\五島バストアップ.gal" "NORMAL" "#1" "R" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "アイテム1,人物3" "1" "1000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="6">"</STYLE><STYLE ID="1">Senpai</STYLE><STYLE ID="6">, don't tell me... </STYLE>
{PAUSE ""}
<STYLE ID="6">that blood is for us..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"</STYLE><STYLE ID="6">Goto</STYLE><STYLE ID="1">, there's no other way."</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\春花バストアップ.gal" "NORMAL" "#1" "L" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="2">"What do you mean, what are we going to do..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="6">"Anyone who touches </STYLE><STYLE ID="1">Senpai's</STYLE><STYLE ID="6"> blood becomes third generation. </STYLE>
{PAUSE ""}
<STYLE ID="6">You understand what that means, right?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">That's </STYLE><STYLE ID="6">Goto</STYLE><STYLE ID="4"> for you, quick on the uptake.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">Yes, that's what I'm aiming for.</STYLE><PG>
<STYLE ID="5">Kana-chan's</STYLE><STYLE ID="4"> blood alone isn't enough? Then we just need more third generation.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">For that, everyone just has to touch my blood.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">With five people's worth of blood, we should be able to do serious damage even to </STYLE>Shigatsu Youka<STYLE ID="4">.</STYLE><PG>
{MESOFF "500"}
{STOPSND "BGM" "3000" "PASS"}
{CHANGECG "000" "グラフィック\背景\エデン\山頂\桜縦長.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
