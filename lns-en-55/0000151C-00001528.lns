{CREATECG "000" "グラフィック\背景\エデン\山頂\サクラ栄一郎死にか0け.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "1" "0" "0" "255" ""}
{WAIT "3000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="2">"H-hey... seriously...?"</STYLE>
