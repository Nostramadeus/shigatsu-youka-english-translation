{CHANGECG "000" "グラフィック\立ち絵\アイテム\ロシアンたこ焼き\蹴散らす.lcm" "NORMAL" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<STYLE ID="4">"No, that logic is wrong! </STYLE><STYLE ID="5">Natsumi</STYLE><STYLE ID="4">, your logic assumes there's only one hit in black!</STYLE>
{PAUSE ""}
{CHANGECG "000" "グラフィック\立ち絵\アイテム\ロシアンたこ焼き\黒2つ当たり.lcm" "NORMAL" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
