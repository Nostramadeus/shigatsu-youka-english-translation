;   27: TDecorate(count=2, unk2=16755455, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=あまた, unk10=4294967295, unk11=4294967295)
;   28: TDecorate(count=4, unk2=16755370, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=あらた, unk10=4294967295, unk11=4294967295)
;   29: TDecorate(count=2, unk2=16755370, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=あまた, unk10=4294967295, unk11=4294967295)
;   30: TDecorate(count=3, unk2=16755370, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=いとひめやま, unk10=4294967295, unk11=4294967295)
;   31: TDecorate(count=2, unk2=16755370, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=えいごう, unk10=4294967295, unk11=4294967295)
;   32: TDecorate(count=2, unk2=16755370, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=にいむら, unk10=4294967295, unk11=4294967295)
