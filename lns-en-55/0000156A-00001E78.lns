{CREATECG "人物1" "グラフィック\イラスト\真呪殺編\パラサイト\パラサイト普通.lcm" "REPEAT" "#1" "R" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
<EVENT VALUE="MOTION\r\n789\r\nムービー\r\n11\r\n100\r\n0\r\nNORMAL\r\nPASS">
