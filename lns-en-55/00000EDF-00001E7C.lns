<SCENARIO VER="105">
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPD TIME="4294967236">Run...!
<EVENT VALUE="MOTION\r\n789\r\n111\r\n11\r\n100\r\n500\r\nNORMAL\r\nPASS">
　It's <STYLE ID="1">dangerous here...!　Danger is clos</STYLE><STYLE ID="2">ing in!</STYLE>
<EVENT VALUE="MOTION\r\n789\r\n111\r\n11\r\n250\r\n500\r\nNORMAL\r\nPASS">
<STYLE ID="2">　The cherry trees' warn</STYLE><STYLE ID="3">ing...!　So that really should never have been </STYLE><STYLE ID="4">used!　Whoever takes the power dies in Ap</STYLE><STYLE ID="5">ril</STYLE>
<EVENT VALUE="MOTION\r\n789\r\n111\r\n11\r\n100\r\n500\r\nNORMAL\r\nPASS">
<STYLE ID="5">　It's the cherry trees' curse　Get away from the cherry tr</STYLE><STYLE ID="6">ees!　No, that was an accid</STYLE><STYLE ID="7">ent!　I won't hand Haruka over　Longed for a fam</STYLE><STYLE ID="8">ily　No escaping the shinigam</STYLE><STYLE ID="9">i</STYLE>
<EVENT VALUE="MOTION\r\n789\r\n111\r\n11\r\n250\r\n500\r\nNORMAL\r\nPASS">
<STYLE ID="9">　The witch's curse　I killed six peo</STYLE><STYLE ID="10">ple</STYLE>
<EVENT VALUE="MOTION\r\n789\r\n111\r\n11\r\n100\r\n500\r\nNORMAL\r\nPASS">
<STYLE ID="10">　No, the ones who killed were us　</STYLE>
{MESOFF "0"}
<EVENT VALUE="TEXTCLEAR">
<PG>
<EVENT VALUE="MOTION\r\n789\r\n111\r\n11\r\n0\r\n0\r\nNORMAL\r\nPASS">
<STYLE ID="10"><TXSPD TIME="4294967196">What is this... these voices...</STYLE><BR>
{WAIT "3000" "CLICK" "SKIP"}
{MESOFF "0"}
<EVENT VALUE="TEXTCLEAR">
<PG>
{PLAYSND "強風.ogg" "SE2" "REPEAT" "1000" "0"}
{CREATECG "000" "グラフィック\背景\桜道夜.gal" "NORMAL" "#1" "C" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\死神.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "500" "NORMAL" "SKIP"}
{STOPSND "SE2" "0" "PASS"}
{DELETECG "000,人物1" "1" "0" "0" "0" "" "0"}
<EVENT VALUE="MOTION\r\n789\r\n111\r\n11\r\n250\r\n500\r\nNORMAL\r\nPASS">
<STYLE ID="5"><TXSPD TIME="4294967236">Wearing the Noh mask　This is the custom of the Ara</STYLE><STYLE ID="3">ta settlement　Drugs...?</STYLE>
<EVENT VALUE="MOTION\r\n789\r\n111\r\n11\r\n100\r\n500\r\nNORMAL\r\nPASS">
<STYLE ID="3">　It's all right just to dr</STYLE><STYLE ID="1">eam, isn't it?　Who saved </STYLE>me?　I don't believe that...
<EVENT VALUE="MOTION\r\n789\r\n111\r\n11\r\n250\r\n500\r\nNORMAL\r\nPASS">
　The witch sum<STYLE ID="4">mons the shinigami　Save Haruka</STYLE>
<EVENT VALUE="MOTION\r\n789\r\n111\r\n11\r\n100\r\n500\r\nNORMAL\r\nPASS">
<STYLE ID="4">　Akane...　Seeking beau</STYLE><STYLE ID="10">ty even in the look of a corpse　</STYLE><BR>
{MESOFF "0"}
<EVENT VALUE="TEXTCLEAR">
<PG>
<EVENT VALUE="STOPMOVIE">
{DELETECG "111" "14" "0" "0" "0" "" "0"}
{STOPSND "SE" "0" "PASS"}
<STYLE ID="9"><TXSPD TIME="4294967196">Kogori-senpai's</STYLE><STYLE ID="10">... same as her intuition...?</STYLE><BR>
{WAIT "3000" "CLICK" "SKIP"}
{MESOFF "0"}
<EVENT VALUE="TEXTCLEAR">
<PG>
{PLAYSND "強風.ogg" "SE2" "REPEAT" "1000" "0"}
{CREATECG "000" "グラフィック\背景\桜道夜.gal" "NORMAL" "#1" "C" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\死神ハンマー上げる.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "500" "NORMAL" "SKIP"}
{STOPSND "SE2" "0" "PASS"}
{DELETECG "000,人物1" "1" "0" "0" "0" "" "0"}
<EVENT VALUE="STOPMOVIE">
<STYLE ID="10">Why do I have the same intuition as </STYLE><STYLE ID="9">Kogori-senpai</STYLE><STYLE ID="10">, too...?</STYLE><PG>
{WAIT "100" "CLICK" "SKIP"}
{MESOFF "0"}
{PLAYSND "SE\tackle1.ogg" "VOICE" "WAIT" "1000" "0"}
{WAITPLAY "VOICE" "CLICK"}
<STYLE ID="10"><TXSPN>Did you think I died?</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="10">Did you think that I had died?</STYLE><PG>
<STYLE ID="10">That was you jumping to conclusions.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="10">I didn't die.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="10">Even when I was attacked by </STYLE><STYLE ID="6">Mifuyu Niimura</STYLE><STYLE ID="10">, with her power that could even be called supernatural, I didn't get a single scratch.</STYLE><PG>
<STYLE ID="10">Because―</STYLE><PG>
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
{MESOFF "500"}
{CREATECG "000" "グラフィック\イラスト\呪殺編\感染1.gal" "REPEAT" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "2000" "CLICK" "SKIP"}
{CHANGECG "000" "グラフィック\イラスト\呪殺編\感染.lcm" "NORMAL" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
{WAITPLAY "000" "CLICK"}
{DELETECG "000" "1" "0" "0" "0" "" "0"}
<PG>
