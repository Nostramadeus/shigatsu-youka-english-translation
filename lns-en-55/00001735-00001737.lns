;    3: TDecorate(count=18, unk2=16755455, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    4: TDecorate(count=10, unk2=11195903, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
;    5: TDecorate(count=101, unk2=2960895, unk3=4294967295, unk4=0, unk5=1, unk6=0, unk7=4294967295, unk8=, ruby=, unk10=4294967295, unk11=4294967295)
; Display conditions:
;    0: TWdCondition(count=396, target=)
; Links:
;    0: TWdLink(count=357, event=, unk3=)
;---------------------------------------
; BEGIN DECOMPILED SCRIPT
;---------------------------------------
<SCENARIO VER="105">
{CREATECG "000" "グラフィック\背景\警察署廊下.gal" "NORMAL" "#1" "C" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "SE\紙ペラ.ogg" "VOICE" "NORMAL" "1000" "0"}
{CREATECG "アイテム1" "グラフィック\立ち絵\アイテム\手紙.gal" "NORMAL" "#1" "650" "C" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>Shiyo<STYLE ID="1"> 800, April 8, morning, the Central Park murder: record of the statement of its victim </STYLE><STYLE ID="2">Ryoji Kogori-san</STYLE><STYLE ID="1">'s eldest daughter, </STYLE><STYLE ID="3">Natsumi Kogori-san</STYLE><STYLE ID="1"> (hereafter written as 'the girl').</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">The victim</STYLE><STYLE ID="1"> showed nothing particularly unusual the day before, and when </STYLE><STYLE ID="2">the victim</STYLE><STYLE ID="1"> disappeared, she had been told by her mother, </STYLE><STYLE ID="4">Akane Kogori-san</STYLE><STYLE ID="1">, that he was going to Hokkaido on a business trip.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">The girl</STYLE><STYLE ID="1">'s involvement in this case is extremely unlikely.</STYLE><PG>
<STYLE ID="1">However, whether </STYLE><STYLE ID="4">the girl's mother</STYLE><STYLE ID="1"> truly believed he was going on a business trip remains in question.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">The girl</STYLE><STYLE ID="1">'s mental state: good.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">She is to go home for now and, if necessary, will be asked to answer questions again at a later date.</STYLE><PG>
{MESOFF "500"}
{PLAYSND "SE\紙ペラ.ogg" "VOICE" "NORMAL" "1000" "0"}
{DELETECG "アイテム1" "1" "500" "0" "0" "" "0"}
{MESON "500"}
<STYLE ID="5">"Go home for now!? Hey! Is the sergeant here!?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"Y-yes!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">"Why did you send her home!? I told you to make sure she was escorted all the way home!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"But, </STYLE><STYLE ID="3">Natsumi Kogori-san</STYLE><STYLE ID="1"> has nothing at all to do with the case―"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="5">"Enough! I'll go!</STYLE>
{PAUSE ""}
<STYLE ID="5">　Damn... in Megasawa City, two were killed every time...!"</STYLE>
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{MESOFF "500"}
{DELETECG "000" "1" "1000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
<PG>
{}
<EVENT VALUE="MESEND">
;---------------------------------------
; END DECOMPILED SCRIPT
;---------------------------------------