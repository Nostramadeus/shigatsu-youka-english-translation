{MESON "500"}
<STYLE ID="4">"Mm... </STYLE>Haruka<STYLE ID="4">. </STYLE>
{PAUSE ""}
<STYLE ID="4">Me and </STYLE><STYLE ID="7">Kana</STYLE><STYLE ID="4">...</STYLE>
{PAUSE ""}
