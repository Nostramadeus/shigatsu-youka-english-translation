<SCENARIO VER="105">
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>"<STYLE ID="1">Kana-chan</STYLE>... aren't you sleepy? Are you okay?"
{PAUSE ""}
<BR>
Goto<STYLE ID="2">, in an unusually big-sisterly tone, spoke to </STYLE><STYLE ID="1">Kana-chan</STYLE><STYLE ID="2">.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Come to think of it, I've never seen </STYLE>Goto<STYLE ID="2"> talk with anyone younger.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">For all her fussing, </STYLE>Goto<STYLE ID="2"> might actually be happy to have someone younger take to her.</STYLE><PG>
<STYLE ID="1">"I'm sleeping with </STYLE>Goto-chan<STYLE ID="1"> tonight..."</STYLE>
{PAUSE ""}
<BR>
"Uuh... Who knows what she'll do to me... 
{PAUSE ""}
Uh, is it okay if we bring <STYLE ID="1">Kana-chan</STYLE> along too? It seems sad to leave just her behind..."<PG>
<STYLE ID="3">Of course. </STYLE>Goto<STYLE ID="2"> had said she'd been lonely at about </STYLE><STYLE ID="1">Kana-chan</STYLE><STYLE ID="2">'s age.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">That's probably why she doesn't like the idea of leaving her alone.</STYLE><PG>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\春花腕組み.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="4">"Geez, fine. </STYLE>
{PAUSE ""}
<STYLE ID="1">Kana</STYLE><STYLE ID="4">, we're not going there to play, got it?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">At that, the sleepy </STYLE><STYLE ID="1">Kana-chan</STYLE><STYLE ID="2">'s face lit right up.</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜手を上げるバストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="1">"Yay!"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\茅萱バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="5">"Mm... Then, </STYLE><STYLE ID="4">Haruka</STYLE><STYLE ID="5"> and </STYLE><STYLE ID="1">Kana</STYLE><STYLE ID="5">, please show the two of them the way."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">"Yeah, leave it to me!"</STYLE><PG>
<STYLE ID="5">"Mm... What will </STYLE><STYLE ID="6">Auntie</STYLE><STYLE ID="5"> do?"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\美冬腰に手バストアップ.gal" "NORMAL" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="6">"Let's see! I'll tidy up the kitchen or something! No need for me to go along too!"</STYLE><PG>
{MESOFF "500"}
{CHANGECG "000" "グラフィック\背景\詫言編　夢から\新村本家玄関.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物1,人物2" "1" "3000" "0" "0" "" "0"}
{WAIT "1000" "CLICK" "SKIP"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\春花バストアップ.gal" "WAIT" "#1" "R" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="4">"Okay, we're heading out first!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">―But there was no answer from inside.</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CHANGECG "人物1" "グラフィック\立ち絵\人物\春花腕組み.gal" "WAIT" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="4">"Alright, let's go! </STYLE>
{PAUSE ""}
<STYLE ID="4">　The rite's already started!"</STYLE>
{PAUSE ""}
<BR>
{MESOFF "500"}
{CREATECG "人物2" "グラフィック\立ち絵\人物\詫言編　始まり以降\夏菜手を上げるバストアップ.gal" "NORMAL" "#1" "L" "B" "0" "1" "500" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="1">"Come on, come on, a test of courage at the graveyard!"</STYLE>
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{}
<EVENT VALUE="MESEND">
