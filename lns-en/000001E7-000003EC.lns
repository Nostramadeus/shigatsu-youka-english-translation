{CHANGECG "000" "グラフィック\背景\手直し・追加\五島がなつみに抱き着く.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "人物2" "1" "500" "0" "0" "" "0"}
{MESON "500"}
<STYLE ID="4">"</STYLE><STYLE ID="2">Senpai</STYLE><STYLE ID="4">, let's go quickly... </STYLE>
{PAUSE ""}
<STYLE ID="4">To the police!"</STYLE>
{PAUSE ""}
