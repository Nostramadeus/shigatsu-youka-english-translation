{MESON "500"}
<STYLE ID="2">"But </STYLE><STYLE ID="4">Senpai</STYLE><STYLE ID="2">?</STYLE>
{PAUSE ""}
{STOPSND "BGM" "0" "PASS"}
　<STYLE ID="3">That man</STYLE><STYLE ID="2"> is a serious lolicon, isn't he?"</STYLE><PG>
