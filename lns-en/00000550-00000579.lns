{WAIT "2000" "CLICK" "SKIP"}
{STOPSND "VOICE" "5000" "PASS"}
{WAIT "5000" "CLICK" "SKIP"}
{MESON "500"}
<STYLE ID="3">Ise-san</STYLE> got back into the car and drove away.<PG>
{MESOFF "500"}
{CREATECG "人物1" "グラフィック\立ち絵\人物\春花腕組み.gal" "NORMAL" "#1" "R" "B" "0" "1" "1000" "0" "0" "" "0" "0" "0" "255" ""}
{MESON "500"}
<STYLE ID="4">"Hey, </STYLE><STYLE ID="1">Natsumi</STYLE><STYLE ID="4">..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"Hm?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">Haruka</STYLE> was staring after <STYLE ID="3">Ise-san</STYLE>'s car.
{PAUSE ""}
<BR>
<STYLE ID="4">"</STYLE><STYLE ID="3">Ise-san</STYLE><STYLE ID="4"> is... </STYLE>
{PAUSE ""}
<STYLE ID="4">pretty cool!"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"Huh!?</STYLE>
