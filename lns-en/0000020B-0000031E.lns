<SCENARIO VER="105">
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "togisuma.ogg" "BGM" "REPEAT" "1000" "0"}
{WAIT "3000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\背景\ザッハ中.gal" "NORMAL" "#1" "C" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "人物1" "グラフィック\立ち絵\人物\春花腕組み.gal" "WAIT" "#1" "R" "B" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "100" "CLICK" "SKIP"}
<TXSPN>"<STYLE ID="1">Niimura-senpai</STYLE>, would you help me too?"
{PAUSE ""}
<BR>
<STYLE ID="2">I know that what I am asking is unreasonable.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">"But, that kind of thing is for the police to... </STYLE>
{PAUSE ""}
<STYLE ID="1">Besides, you're bound to end up in danger. </STYLE>
{PAUSE ""}
<STYLE ID="1">The culprit isn't in a normal state of mind. </STYLE>
{PAUSE ""}
<STYLE ID="1">Because if it's the culprit behind the Megasawa City murders..."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="1">Senpai</STYLE><STYLE ID="2"> is trying, somehow, to break down my resolve.</STYLE><PG>
<STYLE ID="2">It would certainly be dangerous.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">But... no matter what, I want to do something for her.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Just as much as I do, </STYLE><STYLE ID="3">Kogori-senpai</STYLE><STYLE ID="2"> matters to </STYLE><STYLE ID="1">Niimura-senpai</STYLE><STYLE ID="2">, and having her help would be a great reassurance.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Shall I try asking </STYLE><STYLE ID="1">Senpai</STYLE><STYLE ID="2"> one more time?</STYLE>
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{}
<EVENT VALUE="MESEND">
;---------------------------------------
; END DECOMPILED SCRIPT
