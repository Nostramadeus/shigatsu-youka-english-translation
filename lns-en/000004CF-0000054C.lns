<SCENARIO VER="105">
{WAIT "1000" "CLICK" "SKIP"}
{PLAYSND "SE\電話呼び出し.ogg" "VOICE" "NORMAL" "1000" "0"}
{WAIT "2000" "CLICK" "SKIP"}
{CREATECG "000" "グラフィック\背景\ザッハ夕方.gal" "NORMAL" "#1" "C" "B" "0" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "アイテム1" "グラフィック\立ち絵\アイテム\スマフォ黄入.gal" "NORMAL" "#1" "650" "C" "0" "1" "3000" "0" "0" "" "0" "0" "0" "255" ""}
{WAIT "1000" "CLICK" "SKIP"}
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
<TXSPN>"<STYLE ID="1">Senpai</STYLE>, hurry and pick up...!"<PG>
{STOPSND "SE" "0" "PASS"}
"Hello, <STYLE ID="1">Senpai</STYLE>!? Uh...
{PAUSE ""}
Uh...!"
{PAUSE ""}
<BR>
<STYLE ID="1">"</STYLE>Goto<STYLE ID="1">? What's wrong?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">Strangely calm, </STYLE><STYLE ID="1">Senpai</STYLE><STYLE ID="2">'s voice.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">If anything, the one who ought to calm down is me.</STYLE><PG>
"<STYLE ID="1">Senpai</STYLE>, where are you right now!?"<PG>
{STOPSND "BGM" "0" "PASS"}
{PLAYSND "環境音\駅ホーム.ogg" "SE" "REPEAT" "1000" "0"}
{CHANGECG "000" "グラフィック\背景\元木駅夕方.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{DELETECG "アイテム1" "1" "0" "0" "0" "" "0"}
<STYLE ID="1">"I'm at Motoki Station right now. </STYLE><STYLE ID="3">Haruka</STYLE><STYLE ID="1"> and I are about to get on a train."</STYLE>
{PAUSE ""}
<BR>
{CHGVOL "SE" "500" "0" "PASS"}
{CHANGECG "000" "グラフィック\背景\ザッハ夕方.gal" "NORMAL" "" "0" "0" "0" "" "0" "0" "0" "255" ""}
{CREATECG "アイテム1" "グラフィック\立ち絵\アイテム\スマフォ黄入.gal" "WAIT" "#1" "650" "C" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
"A train with <STYLE ID="3">Niimura-senpai</STYLE>!?
{PAUSE ""}
　Don't! <STYLE ID="1">Senpai</STYLE>, go to the police right now! I'll come too!"<PG>
<STYLE ID="1">"I'm sorry, </STYLE>Goto<STYLE ID="1">... I can't go to the police."</STYLE>
{PAUSE ""}
<BR>
"What are you saying! <STYLE ID="1">Senpai</STYLE>, it's dangerous! <STYLE ID="3">Niimura-senpai</STYLE> is...
{PAUSE ""}
<STYLE ID="3">Niimura-senpai</STYLE> is...!"
{PAUSE ""}
<BR>
<STYLE ID="2">I pleaded desperately, but somehow I did not feel my voice was reaching her.</STYLE>
{PAUSE ""}
<BR>
{PLAYSND "ネジの壊れたロボット.ogg" "BGM" "REPEAT" "1000" "0"}
<STYLE ID="1">"</STYLE>Goto<STYLE ID="1">, you're kind. And I love that about </STYLE>Goto<STYLE ID="1">. Thank you. I'm sure we'll meet again."</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">At first I had thought it a calm </STYLE><STYLE ID="1">Senpai</STYLE><STYLE ID="4">'s voice, but somewhere in it </STYLE><STYLE ID="2">I could hear a little sadness too.</STYLE><PG>
"Then I'll come to where <STYLE ID="1">Senpai</STYLE> is!
{PAUSE ""}
　Wait for me, ple―"<BR>
<STYLE ID="1">"Sorry, the train's come. I'm hanging up."</STYLE>
{PAUSE ""}
<BR>
"Please wait! The one who died in the incident is <STYLE ID="1">Senpai</STYLE>'s...!"<BR>
{PLAYSND "SE\電話切れる.ogg" "VOICE" "NORMAL" "1000" "0"}
{PAUSE ""}
<STYLE ID="2">The call had been cut off.</STYLE>
{PAUSE ""}
<BR>
"<STYLE ID="1">Senpai</STYLE>..."
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{}
<EVENT VALUE="MESEND">
