<SCENARIO VER="105">
{MESON "500"}
{CREATECG "文字カウント画像" "グラフィック\システム\文字カウント画像.gal" "NORMAL" "#1" "C" "B" "0" "1" "0" "0" "0" "" "0" "0" "0" "255" ""}
{QUAKE "メッセージボックス土台" "QUAKE" "1" "15" "15" "0" "30"}
<TXSPN>"Don't!"
{QUAKESTOP "500"}
<PG>
<STYLE ID="1">"</STYLE><STYLE ID="2">Natsumi</STYLE><STYLE ID="1">?"</STYLE><BR>
<STYLE ID="3">"</STYLE><STYLE ID="2">Senpai</STYLE><STYLE ID="3">?"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="2">"Don't! </STYLE><STYLE ID="3">Goto</STYLE><STYLE ID="2">, don't go!"</STYLE>
{PAUSE ""}
<BR>
{PLAYSND "日没廃校.ogg" "BGM" "REPEAT" "1000" "50"}
<STYLE ID="4">Instinctively I was sensing danger. This situation is dangerous...!</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">I had had this feeling many times before: that sensation of sensing danger in this season when the cherries bloom.</STYLE><PG>
<STYLE ID="4">How does a human being tell one smell or one taste from another―</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">Explaining this sensation is as hard as explaining that one in terms of feel.</STYLE><PG>
<STYLE ID="4">Yes, this is my intuition―the danger sense I can use only at this time of year.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">Like this, it comes suddenly, with no warning at all.</STYLE><PG>
{STOPSND "BGM" "3000" "PASS"}
<STYLE ID="3">"............"</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="3">Goto</STYLE><STYLE ID="4"> put a hand to her chin and stared down at the ground.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">And then, looking at my face this time,</STYLE>
{CHANGECG "人物1" "グラフィック\立ち絵\人物\五島バストアップ.gal" "NORMAL" "1" "2000" "0" "0" "" "0" "0" "0" "255" ""}
<STYLE ID="4">she came slowly closer and grinned from ear to ear.</STYLE><PG>
<STYLE ID="3">"</STYLE><STYLE ID="2">Seeenpai</STYLE><STYLE ID="3">!"</STYLE>
{PAUSE ""}
<BR>
{PLAYSND "五島.ogg" "BGM" "REPEAT" "1000" "0"}
<STYLE ID="4">She stretched up on her toes and put both hands on my shoulders.</STYLE>
{PAUSE ""}
<BR>
<STYLE ID="4">And then she looked sharply up into my face.</STYLE>
{WAIT "100" "CLICK" "SKIP"}
{DELETECG "文字カウント画像" "1" "0" "0" "0" "" "0"}
<PG>
{MESOFF "500"}
<PG>
{}
<EVENT VALUE="MESEND">
