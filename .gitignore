# Public repo = the English side only: translation rules, read-through notes, glossary,
# cast, English scripts, English tables, English pictures, proofreading pages, build tools.
# Everything else (raw game data, agent briefs, logs, boards, scratch) stays local.
/*
!/.gitignore
!/README.md
!/status.svg
!/line-counts.tsv

# English text
!/lns-en/
!/lns-en-55/
!/tsv-en/
!/patch/
/patch/*.zip

# English pictures
!/work/
/work/*
!/work/グラフィック/
!/work/images/
/work/images/*
!/work/images/out/

# proofreading pages
!/review/
/review/images/
/review/shots/
/review/COST-REVIEW-*.html

# build tools
!/tools/
/tools/_retired/
/tools/harness/shots/
/tools/harness/work/
/tools/harness/mouse/
/tools/harness/PROGRESS.md

# the author's license statement
!/research/
/research/*
!/research/_author-satsuki.md
!/research/author-satsuki.html

# notes: rules, read-through, glossary, cast, decisions, open questions
!/notes/
/notes/*
!/notes/METHOD.md
!/notes/STYLE.md
!/notes/CORE.md
!/notes/GLOBAL.md
!/notes/GLOBAL-RELATIONS.md
!/notes/GLOBAL-RESOLVES.md
!/notes/CAST.md
!/notes/SUMMARY.md
!/notes/DECISIONS.md
!/notes/QUERIES.md
!/notes/NOTES-TL.md
!/notes/CHIPS.md
!/notes/SCARE-TIERS.md
!/notes/SAVE-COMPAT.md
!/notes/KEY-COLLISION-AUDIT.md
!/notes/REMAINING-JP-AUDIT.md
!/notes/GLOSSARY.tsv
!/notes/GLOSSARY-CORE.tsv
!/notes/RELATIONS.tsv
!/notes/RELATIONS.md
!/notes/v2/
/notes/v2/*
!/notes/v2/METHOD.md
!/notes/v2/STYLE.md
!/notes/v2/CORE-RULES.md
!/notes/v2/OWNER-RULINGS.md
!/notes/v2/FABLE-RULINGS.md
!/notes/v2/GLOSSARY-LOCKS.md
!/notes/v2/CHIPS.md
!/notes/v2/CAST.md
!/notes/v2/SUMMARY.md
!/notes/v2/DECISIONS.md
!/notes/v2/QUERIES.md
!/notes/v2/NOTES-TL.md
!/notes/v2/NOTES-DIFF-c01-03.md
!/notes/v2/CLUES.md
!/notes/v2/SPEAKER-COLORS.md
!/notes/v2/GLOSSARY.tsv
!/notes/v2/RELATIONS.tsv
!/notes/v2/SCENE-FACTS.tsv
!/notes/v2/NARRATOR-SWITCHES.tsv
!/notes/v2/SPEAKER-COLORS.tsv
!/notes/v2/UNREACHABLE.tsv
!/notes/v2/db/
/notes/v2/db/*
!/notes/v2/db/*.tsv

__pycache__/
*.pyc
Thumbs.db
/tools/autopilot.mjs
